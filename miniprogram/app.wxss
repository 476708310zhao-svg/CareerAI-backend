/* app.wxss */
page {
  /* Shared design tokens. Keep the legacy aliases because some subpackages
   * still consume them while they are being migrated to the 2026 palette. */
  --brand: #2563eb;
  --brand-dark: #1d4ed8;
  --brand-shadow: rgba(37, 99, 235, 0.18);
  --brand-bg: #eef4ff;
  --bg-panel: #ffffff;
  --bg-raised: #f7f8fb;
  --border: #e5eaf2;
  --border-subtle: rgba(16, 24, 40, 0.06);
  --text-primary: #101828;
  --text-secondary: #475467;
  --text-muted: #667085;
  --danger: #dc2626;
  --btn-height: 88rpx;
  --btn-height-sm: 88rpx;
  --btn-font-size: 28rpx;
  --btn-font-size-sm: 24rpx;
  --r-pill: 999rpx;
  --r-xs: 12rpx;
  --radius-lg: 26rpx;
  --radius-full: 999rpx;
  --motion-fast: 0.16s ease;
  --motion-normal: 0.22s ease;
  --shadow-action: 0 12rpx 26rpx rgba(37, 99, 235, 0.18);
  --shadow-card: 0 14rpx 34rpx rgba(36, 58, 92, 0.07);
  --color-brand: #2563eb;
  --color-brand-tint: #eef4ff;
  --color-brand-tint-legacy: #eef4ff;
  --color-brand-soft: #f4f8ff;
  --color-ink: #101828;
  --color-ink-2: #344054;
  --color-ink-3: #667085;
  --color-ink-4: #667085;
  --color-neutral: #475467;
  --color-neutral-muted: #667085;
  --color-surface-muted: #f2f4f7;
  --color-surface-subtle: #f7f8fb;
  --color-bg: #ffffff;
  --color-bg-soft: #f7f8fb;
  --color-form-bg: #f8faff;
  --color-line-soft: #e8edf5;
  --color-divider-strong: #dfe5ee;
  --color-neutral-line: #e8edf5;
  --color-neutral-line-strong: #d0d5dd;
  --color-success: #12a174;
  --color-success-soft: #eafbf3;
  --color-success-tint: #e9fbf5;
  --color-success-text: #087a55;
  --color-warning: #d97706;
  --color-warning-soft: #fff4dd;
  --color-warning-strong: #b54708;
  --color-danger: #dc2626;
  --color-danger-soft: #fef2f2;
  --color-danger-tint: #fff0f0;
  --warning-bg: #fff8db;
  --success-bg: #eafbf3;
  --info-bg: #eef4ff;
  --font-lg: 34rpx;
  --card-radius: 26rpx;
  --card-radius-lg: 30rpx;
  --card-bg: linear-gradient(145deg, rgba(255,255,255,0.99) 0%, rgba(248,251,255,0.98) 100%);
  --card-bg-feature: linear-gradient(135deg, rgba(255,255,255,0.99) 0%, rgba(241,247,255,0.98) 66%, rgba(238,251,248,0.98) 100%);
  --card-border: rgba(190,208,232,0.62);
  --card-shadow: 0 14rpx 34rpx rgba(36,58,92,0.07), inset 0 1rpx 0 rgba(255,255,255,0.94);
  --card-shadow-raised: 0 20rpx 48rpx rgba(37,68,112,0.105), inset 0 1rpx 0 rgba(255,255,255,0.96);
  --card-shadow-press: 0 8rpx 20rpx rgba(36,58,92,0.055), inset 0 1rpx 0 rgba(255,255,255,0.9);
  /* 2026 premium mobile workspace system */
  --zy-bg: #f5f8ff;
  --zy-surface: #ffffff;
  --zy-surface-soft: #f8faff;
  --zy-ink: #111827;
  --zy-ink-2: #354052;
  --zy-muted: #667085;
  --zy-line: #e2e8f3;
  --zy-line-strong: #d3ddec;
  --zy-brand: #315ee8;
  --zy-brand-deep: #2448bd;
  --zy-brand-soft: #edf2ff;
  --zy-success: #138a68;
  --zy-success-soft: #eaf8f3;
  --zy-warning: #b65e0b;
  --zy-warning-soft: #fff5e8;
  --zy-danger: #c83b42;
  --zy-danger-soft: #fff0f1;
  --zy-radius-sm: 18rpx;
  --zy-radius-md: 26rpx;
  --zy-radius-lg: 34rpx;
  --zy-shadow-card: 0 14rpx 38rpx rgba(49, 94, 232, 0.055);
  --zy-shadow-float: 0 22rpx 54rpx rgba(49, 94, 232, 0.16);
}
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
}

/* 页面标题样式 */
.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

/* 按钮样式 */
.btn-primary {
  background: #007aff;
  color: #fff;
  border: none;
  border-radius: 40rpx;
  font-size: 28rpx;
  padding: 20rpx 40rpx;
}

.btn-secondary {
  background: #f0f0f0;
  color: #666;
  border: none;
  border-radius: 40rpx;
  font-size: 28rpx;
  padding: 20rpx 40rpx;
}

/* 卡片样式 */
.card {
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
  border-radius: var(--card-radius);
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--card-shadow);
}

/* 列表项样式 */
.list-item {
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.list-item:last-child {
  border-bottom: none;
}

/* 标签样式 */
.tag {
  display: inline-block;
  font-size: 22rpx;
  color: #999;
  border: 1rpx solid #ddd;
  border-radius: 4rpx;
  padding: 4rpx 12rpx;
  margin-right: 10rpx;
}

/* 加载动画 */
.loading {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}
