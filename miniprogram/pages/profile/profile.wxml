<view class="profile-page">
  <view class="page-head"><text class="page-kicker">个人资产</text><text class="page-title">我的</text><text class="page-sub">管理求职档案、个人资产与账号设置</text></view>
  <view class="identity-card" bindtap="openIdentity" hover-class="row-press" aria-role="button" aria-label="{{isLogin?'编辑个人资料':'登录或注册'}}"><image class="avatar" src="{{isLogin?userInfo.avatarUrl:'/images/default-avatar.png'}}" mode="aspectFill" aria-hidden="true" /><view class="identity-copy"><view class="name-row"><text class="nickname">{{isLogin?userInfo.nickName:'登录 / 注册'}}</text><text wx:if="{{isVip}}" class="member-tag">会员</text></view><text class="identity-desc">{{isLogin ? ((userInfo.school||'完善学校信息') + (userInfo.major?' · '+userInfo.major:'')) : '建立求职档案，获取与你相关的进度与内容'}}</text></view><text class="row-arrow" aria-hidden="true">›</text></view>
  <view wx:if="{{membershipEnabled}}" class="member-card {{isVip?'is-active':''}}" bindtap="goToVip" hover-class="press" aria-role="button" aria-label="{{isVip?'查看会员权益':'了解会员权益'}}"><view><text class="member-kicker">{{isVip?'会员已生效':'可选进阶能力'}}</text><text class="member-title">{{isVip?'高级求职能力已解锁':'按需了解求职会员'}}</text><text class="member-desc">{{isVip?('有效期至 '+(vipInfo.expireDate||'长期有效')):'简历优化、AI 面试与薪资洞察'}}</text></view><text class="member-action">查看权益 ›</text></view>
  <view class="section-head"><view><text class="section-title">我的资产</text><text class="section-sub">供申请工作台调用的个人内容</text></view></view>
  <view class="asset-grid">
    <view class="asset-tile" bindtap="goToResumes" hover-class="press" aria-role="button" aria-label="我的简历，管理版本与内容"><view class="asset-icon blue"><image src="/images/profile-resume.png" mode="aspectFit" aria-hidden="true" /></view><text class="asset-name">我的简历</text><text class="asset-meta">版本与内容</text></view>
    <view class="asset-tile" bindtap="goToFavorites" hover-class="press" aria-role="button" aria-label="我的收藏，{{stats.favorites}}项内容"><view class="asset-icon amber"><image src="/images/profile-favorite.png" mode="aspectFit" aria-hidden="true" /></view><text class="asset-name">我的收藏</text><text class="asset-meta">{{stats.favorites}} 项内容</text></view>
    <view class="asset-tile is-disabled" aria-role="button" aria-disabled="true" aria-label="我的已购，资料权益暂未开放"><view class="asset-icon green"><image src="/images/resource-guide.png" mode="aspectFit" aria-hidden="true" /></view><text class="asset-name">我的已购</text><text class="asset-meta">未开放</text></view>
    <view class="asset-tile" bindtap="goToMyExperiences" hover-class="press" aria-role="button" aria-label="我发布的面试经验"><view class="asset-icon coral"><image src="/images/profile-experience.png" mode="aspectFit" aria-hidden="true" /></view><text class="asset-name">我的面经</text><text class="asset-meta">管理发布</text></view>
  </view>
  <view class="section-head"><view><text class="section-title">账号与服务</text><text class="section-sub">通知、隐私和产品支持</text></view></view>
  <view class="service-card">
    <view class="service-row" bindtap="goToMessages" hover-class="row-press" aria-role="button" aria-label="消息通知{{unreadCount>0?'，'+unreadCount+'条未读':''}}"><view class="service-icon"><image src="/images/profile-message.png" mode="aspectFit" aria-hidden="true" /></view><text class="service-name">消息通知</text><text wx:if="{{unreadCount>0}}" class="unread" aria-label="{{unreadCount}}条未读">{{unreadCount}}</text><text class="row-arrow" aria-hidden="true">›</text></view>
    <view class="service-row" bindtap="goToSettings" hover-class="row-press" aria-role="button" aria-label="账号与设置"><view class="service-icon"><image src="/images/profile-settings.png" mode="aspectFit" aria-hidden="true" /></view><view class="service-copy"><text class="service-name">账号与设置</text><text class="service-desc">登录状态与基础偏好</text></view><text class="row-arrow" aria-hidden="true">›</text></view>
    <view class="service-row" bindtap="goToSettings" hover-class="row-press" aria-role="button" aria-label="隐私与数据"><view class="service-icon"><image src="/images/profile-settings.png" mode="aspectFit" aria-hidden="true" /></view><view class="service-copy"><text class="service-name">隐私与数据</text><text class="service-desc">授权、安全与数据管理</text></view><text class="row-arrow" aria-hidden="true">›</text></view>
    <view class="service-row" bindtap="goToFeedback" hover-class="row-press" aria-role="button" aria-label="意见反馈"><view class="service-icon"><image src="/images/profile-feedback.png" mode="aspectFit" aria-hidden="true" /></view><text class="service-name">意见反馈</text><text class="row-arrow" aria-hidden="true">›</text></view>
    <view class="service-row" bindtap="goToAbout" hover-class="row-press" aria-role="button" aria-label="关于职引"><view class="service-icon"><image src="/images/profile-about.png" mode="aspectFit" aria-hidden="true" /></view><text class="service-name">关于职引</text><text class="row-arrow" aria-hidden="true">›</text></view>
  </view>
  <c-login-popup show="{{showLoginPopup}}" bind:close="onLoginPopupClose" bind:success="onLoginSuccess" />
</view>
