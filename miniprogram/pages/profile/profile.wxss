page {
  min-height: 100%;
  overflow-x: hidden;
  color: #172033;
  background: #f5f7fb;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

view,
text,
image {
  box-sizing: border-box;
}

.profile-page {
  width: 100%;
  min-height: 100vh;
  padding: 24rpx 28rpx 0;
  overflow-x: hidden;
  background:
    radial-gradient(circle at 12% 0, rgba(47, 112, 244, .065), transparent 28%),
    linear-gradient(180deg, #ffffff 0, #f5f7fb 330rpx, #f5f7fb 100%);
}

.profile-identity {
  display: flex;
  align-items: center;
  min-height: 136rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid #e2e8f3;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(49,94,232,.055);
  transition: opacity 160ms ease;
}

.avatar-wrap {
  position: relative;
  flex: none;
  width: 96rpx;
  height: 96rpx;
}

.avatar {
  display: block;
  width: 96rpx;
  height: 96rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  background: #e9f0fb;
  box-shadow: 0 8rpx 22rpx rgba(37, 68, 112, .13);
}

.avatar-badge {
  position: absolute;
  right: -8rpx;
  bottom: 0;
  min-width: 50rpx;
  height: 32rpx;
  padding: 0 9rpx;
  border: 2rpx solid #ffffff;
  border-radius: 999rpx;
  color: #ffffff;
  background: #2f70f4;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 32rpx;
  text-align: center;
}

.identity-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  margin-left: 20rpx;
}

.name-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.nickname {
  max-width: 390rpx;
  overflow: hidden;
  color: #101828;
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: -.5rpx;
  line-height: 44rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.identity-arrow {
  flex: none;
  margin-left: 10rpx;
  color: #667085;
  font-size: 40rpx;
  line-height: 40rpx;
}

.profile-intro {
  margin-top: 5rpx;
  overflow: hidden;
  color: #7b8797;
  font-size: 24rpx;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.vip-tag {
  flex: none;
  margin-left: 10rpx;
  padding: 3rpx 10rpx;
  border-radius: 999rpx;
  color: #705400;
  background: #fff0a8;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 32rpx;
}

.vip-banner {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 116rpx;
  margin-top: 24rpx;
  padding: 21rpx 22rpx;
  overflow: hidden;
  border: 1rpx solid rgba(234, 179, 8, .16);
  border-radius: 24rpx;
  background:
    radial-gradient(circle at 89% 15%, rgba(255, 255, 255, .58), transparent 26%),
    linear-gradient(115deg, #fff86f 0%, #ffe72b 52%, #ffd82d 100%);
  box-shadow: 0 10rpx 24rpx rgba(202, 138, 4, .11);
  transition: opacity 160ms ease;
}

.vip-banner::after {
  position: absolute;
  top: -58rpx;
  right: 76rpx;
  width: 128rpx;
  height: 128rpx;
  border: 18rpx solid rgba(255, 255, 255, .17);
  border-radius: 50%;
  content: '';
}

.vip-banner.is-active {
  border-color: #ccebdd;
  background: linear-gradient(115deg, #f3fff8 0%, #e5f8ee 100%);
}

.vip-copy,
.vip-title-row {
  position: relative;
  z-index: 1;
  display: flex;
  min-width: 0;
}

.vip-copy {
  flex: 1;
  flex-direction: column;
}

.vip-title-row {
  align-items: center;
}

.vip-mark {
  flex: none;
  min-width: 58rpx;
  height: 38rpx;
  padding: 0 8rpx;
  border-radius: 9rpx;
  color: #6d5200;
  background: rgba(255, 255, 255, .66);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 38rpx;
  text-align: center;
}

.vip-title {
  margin-left: 12rpx;
  overflow: hidden;
  color: #2b2510;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 38rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.vip-description {
  margin-top: 7rpx;
  overflow: hidden;
  color: #65551f;
  font-size: 24rpx;
  line-height: 32rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.vip-action {
  position: relative;
  z-index: 1;
  flex: none;
  min-width: 96rpx;
  height: 54rpx;
  margin-left: 16rpx;
  padding: 0 16rpx;
  border: 1rpx solid rgba(255, 255, 255, .76);
  border-radius: 999rpx;
  color: #5b4600;
  background: rgba(255, 255, 255, .8);
  font-size: 24rpx;
  font-weight: 750;
  line-height: 54rpx;
  text-align: center;
  white-space: nowrap;
}

.vip-banner.is-active .vip-title,
.vip-banner.is-active .vip-description {
  color: #145f47;
}

.vip-banner.is-active .vip-action {
  color: #087a55;
  background: #ffffff;
}

.records-card,
.service-card {
  border: 1rpx solid #e6ebf3;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, .045);
}

.records-card {
  margin-top: 24rpx;
  padding: 26rpx 18rpx 30rpx;
}

.card-title {
  display: block;
  padding: 0 8rpx;
  color: #172033;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.records-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin-top: 24rpx;
}

.record-item {
  display: flex;
  align-items: center;
  min-width: 0;
  min-height: 132rpx;
  padding: 8rpx 3rpx;
  flex-direction: column;
  transition: opacity 160ms ease;
}

.record-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  margin-bottom: 15rpx;
  border-radius: 20rpx;
}

.record-icon image {
  display: block;
  width: 38rpx;
  height: 38rpx;
}

.tone-mint { background: #eafaf4; }
.tone-amber { background: #fff5dc; }
.tone-blue { background: #edf4ff; }
.tone-coral { background: #fff0ef; }

.record-name {
  width: 100%;
  overflow: hidden;
  color: #263247;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 36rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.unread-dot {
  position: absolute;
  top: -10rpx;
  right: -11rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 7rpx;
  border: 3rpx solid #ffffff;
  border-radius: 999rpx;
  color: #ffffff;
  background: #ef4444;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 27rpx;
  text-align: center;
}

.service-card {
  margin-top: 24rpx;
  padding: 0 24rpx;
  overflow: hidden;
}

.service-row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #edf0f5;
  transition: opacity 160ms ease, background-color 160ms ease;
}

.service-row:last-child {
  border-bottom: 0;
}

.service-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 58rpx;
  height: 58rpx;
  border-radius: 17rpx;
  background: #5f83ba;
}

.service-icon {
  display: block;
  width: 35rpx;
  height: 35rpx;
}

.service-name {
  flex: 1;
  margin-left: 20rpx;
  color: #263247;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 40rpx;
}

.service-arrow {
  flex: none;
  color: #98a2b3;
  font-size: 38rpx;
  line-height: 40rpx;
}

.bottom-spacer {
  height: 188rpx;
  height: calc(188rpx + env(safe-area-inset-bottom));
}

.tap-soft,
.tile-press,
.panel-press {
  opacity: .72;
}

@media (prefers-reduced-motion: reduce) {
  .profile-identity,
  .vip-banner,
  .record-item,
  .service-row {
    transition: none;
  }
}
