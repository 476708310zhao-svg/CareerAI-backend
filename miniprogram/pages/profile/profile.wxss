page { min-height: 100%; background: var(--zy-bg); }
.profile-page { min-height: 100vh; box-sizing: border-box; padding: 0 28rpx; color: var(--zy-ink); background: var(--zy-bg); }
.profile-hero { margin: 0 -28rpx 22rpx; padding: 46rpx 28rpx 28rpx; border-radius: 0 0 44rpx 44rpx; color: #fff; background: linear-gradient(145deg, #141b29 0%, #25324d 74%, #315ee8 155%); box-shadow: 0 24rpx 60rpx rgba(20,31,55,.17); }
.page-head { display: flex; flex-direction: column; padding: 0 4rpx 24rpx; }
.page-kicker,.section-eyebrow { color: #9eb5ff; font-size: 24rpx; font-weight: 800; letter-spacing: 3rpx; line-height: 32rpx; }
.page-title { margin-top: 8rpx; font-size: 50rpx; font-weight: 850; letter-spacing: -2rpx; line-height: 1.18; }.page-sub { margin-top: 12rpx; color: rgba(255,255,255,.66); font-size: 27rpx; line-height: 1.55; }
.identity-card { display: flex; align-items: center; min-height: 132rpx; padding: 18rpx; border: 1rpx solid rgba(255,255,255,.14); border-radius: var(--zy-radius-lg); background: rgba(255,255,255,.09); transition: opacity 180ms ease; }
.avatar { flex: none; width: 86rpx; height: 86rpx; margin-right: 20rpx; border: 4rpx solid rgba(255,255,255,.2); border-radius: 50%; background: #e8ebf1; }
.identity-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; }.name-row { display: flex; align-items: center; min-width: 0; }
.nickname { overflow: hidden; font-size: 32rpx; font-weight: 820; line-height: 42rpx; text-overflow: ellipsis; white-space: nowrap; }.member-tag { flex: none; margin-left: 12rpx; padding: 6rpx 12rpx; border-radius: 999rpx; color: #16213a; background: #dce6ff; font-size: 24rpx; font-weight: 760; }
.identity-desc { margin-top: 5rpx; overflow: hidden; color: rgba(255,255,255,.66); font-size: 24rpx; line-height: 34rpx; text-overflow: ellipsis; white-space: nowrap; }.identity-card .row-arrow { color: rgba(255,255,255,.68); }

.member-card { display: flex; align-items: center; justify-content: space-between; min-height: 142rpx; margin-bottom: 34rpx; padding: 22rpx 24rpx; border: 1rpx solid #eadfc8; border-radius: var(--zy-radius-md); background: linear-gradient(115deg, #fffaf0, #fff); transition: opacity 180ms ease; }
.member-card > view { display: flex; flex: 1; min-width: 0; flex-direction: column; }.member-kicker { color: #94610a; font-size: 24rpx; font-weight: 820; letter-spacing: 2rpx; }.member-title { margin-top: 4rpx; color: var(--zy-ink); font-size: 28rpx; font-weight: 790; line-height: 38rpx; }.member-desc { margin-top: 4rpx; color: var(--zy-muted); font-size: 24rpx; line-height: 34rpx; }.member-action { flex: none; margin-left: 18rpx; color: #94610a; font-size: 24rpx; font-weight: 740; }
.member-card.is-active { border-color: #cfece2; background: linear-gradient(115deg, #eefaf6, #fff); }.member-card.is-active .member-kicker,.member-card.is-active .member-action { color: var(--zy-success); }

.section-head { display: flex; margin: 0 4rpx 18rpx; }.section-head > view { display: flex; flex-direction: column; }.section-eyebrow { color: var(--zy-brand); }.section-title { margin-top: 3rpx; color: var(--zy-ink); font-size: 34rpx; font-weight: 820; line-height: 44rpx; }.section-sub { margin-top: 3rpx; color: var(--zy-muted); font-size: 24rpx; line-height: 34rpx; }
.asset-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14rpx; margin-bottom: 38rpx; }
.asset-tile { display: flex; align-items: center; min-width: 0; min-height: 144rpx; padding: 18rpx; border: 1rpx solid var(--zy-line); border-radius: var(--zy-radius-md); background: #fff; box-shadow: 0 10rpx 30rpx rgba(20,31,55,.045); transition: opacity 180ms ease; }
.asset-tile.is-disabled { opacity: .56; }.asset-icon { display: flex; align-items: center; justify-content: center; flex: none; width: 64rpx; height: 64rpx; margin-right: 14rpx; border-radius: 20rpx; background: var(--zy-brand-soft); }.asset-icon.amber { background: var(--zy-warning-soft); }.asset-icon.green { background: var(--zy-success-soft); }.asset-icon.coral { background: var(--zy-danger-soft); }.asset-icon image { width: 38rpx; height: 38rpx; }
.asset-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; }.asset-name { overflow: hidden; color: var(--zy-ink); font-size: 27rpx; font-weight: 770; line-height: 36rpx; text-overflow: ellipsis; white-space: nowrap; }.asset-meta { margin-top: 4rpx; overflow: hidden; color: var(--zy-muted); font-size: 24rpx; line-height: 32rpx; text-overflow: ellipsis; white-space: nowrap; }.asset-arrow { flex: none; margin-left: 5rpx; color: #98a2b3; font-size: 30rpx; }

.service-card { margin-bottom: 26rpx; overflow: hidden; border: 1rpx solid var(--zy-line); border-radius: var(--zy-radius-md); background: #fff; box-shadow: var(--zy-shadow-card); }
.service-row { display: flex; align-items: center; min-height: 104rpx; padding: 8rpx 20rpx; border-bottom: 1rpx solid var(--zy-line); transition: background-color 180ms ease, opacity 180ms ease; }.service-row:last-child { border-bottom: 0; }.service-icon { display: flex; align-items: center; justify-content: center; flex: none; width: 60rpx; height: 60rpx; margin-right: 16rpx; border-radius: 18rpx; background: var(--zy-surface-soft); }.service-icon image { width: 36rpx; height: 36rpx; }.service-name { flex: 1; color: var(--zy-ink); font-size: 27rpx; font-weight: 720; }.service-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; }.service-copy .service-name { flex: none; }.service-desc { margin-top: 3rpx; color: var(--zy-muted); font-size: 24rpx; line-height: 32rpx; }.row-arrow { flex: none; width: 34rpx; color: #98a2b3; font-size: 36rpx; text-align: right; }.unread { min-width: 36rpx; height: 36rpx; margin-right: 12rpx; padding: 0 8rpx; border-radius: 999rpx; color: #fff; background: var(--zy-danger); font-size: 24rpx; font-weight: 760; line-height: 36rpx; text-align: center; }
.press,.row-press { opacity: .72; }.bottom-spacer { height: 230rpx; height: calc(230rpx + env(safe-area-inset-bottom)); }

@media (max-width: 340px) { .asset-grid { grid-template-columns: 1fr; } }
@media (prefers-reduced-motion: reduce) { .identity-card,.member-card,.asset-tile,.service-row { transition: none; } }
