page { min-height: 100%; background: #f3f6fb; color: #14213d; }
view, text, image { box-sizing: border-box; }
.profile-page { min-height: 100vh; padding: 30rpx 28rpx calc(190rpx + env(safe-area-inset-bottom)); overflow-x: hidden; }
.page-kicker, .page-title, .page-sub, .identity-desc, .member-kicker, .member-title, .member-desc, .section-title, .section-sub, .asset-name, .asset-meta, .service-name, .service-desc { display: block; }
.page-kicker { color: #2b5ce6; font-size: 24rpx; font-weight: 700; letter-spacing: 2rpx; }.page-title { margin-top: 7rpx; font-size: 42rpx; font-weight: 750; }.page-sub { margin-top: 8rpx; color: #667085; font-size: 26rpx; }
.identity-card, .member-card, .asset-tile, .service-card { border: 1rpx solid #e3e9f2; border-radius: 26rpx; background: #fff; }
.identity-card { display: flex; align-items: center; gap: 18rpx; min-height: 146rpx; margin-top: 26rpx; padding: 22rpx; }
.avatar { flex: 0 0 auto; width: 92rpx; height: 92rpx; border-radius: 26rpx; background: #e8eef8; }
.identity-copy, .service-copy { flex: 1; min-width: 0; }.name-row { display: flex; align-items: center; gap: 10rpx; }
.nickname { max-width: 380rpx; overflow: hidden; font-size: 32rpx; font-weight: 730; text-overflow: ellipsis; white-space: nowrap; }
.member-tag { padding: 7rpx 11rpx; border-radius: 999rpx; color: #8a5100; background: #fff4de; font-size: 24rpx; }
.identity-desc { margin-top: 7rpx; overflow: hidden; color: #667085; font-size: 24rpx; line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }
.row-arrow { flex: 0 0 auto; color: #98a2b3; font-size: 38rpx; }
.member-card { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; min-height: 132rpx; margin-top: 16rpx; padding: 24rpx; color: #fff; border-color: #173b8f; background: #173b8f; }
.member-kicker { color: rgba(255,255,255,.86); font-size: 24rpx; }.member-title { margin-top: 7rpx; font-size: 28rpx; font-weight: 700; }.member-desc { margin-top: 7rpx; color: rgba(255,255,255,.9); font-size: 24rpx; }.member-action { flex: 0 0 auto; font-size: 24rpx; }
.section-head { min-height: 102rpx; padding: 30rpx 4rpx 16rpx; }.section-title { font-size: 30rpx; font-weight: 730; }.section-sub { margin-top: 6rpx; color: #667085; font-size: 24rpx; }
.asset-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 14rpx; }
.asset-tile { min-height: 190rpx; padding: 22rpx; }.asset-tile.is-disabled { color: #667085; background: #f7f8fb; opacity: .7; }
.asset-icon { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; border-radius: 19rpx; background: #eef4ff; }.asset-icon.amber { background: #fff4de; }.asset-icon.green { background: #e9f8f2; }.asset-icon.coral { background: #fff0ee; }.asset-icon image { width: 38rpx; height: 38rpx; }
.asset-name { margin-top: 18rpx; font-size: 28rpx; font-weight: 690; }.asset-meta { margin-top: 5rpx; color: #667085; font-size: 24rpx; }
.service-card { overflow: hidden; }.service-row { display: flex; align-items: center; gap: 16rpx; min-height: 104rpx; padding: 12rpx 20rpx; border-bottom: 1rpx solid #edf0f5; }.service-row:last-child { border-bottom: 0; }
.service-icon { display: flex; align-items: center; justify-content: center; flex: 0 0 auto; width: 64rpx; height: 64rpx; border-radius: 17rpx; background: #f3f6fb; }.service-icon image { width: 36rpx; height: 36rpx; }
.service-name { flex: 1; font-size: 26rpx; font-weight: 640; }.service-copy .service-name { display: block; }.service-desc { margin-top: 4rpx; color: #667085; font-size: 24rpx; }
.unread { min-width: 36rpx; height: 36rpx; padding: 0 10rpx; border-radius: 999rpx; color: #fff; background: #d83b3b; font-size: 24rpx; line-height: 36rpx; text-align: center; }
.press, .row-press { opacity: .76; }.row-press { background: #f7f9fd; }

/* Restore the premium cards and floating visual depth without changing structure. */
page { background: radial-gradient(circle at 90% -6%,rgba(105,133,255,.17),transparent 33%),linear-gradient(180deg,#fbfdff,#f3f7fd 58%,#f8fafc); }
.identity-card,.member-card,.asset-tile,.service-card { border-color: rgba(190,208,232,.72); background: linear-gradient(145deg,rgba(255,255,255,.99),rgba(247,250,255,.98)); box-shadow: 0 14rpx 34rpx rgba(36,58,92,.075),inset 0 1rpx 0 rgba(255,255,255,.95); }
.identity-card { border-radius: 30rpx; box-shadow: 0 20rpx 46rpx rgba(37,68,112,.1),inset 0 1rpx 0 rgba(255,255,255,.96); }
.avatar { border: 4rpx solid rgba(255,255,255,.96); box-shadow: 0 12rpx 28rpx rgba(31,55,96,.12); }
.member-card { border-color: rgba(91,104,223,.62); background: radial-gradient(circle at 100% 0,rgba(116,212,255,.3),transparent 36%),linear-gradient(135deg,#173b8f,#3d5fd1 62%,#6755df); box-shadow: 0 20rpx 42rpx rgba(42,71,166,.21),inset 0 1rpx 0 rgba(255,255,255,.22); }
.asset-tile { border-radius: 28rpx; }
.asset-icon,.service-icon { box-shadow: inset 0 1rpx 0 rgba(255,255,255,.92),0 8rpx 18rpx rgba(36,58,92,.06); }
