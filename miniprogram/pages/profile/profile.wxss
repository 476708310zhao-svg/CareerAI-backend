/* pages/profile/profile.wxss */
page {
  width: 100%;
  min-height: 100%;
  overflow-x: hidden;
  background: #f5f6f8;
  color: #172033;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
}

view,
text,
image {
  box-sizing: border-box;
}

.container {
  width: 100%;
  max-width: 750rpx;
  min-height: 100vh;
  margin: 0 auto;
  padding: 12rpx 22rpx calc(172rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
  background:
    radial-gradient(circle at 8% 0, rgba(37,99,235,0.055), transparent 27%),
    linear-gradient(180deg, #ffffff 0, #f5f6f8 300rpx, #f5f6f8 100%);
}

.profile-top {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 118rpx;
  padding: 10rpx 6rpx 14rpx;
}

.profile-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.avatar {
  display: block;
  width: 94rpx;
  height: 94rpx;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  background: #e9f0fb;
  box-shadow: 0 8rpx 22rpx rgba(37,68,112,0.13);
}

.avatar-badge {
  position: absolute;
  right: -8rpx;
  bottom: -1rpx;
  min-width: 48rpx;
  height: 27rpx;
  padding: 0 9rpx;
  border: 2rpx solid #ffffff;
  border-radius: 999rpx;
  color: #ffffff;
  background: #2563eb;
  font-size: 16rpx;
  font-weight: 900;
  line-height: 27rpx;
  text-align: center;
}

.info-text {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.nickname {
  max-width: 250rpx;
  overflow: hidden;
  color: #111827;
  font-size: 33rpx;
  font-weight: 950;
  line-height: 1.18;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-chevron {
  flex-shrink: 0;
  color: #667085;
  font-size: 35rpx;
  font-weight: 500;
  line-height: 1;
}

.school {
  max-width: 280rpx;
  margin-top: 7rpx;
  overflow: hidden;
  color: #7b8797;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.vip-badge {
  flex-shrink: 0;
  height: 32rpx;
  padding: 0 12rpx;
  border: 1rpx solid rgba(16,185,129,0.22);
  border-radius: 999rpx;
  color: #047857;
  background: #dcfce7;
  font-size: 16rpx;
  font-weight: 950;
  line-height: 32rpx;
}

.vip-banner {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 112rpx;
  padding: 20rpx 22rpx;
  overflow: hidden;
  border: 1rpx solid rgba(234,179,8,0.16);
  border-radius: 23rpx;
  background:
    radial-gradient(circle at 90% 14%, rgba(255,255,255,0.58), transparent 25%),
    linear-gradient(115deg, #fff87a 0%, #ffe62e 50%, #ffd51f 100%);
  box-shadow: 0 10rpx 24rpx rgba(202,138,4,0.11);
}

.vip-banner::after {
  content: '';
  position: absolute;
  right: 78rpx;
  top: -56rpx;
  width: 126rpx;
  height: 126rpx;
  border: 18rpx solid rgba(255,255,255,0.18);
  border-radius: 50%;
}

.vip-banner-active {
  min-height: 152rpx;
  border-color: rgba(16,185,129,0.22);
  background:
    radial-gradient(circle at 86% 12%, rgba(255,255,255,0.22), transparent 25%),
    linear-gradient(135deg, #052e2b 0%, #047857 58%, #10b981 100%);
  box-shadow: 0 14rpx 30rpx rgba(4,120,87,0.18);
}

.vip-banner-active .vip-crown {
  color: #064e3b;
  background: #ecfdf5;
}

.vip-banner-active .vip-title {
  color: #ffffff;
}

.vip-banner-active .vip-desc {
  color: #d1fae5;
}

.vip-banner-active .vip-btn {
  color: #047857;
  background: #ffffff;
  border-color: rgba(255,255,255,0.92);
}

.vip-left,
.vip-title-row {
  position: relative;
  z-index: 1;
  display: flex;
  min-width: 0;
}

.vip-left {
  flex: 1;
  flex-direction: column;
  gap: 7rpx;
}

.vip-title-row {
  align-items: center;
  gap: 9rpx;
}

.vip-crown {
  width: 47rpx;
  height: 31rpx;
  border-radius: 9rpx;
  color: #6d5200;
  background: rgba(255,255,255,0.6);
  font-size: 14rpx;
  font-weight: 950;
  line-height: 31rpx;
  text-align: center;
}

.vip-title {
  overflow: hidden;
  color: #2b2510;
  font-size: 27rpx;
  font-weight: 950;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.vip-desc {
  overflow: hidden;
  color: #65551f;
  font-size: 20rpx;
  font-weight: 650;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.vip-btn {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  height: 50rpx;
  padding: 0 17rpx;
  border: 1rpx solid rgba(255,255,255,0.74);
  border-radius: 999rpx;
  color: #5b4600;
  background: rgba(255,255,255,0.78);
  box-shadow: 0 7rpx 16rpx rgba(161,98,7,0.1);
  font-size: 19rpx;
  font-weight: 900;
  line-height: 50rpx;
}

.vip-unlocked-row {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 8rpx;
  min-width: 0;
  overflow: hidden;
}

.vip-unlocked-row text {
  display: inline-flex;
  align-items: center;
  height: 34rpx;
  padding: 0 11rpx;
  border: 1rpx solid rgba(255,255,255,0.24);
  border-radius: 999rpx;
  color: #ecfdf5;
  background: rgba(255,255,255,0.13);
  font-size: 17rpx;
  font-weight: 800;
  line-height: 34rpx;
  white-space: nowrap;
}


.records-card, .service-card { margin-top: 24rpx; border: 1rpx solid #e6ebf3; border-radius: 24rpx; background: #fff; }
.records-card { padding: 24rpx 18rpx; }
.section-title { display: block; padding: 0 6rpx; font-size: 28rpx; font-weight: 700; color: #172033; line-height: 1.4; }
.records-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: 20rpx; }
.record-item { display: flex; flex-direction: column; align-items: center; min-width: 0; padding: 8rpx 4rpx; }
.record-icon { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; border-radius: 20rpx; margin-bottom: 14rpx; }
.record-icon image { width: 36rpx; height: 36rpx; }
.tone-amber { background: #fff5dc; }
.tone-blue { background: #edf4ff; }
.tone-coral { background: #fff0ef; }
.tone-mint { background: #eafaf4; }
.record-name { font-size: 26rpx; font-weight: 600; line-height: 1.4; color: #263247; }
.record-meta { margin-top: 8rpx; font-size: 22rpx; line-height: 1.5; color: #667085; text-align: center; }
.has-unread { color: #2563eb; }
.service-card { padding: 0 24rpx; }
.service-row { display: flex; align-items: center; gap: 20rpx; min-height: 100rpx; padding: 20rpx 0; border-bottom: 1rpx solid #edf0f5; }
.service-row:last-child { border-bottom: none; }
.service-icon { width: 52rpx; height: 52rpx; padding: 10rpx; border-radius: 16rpx; background: #5f83ba; flex-shrink: 0; }
.service-name { flex: 1; font-size: 27rpx; color: #263247; line-height: 1.5; }
.service-arrow { color: #98a2b3; font-size: 36rpx; }
.panel-press, .tile-press, .tap-soft { opacity: .8; }
