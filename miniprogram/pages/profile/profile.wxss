page { min-height: 100%; background: var(--zy-bg); }
.profile-page { min-height: 100vh; box-sizing: border-box; padding: 48rpx 28rpx 0; color: var(--zy-ink); background: radial-gradient(circle at 92% 0, rgba(49,94,232,.08), transparent 33%), var(--zy-bg); }
.page-head { display: flex; flex-direction: column; padding: 0 4rpx 24rpx; }
.page-title { font-size: 48rpx; font-weight: 820; letter-spacing: -2rpx; line-height: 1.2; }
.page-sub { margin-top: 10rpx; color: var(--zy-muted); font-size: 26rpx; line-height: 38rpx; }

.identity-card { display: flex; align-items: center; min-height: 142rpx; padding: 20rpx 22rpx; border: 1rpx solid var(--zy-line); border-radius: var(--zy-radius-lg); background: #fff; box-shadow: var(--zy-shadow-card); transition: opacity 180ms ease; }
.avatar { flex: none; width: 88rpx; height: 88rpx; margin-right: 20rpx; border: 4rpx solid #edf2ff; border-radius: 50%; background: #eef2f8; }
.identity-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.name-row { display: flex; align-items: center; min-width: 0; }
.nickname { overflow: hidden; color: var(--zy-ink); font-size: 32rpx; font-weight: 820; line-height: 42rpx; text-overflow: ellipsis; white-space: nowrap; }
.member-tag { flex: none; margin-left: 12rpx; padding: 6rpx 12rpx; border-radius: 999rpx; color: var(--zy-brand); background: var(--zy-brand-soft); font-size: 24rpx; font-weight: 760; }
.identity-desc { margin-top: 6rpx; overflow: hidden; color: var(--zy-muted); font-size: 24rpx; line-height: 34rpx; text-overflow: ellipsis; white-space: nowrap; }

.section-head { display: flex; margin: 38rpx 4rpx 16rpx; }
.section-head > view { display: flex; flex-direction: column; }
.section-title { color: var(--zy-ink); font-size: 32rpx; font-weight: 820; line-height: 42rpx; }
.section-sub { margin-top: 4rpx; color: var(--zy-muted); font-size: 24rpx; line-height: 34rpx; }
.asset-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14rpx; }
.asset-tile { display: flex; align-items: center; min-width: 0; min-height: 136rpx; padding: 18rpx; border: 1rpx solid var(--zy-line); border-radius: var(--zy-radius-md); background: #fff; box-shadow: 0 10rpx 28rpx rgba(49,94,232,.045); transition: opacity 180ms ease; }
.asset-icon { display: flex; align-items: center; justify-content: center; flex: none; width: 64rpx; height: 64rpx; margin-right: 14rpx; border-radius: 20rpx; background: var(--zy-brand-soft); }
.asset-icon image { width: 38rpx; height: 38rpx; }
.asset-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.asset-name { overflow: hidden; color: var(--zy-ink); font-size: 27rpx; font-weight: 770; line-height: 36rpx; text-overflow: ellipsis; white-space: nowrap; }
.asset-meta { margin-top: 4rpx; overflow: hidden; color: var(--zy-muted); font-size: 24rpx; line-height: 32rpx; text-overflow: ellipsis; white-space: nowrap; }
.asset-arrow { flex: none; margin-left: 5rpx; color: #98a2b3; font-size: 30rpx; }

.service-card { overflow: hidden; border: 1rpx solid var(--zy-line); border-radius: var(--zy-radius-md); background: #fff; box-shadow: var(--zy-shadow-card); }
.service-row { display: flex; align-items: center; min-height: 104rpx; padding: 8rpx 20rpx; border-bottom: 1rpx solid var(--zy-line); transition: background-color 180ms ease, opacity 180ms ease; }
.service-row:last-child { border-bottom: 0; }
.service-icon { display: flex; align-items: center; justify-content: center; flex: none; width: 60rpx; height: 60rpx; margin-right: 16rpx; border-radius: 18rpx; background: var(--zy-brand-soft); }
.service-icon image { width: 36rpx; height: 36rpx; }
.service-name { flex: 1; color: var(--zy-ink); font-size: 27rpx; font-weight: 720; }
.service-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.service-copy .service-name { flex: none; }
.service-desc { margin-top: 3rpx; color: var(--zy-muted); font-size: 24rpx; line-height: 32rpx; }
.row-arrow { flex: none; width: 34rpx; color: #98a2b3; font-size: 36rpx; text-align: right; }
.unread { min-width: 36rpx; height: 36rpx; margin-right: 12rpx; padding: 0 8rpx; border-radius: 999rpx; color: #fff; background: var(--zy-danger); font-size: 24rpx; font-weight: 760; line-height: 36rpx; text-align: center; }
.about-link { display: flex; align-items: center; justify-content: center; min-height: 88rpx; margin-top: 20rpx; color: var(--zy-muted); font-size: 24rpx; }
.press,.row-press { opacity: .72; }
.bottom-spacer { height: 230rpx; height: calc(230rpx + env(safe-area-inset-bottom)); }

@media (max-width: 340px) { .asset-grid { grid-template-columns: 1fr; } }
@media (prefers-reduced-motion: reduce) { .identity-card,.asset-tile,.service-row { transition: none; } }
