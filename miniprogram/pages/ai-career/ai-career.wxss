page {
  background: #f5f8ff;
  color: #111827;
}

.page {
  display: flex;
  position: relative;
  overflow: hidden;
  flex-direction: column;
  height: 100vh;
  padding-bottom: 148rpx;
  background: radial-gradient(circle at 92% 5%, rgba(216, 231, 255, .72), transparent 32%), linear-gradient(180deg, #fbfdff 0%, #f3f7ff 100%);
  box-sizing: border-box;
}

.top-bar {
  z-index: 12;
  display: flex;
  position: relative;
  align-items: center;
  min-height: 96rpx;
  padding-right: 24rpx;
  padding-left: 28rpx;
  border-bottom: 1rpx solid rgba(226, 232, 243, .76);
  background: rgba(255, 255, 255, .94);
  box-sizing: content-box;
}

.top-title { display: flex; align-items: center; min-width: 0; flex: 1; }
.top-icon, .ai-avatar { display: flex; align-items: center; justify-content: center; flex: 0 0 auto; width: 60rpx; height: 60rpx; border: 1rpx solid #d8e5ff; border-radius: 20rpx; background: #edf3ff; }
.top-icon image { width: 34rpx; height: 34rpx; }
.top-copy { display: flex; min-width: 0; flex-direction: column; margin-left: 16rpx; }
.top-name { color: #111827; font-size: 32rpx; font-weight: 800; line-height: 42rpx; }
.top-actions { display: flex; align-items: center; gap: 4rpx; }
.top-action-btn { display: flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; border-radius: 50%; }
.top-action-btn image { width: 35rpx; height: 35rpx; opacity: .78; }
.top-action-btn.primary text { display: flex; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; border: 1rpx solid #cddcff; border-radius: 18rpx; color: #315ee8; background: #edf3ff; font-size: 35rpx; font-weight: 500; line-height: 54rpx; }

.context-bar { z-index: 11; display: flex; align-items: center; min-height: 72rpx; margin: 16rpx 28rpx 0; padding: 0 18rpx; border: 1rpx solid #dce6f6; border-radius: 18rpx; background: rgba(255, 255, 255, .9); box-sizing: border-box; }
.context-status-dot { width: 12rpx; height: 12rpx; margin-right: 10rpx; border: 4rpx solid #dce8ff; border-radius: 50%; background: #315ee8; }
.context-caption { flex-shrink: 0; color: #667085; font-size: 21rpx; }
.context-text { overflow: hidden; min-width: 0; flex: 1; margin-left: 14rpx; color: #1f2a44; font-size: 22rpx; font-weight: 750; text-overflow: ellipsis; white-space: nowrap; }
.context-switch { display: flex; align-items: center; justify-content: center; min-width: 88rpx; min-height: 88rpx; margin-left: 8rpx; color: #315ee8; font-size: 21rpx; font-weight: 700; }

.msg-scroll { min-height: 0; flex: 1; overflow: hidden; }
.msg-list { padding: 22rpx 28rpx 0; }
.time-stamp { margin: 12rpx 0; color: #667085; font-size: 20rpx; text-align: center; }
.msg-row { display: flex; width: 100%; margin-bottom: 26rpx; }
.user-row { justify-content: flex-end; }
.ai-row { align-items: flex-start; }
.ai-avatar { width: 54rpx; height: 54rpx; margin: 8rpx 14rpx 0 0; border-radius: 18rpx; }
.ai-avatar image { width: 30rpx; height: 30rpx; }
.bubble-wrap { max-width: 84%; }
.user-row .bubble-wrap { display: flex; align-items: flex-end; flex-direction: column; max-width: 78%; }
.bubble { padding: 22rpx 24rpx; border-radius: 22rpx; box-sizing: border-box; }
.user-bubble { border-bottom-right-radius: 7rpx; color: #173262; background: #e3edff; }
.ai-bubble { border: 1rpx solid #e1e8f3; border-bottom-left-radius: 7rpx; background: #fff; box-shadow: 0 12rpx 34rpx rgba(59, 91, 151, .05); }
.error-bubble { color: #9f342f; background: #fff1f0; }
.bubble-text { color: inherit; font-size: 26rpx; line-height: 1.7; word-break: break-word; }
.bubble-rich { display: block; }
.ai-generated-label { display: block; margin: 0 0 7rpx 4rpx; color: #667085; font-size: 24rpx; font-weight: 600; line-height: 32rpx; }
.welcome-row { margin-top: 4rpx; }
.welcome-row .bubble-wrap { min-width: 0; max-width: calc(100% - 68rpx); flex: 1; }
.welcome-row .ai-bubble { padding: 25rpx 25rpx 20rpx; border-radius: 24rpx 24rpx 24rpx 8rpx; }
.welcome-context { display: flex; align-items: center; min-height: 88rpx; margin-top: 20rpx; padding: 11rpx 6rpx 0; border-top: 1rpx solid #e9eef6; box-sizing: border-box; }
.welcome-context > image { flex: 0 0 auto; width: 34rpx; height: 34rpx; }
.welcome-context-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; margin-left: 12rpx; }
.welcome-context-label { color: #315ee8; font-size: 24rpx; font-weight: 700; }
.welcome-context-value { overflow: hidden; margin-top: 3rpx; color: #667085; font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
.welcome-context-action { display: flex; align-items: center; justify-content: center; min-width: 80rpx; min-height: 72rpx; color: #315ee8; font-size: 20rpx; font-weight: 750; }
.welcome-starters { margin-top: 22rpx; }
.welcome-starters-label { display: block; margin: 0 0 10rpx 3rpx; color: #667085; font-size: 24rpx; }
.welcome-starter { display: flex; align-items: center; min-height: 88rpx; margin-top: 10rpx; padding: 0 15rpx 0 20rpx; border: 1rpx solid #dfe6f1; border-radius: 20rpx; color: #344054; background: rgba(255,255,255,.92); box-sizing: border-box; }
.welcome-starter text { min-width: 0; flex: 1; font-size: 22rpx; line-height: 1.4; }
.welcome-starter image { flex: 0 0 auto; width: 26rpx; height: 26rpx; margin-left: 10rpx; }
.ai-notice { display: block; margin: 20rpx 0 0; color: #667085; font-size: 24rpx; line-height: 1.5; text-align: center; }
.loading-bubble { min-width: 260rpx; }
.thinking-head { display: flex; align-items: center; gap: 14rpx; }
.thinking-title { color: #475467; font-size: 23rpx; }
.dot-wrap { display: flex; gap: 6rpx; }
.dot { width: 7rpx; height: 7rpx; border-radius: 50%; background: #315ee8; animation: pulse 1s infinite; }
.dot:nth-child(2) { animation-delay: .15s; }
.dot:nth-child(3) { animation-delay: .3s; }
@keyframes pulse { 50% { opacity: .25; } }

.answer-action-card { overflow: hidden; margin-top: -2rpx; border: 1rpx solid #e1e8f3; border-top: 1rpx solid #edf1f6; border-radius: 0 0 22rpx 22rpx; background: #fff; }
.answer-action-head { display: none; }
.answer-action-grid { display: flex; align-items: center; min-height: 88rpx; }
.answer-action-btn { display: flex; align-items: center; justify-content: center; flex: 1; min-height: 88rpx; border-right: 1rpx solid #e3e9f2; color: #667085; font-size: 22rpx; }
.answer-action-btn:last-child { border-right: 0; }
.answer-action-btn.primary { color: #315ee8; font-weight: 750; }
.answer-suggestions { margin-top: 28rpx; }
.answer-suggestions-title { display: block; color: #667085; font-size: 21rpx; }
.answer-suggestion-list { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.sug-chip { min-height: 88rpx; padding: 0 22rpx; border: 1rpx solid #d9e3f3; border-radius: 999rpx; color: #526581; background: #fff; font-size: 21rpx; line-height: 88rpx; }
.retry-row { margin-top: 10rpx; }
.retry-btn { display: inline-flex; align-items: center; min-height: 88rpx; padding: 0 22rpx; border-radius: 999rpx; color: #315ee8; background: #eaf1ff; font-size: 21rpx; }

.input-bar { z-index: 15; position: absolute; right: 0; left: 0; padding: 22rpx 24rpx 13rpx; background: linear-gradient(180deg, rgba(245,248,255,0) 0%, rgba(255,255,255,.96) 24%, #fff 100%); box-sizing: border-box; }
.composer-shell { overflow: hidden; padding: 8rpx 10rpx 9rpx 20rpx; border: 1rpx solid #d9e1ee; border-radius: 28rpx; background: #fff; box-shadow: 0 10rpx 30rpx rgba(46,72,116,.1); }
.input { width: 100%; height: 68rpx; padding: 0 8rpx; color: #17213a; font-size: 24rpx; box-sizing: border-box; }
.input-ph { color: #667085; }
.composer-footer { display: flex; align-items: center; min-height: 88rpx; }
.composer-tool { display: flex; align-items: center; min-width: 112rpx; min-height: 88rpx; padding: 0 10rpx; border-radius: 18rpx; color: #475467; font-size: 20rpx; font-weight: 700; box-sizing: border-box; }
.composer-plus { margin-right: 5rpx; color: #315ee8; font-size: 30rpx; font-weight: 500; }
.composer-context { overflow: hidden; min-width: 0; flex: 1; padding: 0 10rpx; color: #667085; font-size: 18rpx; text-align: right; text-overflow: ellipsis; white-space: nowrap; }
.char-count { flex: 0 0 auto; margin-right: 8rpx; color: #667085; font-size: 18rpx; }
.char-warn { color: #d94e45; }
.send-btn { display: flex; align-items: center; justify-content: center; flex: 0 0 auto; width: 88rpx; height: 88rpx; border-radius: 25rpx; color: #fff; background: #315ee8; box-shadow: 0 8rpx 20rpx rgba(49,94,232,.2); }
.send-btn.inactive { color: #93a0b4; background: #e9edf4; box-shadow: none; }
.send-btn.stop-btn { background: #d94e45; }
.send-icon { font-size: 32rpx; font-weight: 800; }
.btn-hover, .card-hover, .chip-hover { opacity: .68; }

.drawer-mask { z-index: 40; position: fixed; inset: 0; background: rgba(17, 24, 39, .28); }
.drawer { z-index: 41; position: fixed; left: 0; width: 80%; max-width: 600rpx; max-height: 72vh; padding: 12rpx 18rpx 18rpx; border: 1rpx solid #e2e8f3; border-left: 0; border-radius: 0 28rpx 28rpx 0; background: #fff; box-shadow: 16rpx 16rpx 44rpx rgba(29, 45, 76, .14); box-sizing: border-box; transform: translateX(-105%); transition: transform .22s ease; }
.drawer.open { transform: translateX(0); }
.drawer-scroll { max-height: calc(72vh - 30rpx); }
.drawer-brand { display: flex; align-items: center; min-height: 88rpx; margin: 0 4rpx 4rpx; }
.drawer-close { display: flex; align-items: center; justify-content: center; min-width: 88rpx; min-height: 88rpx; margin-left: auto; color: #315ee8; font-size: 21rpx; font-weight: 700; }
.drawer-logo { display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; border-radius: 14rpx; color: #315ee8; background: #edf3ff; font-size: 18rpx; font-weight: 850; }
.drawer-title { margin-left: 14rpx; color: #111827; font-size: 28rpx; font-weight: 800; }
.drawer-new { display: flex; align-items: center; min-height: 88rpx; padding: 0 14rpx; border-bottom: 1rpx solid #e8edf5; border-radius: 14rpx; color: #315ee8; font-size: 23rpx; font-weight: 750; box-sizing: border-box; }
.drawer-new-icon { display: flex; align-items: center; justify-content: center; width: 40rpx; height: 40rpx; margin-right: 16rpx; border-radius: 12rpx; background: #edf3ff; font-size: 29rpx; line-height: 1; }
.drawer-section-title { margin: 16rpx 12rpx 5rpx; color: #667085; font-size: 20rpx; font-weight: 700; }
.drawer-tool, .recent-chat { display: flex; align-items: center; min-height: 88rpx; margin: 0; padding: 0 12rpx; border-radius: 14rpx; background: transparent; box-sizing: border-box; }
.drawer-tool-icon { display: flex; align-items: center; justify-content: center; width: 40rpx; height: 40rpx; border-radius: 12rpx; background: #f1f5ff; }
.drawer-tool-icon image { width: 26rpx; height: 26rpx; }
.drawer-tool-copy, .recent-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; margin-left: 16rpx; }
.drawer-tool-title, .recent-name { overflow: hidden; color: #1d2939; font-size: 23rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.drawer-more { display: flex; align-items: center; min-height: 88rpx; padding: 0 14rpx; color: #315ee8; font-size: 21rpx; font-weight: 700; box-sizing: border-box; }
.drawer-hint { display: block; margin: 8rpx 12rpx 0; padding-top: 14rpx; border-top: 1rpx solid #eef1f6; color: #667085; font-size: 19rpx; line-height: 1.5; }
.recent-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #315ee8; }
.recent-time { color: #667085; font-size: 18rpx; }

.application-mask { z-index: 45; position: fixed; inset: 0; background: rgba(15, 23, 42, .34); }
.application-panel { z-index: 46; position: fixed; right: 0; bottom: 0; left: 0; max-height: 88vh; padding-bottom: env(safe-area-inset-bottom); border-radius: 34rpx 34rpx 0 0; background: #fff; transform: translateY(105%); transition: transform .24s ease; }
.application-panel.show { transform: translateY(0); }
.application-header { display: flex; align-items: center; justify-content: space-between; padding: 26rpx 24rpx 18rpx 30rpx; border-bottom: 1rpx solid #e8edf5; }
.application-heading { display: flex; flex-direction: column; }
.application-kicker { color: #315ee8; font-size: 18rpx; font-weight: 800; }
.application-title { margin-top: 3rpx; font-size: 32rpx; font-weight: 900; }
.application-close { display: flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; color: #667085; font-size: 40rpx; }
.application-body { max-height: 74vh; padding: 0 30rpx; box-sizing: border-box; }
.application-section { margin-top: 24rpx; }
.application-label { display: block; margin-bottom: 12rpx; font-size: 23rpx; font-weight: 750; }
.application-choice-row { display: flex; gap: 12rpx; }
.application-choice { flex-shrink: 0; min-width: 210rpx; min-height: 88rpx; padding: 18rpx; border: 1rpx solid #dfe7f3; border-radius: 16rpx; box-sizing: border-box; }
.application-choice.active { border-color: #8fb5ff; background: #edf4ff; }
.application-choice-title, .application-choice-sub { display: block; }
.application-choice-title { font-size: 23rpx; font-weight: 800; }
.application-choice-sub { margin-top: 3rpx; color: #667085; font-size: 20rpx; }
.application-empty, .application-resume-picker, .application-jd-input { min-height: 88rpx; padding: 20rpx; border-radius: 16rpx; background: #f5f8fd; color: #667085; font-size: 22rpx; box-sizing: border-box; }
.application-resume-picker { display: flex; align-items: center; justify-content: space-between; }
.application-resume-title, .application-resume-sub { display: block; }
.application-resume-title { color: #19243a; font-weight: 800; }
.application-resume-sub { margin-top: 4rpx; }
.application-resume-action { color: #315ee8; }
.application-jd-input { width: 100%; min-height: 140rpx; box-sizing: border-box; }
.question-type-grid { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 14rpx; }
.question-type { min-height: 88rpx; padding: 0 20rpx; border-radius: 999rpx; background: #f1f4f9; font-size: 21rpx; line-height: 88rpx; }
.question-type.active { color: #315ee8; background: #e7efff; }
.application-generate { display: flex; align-items: center; justify-content: center; min-height: 88rpx; margin: 26rpx 0; border-radius: 18rpx; color: #fff; background: #315ee8; font-size: 24rpx; font-weight: 800; }
.application-generate.disabled { opacity: .46; }
.application-draft, .saved-material { margin: 20rpx 0; padding: 22rpx; border: 1rpx solid #e0e8f4; border-radius: 18rpx; }
.application-draft-title, .application-draft-meta, .application-draft-resume, .application-draft-content { display: block; }
.application-draft-title { font-weight: 850; }
.application-draft-meta, .application-draft-resume { margin-top: 5rpx; color: #667085; font-size: 20rpx; }
.application-draft-content { margin-top: 14rpx; font-size: 23rpx; line-height: 1.65; }
.application-draft-actions { display: flex; gap: 12rpx; margin-top: 18rpx; }
.application-draft-btn { flex: 1; min-height: 88rpx; border-radius: 14rpx; color: #315ee8; background: #edf4ff; line-height: 88rpx; text-align: center; }
.application-draft-btn.primary { color: #fff; background: #315ee8; }
.application-label-row, .saved-material-head { display: flex; align-items: center; justify-content: space-between; }
.application-label-link { display: flex; align-items: center; min-height: 88rpx; color: #315ee8; font-size: 21rpx; }
.saved-material-title { font-size: 22rpx; font-weight: 800; }
.saved-material-meta { color: #667085; font-size: 19rpx; }
.saved-material-content { display: -webkit-box; overflow: hidden; margin-top: 8rpx; color: #667085; font-size: 21rpx; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }

.input-bar { bottom: 148rpx; }
.input-bar.keyboard-open { bottom: 0; }

/* 兼容旧 WXML 缓存中的解释性副标题。 */
.top-sub,.drawer-tool-desc,.recent-preview { display: none !important; }

@media (prefers-reduced-motion: reduce) {
  .drawer, .application-panel { transition: none; }
  .dot { animation: none; opacity: .6; }
}

/* AI conversation prototype: quiet conversation, persistent history, separate tools. */
.page{background:#fff}
.top-bar{padding-right:180rpx;background:#fff;border-bottom:1rpx solid #eef0f3}
.top-icon{display:none}
.top-copy{margin-left:0}
.top-name{font-size:31rpx;font-weight:750}
.menu-mark{color:#27303c;font-size:31rpx;line-height:1}
.top-action-btn.primary text{border:0;background:transparent;color:#27303c;font-size:38rpx}
.msg-list{padding-top:25rpx}
.msg-row{margin-bottom:30rpx}
.user-bubble{border-radius:23rpx 23rpx 8rpx 23rpx;background:#f0f2f5;color:#242a33}
.ai-avatar{width:42rpx;height:42rpx;margin-right:13rpx;border:0;border-radius:13rpx}
.ai-avatar image{width:25rpx;height:25rpx}
.ai-bubble{padding:4rpx 0;border:0;border-radius:0;background:transparent;box-shadow:none}
.welcome-row .ai-bubble{padding:4rpx 0;border:0;border-radius:0;background:transparent}
.bubble-wrap{max-width:calc(100% - 58rpx)}
.welcome-row .bubble-wrap{max-width:calc(100% - 58rpx)}
.ai-generated-label{font-size:22rpx;font-weight:650;color:#4e5663}
.answer-action-card{margin-top:8rpx;border:0;border-radius:0;background:transparent}
.answer-action-grid{justify-content:flex-start;gap:18rpx;min-height:72rpx}
.answer-action-btn,.answer-action-btn.primary{flex:0 0 auto;min-height:72rpx;padding:0 8rpx;border:0;color:#6d7684;font-size:20rpx;font-weight:500}
.answer-suggestions{margin-top:8rpx}
.answer-suggestions-title{display:none}
.sug-chip{min-height:74rpx;line-height:74rpx}
.input-bar{background:linear-gradient(180deg,rgba(255,255,255,0),#fff 20%)}
.composer-shell{border-color:#e0e4eb;box-shadow:0 8rpx 28rpx rgba(25,36,57,.07)}
.input{display:block;width:100%;min-height:66rpx;height:auto;max-height:170rpx;padding:12rpx 8rpx 0;line-height:1.5;font-size:26rpx;box-sizing:border-box}
.composer-spacer{flex:1}
.composer-context-chip{display:inline-flex;align-items:center;max-width:100%;min-height:88rpx;margin:0 0 10rpx;padding:0 20rpx;border:1rpx solid #dae4fa;border-radius:999rpx;color:#315ee8;background:#f5f7ff;font-size:21rpx;box-sizing:border-box}
.composer-context-chip text:first-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.composer-context-open{margin-left:8rpx;font-size:27rpx}
.send-btn{width:88rpx;height:88rpx;border-radius:50%;box-shadow:none}
.composer-footer{min-height:88rpx}
.composer-tool{min-height:88rpx}
.drawer-mask{background:rgba(28,34,43,.32)}
.drawer{display:flex;flex-direction:column;top:0;bottom:0;width:82%;max-width:400px;height:auto;max-height:none;padding:0 20rpx;border:0;border-radius:0;background:#fff;box-shadow:12rpx 0 40rpx rgba(20,31,52,.12)}
.drawer-brand{flex:0 0 auto;min-height:100rpx;margin:0 4rpx}
.drawer-title{margin-left:0;font-size:34rpx;font-weight:750}
.drawer-close{color:#616a76;font-size:42rpx;font-weight:400}
.drawer-new{flex:0 0 auto;min-height:88rpx;margin:0 6rpx;padding:0 18rpx;border:0;border-radius:18rpx;color:#202630;font-size:29rpx;font-weight:650}
.drawer-new-icon{width:42rpx;height:42rpx;margin-right:15rpx;background:transparent;color:#27303c;font-size:32rpx}
.drawer-search{display:flex;align-items:center;flex:0 0 auto;min-height:88rpx;margin:8rpx 6rpx 10rpx;padding:0 18rpx;border-radius:18rpx;background:#f3f4f6;box-sizing:border-box}
.drawer-search-icon{margin-right:13rpx;color:#88909d;font-size:33rpx}
.drawer-search input{flex:1;color:#27303c;font-size:27rpx}
.drawer-scroll{flex:1;height:0;min-height:0;max-height:none}
.drawer-section-title{margin:25rpx 16rpx 10rpx;font-size:24rpx}
.recent-chat{gap:10rpx;min-height:88rpx;margin:0 4rpx;padding:0 16rpx}
.recent-chat.active{background:#edf1fa}
.recent-chat.active .recent-name{color:#263f79;font-weight:700}
.recent-icon{flex:0 0 34rpx;color:#657287;font-size:26rpx}
.recent-name{flex:1;min-width:0;color:#303844;font-size:28rpx;font-weight:500}
.recent-options{display:flex;align-items:center;justify-content:center;flex:0 0 88rpx;min-height:88rpx;color:#667085;font-size:30rpx}
.drawer-empty{display:flex;flex:1;min-height:0;flex-direction:column;align-items:center;justify-content:center;padding:0 24rpx 70rpx;text-align:center;box-sizing:border-box}
.drawer-empty-icon{display:flex;align-items:center;justify-content:center;width:96rpx;height:96rpx;border-radius:28rpx;background:#f0f4fb}
.drawer-empty-icon image{width:48rpx;height:48rpx}
.drawer-empty-title{margin-top:28rpx;color:#27303c;font-size:30rpx;font-weight:650}
.drawer-empty-desc{margin-top:12rpx;color:#596575;font-size:25rpx;line-height:1.5}
.tool-mask{z-index:42;position:fixed;inset:0;background:rgba(20,27,39,.32)}
.tool-panel,.context-panel{z-index:43;position:fixed;right:0;bottom:0;left:0;max-height:78vh;padding:16rpx 28rpx calc(env(safe-area-inset-bottom) + 22rpx);border-radius:34rpx 34rpx 0 0;background:#fff;box-sizing:border-box}
.tool-panel-head{display:flex;align-items:center;justify-content:space-between;min-height:76rpx;color:#1f2937;font-size:31rpx;font-weight:700}
.tool-panel-head view{display:flex;align-items:center;justify-content:center;width:88rpx;height:88rpx;color:#667085;font-size:36rpx;font-weight:400}
.tool-panel-scroll{max-height:62vh}
.tool-group-label{display:block;margin:19rpx 6rpx 8rpx;color:#667085;font-size:21rpx;font-weight:650}
.tool-item{display:flex;align-items:center;min-height:100rpx;padding:5rpx 8rpx;border-radius:16rpx}
.tool-icon{display:flex;align-items:center;justify-content:center;flex:0 0 54rpx;width:54rpx;height:54rpx;border-radius:14rpx;background:#f1f4fa}
.tool-icon image{width:30rpx;height:30rpx}
.tool-copy{display:flex;min-width:0;flex:1;flex-direction:column;margin-left:18rpx}
.tool-name{color:#252c37;font-size:24rpx;font-weight:650}
.tool-desc{overflow:hidden;margin-top:4rpx;color:#727b89;font-size:19rpx;text-overflow:ellipsis;white-space:nowrap}
.tool-action{margin-left:12rpx;color:#315ee8;font-size:20rpx}
.context-panel{max-height:none}
.context-panel-name{display:block;margin:18rpx 2rpx 10rpx;color:#202b3a;font-size:26rpx;font-weight:650}
.context-panel-desc{display:block;color:#667085;font-size:22rpx;line-height:1.6}
.context-remove{display:flex;align-items:center;justify-content:center;min-height:88rpx;margin-top:26rpx;border:1rpx solid #dce4f0;border-radius:18rpx;color:#315ee8;font-size:23rpx}
