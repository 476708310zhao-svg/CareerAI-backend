<view class="progress-page">
  <view class="page-head"><view><text class="page-title">申请进度</text><text class="page-sub">每次只推进一个明确节点</text></view><view class="add-button" bindtap="openCreate" hover-class="press" aria-role="button" aria-label="新增申请"><text class="add-line"></text><text>新增申请</text></view></view>

  <view wx:if="{{syncNotice && !loading}}" class="notice-card"><text class="notice-dot"></text><text>{{syncNotice}}</text></view>
  <view wx:if="{{loading}}" class="state-card compact" aria-role="status" aria-label="正在同步申请进度"><view class="spinner" aria-hidden="true"></view><text class="state-desc">正在同步申请进度…</text></view>
  <view wx:elif="{{loginRequired}}" class="state-card"><view class="state-mark"><text></text></view><text class="state-title">登录后开启申请工作台</text><text class="state-desc">申请状态、材料、联系人、任务和面试记录会安全同步到你的账号。</text><view class="primary-button" bindtap="promptLogin" hover-class="press" aria-role="button" aria-label="立即登录">立即登录</view></view>
  <view wx:elif="{{error}}" class="state-card"><view class="state-mark error"><text></text></view><text class="state-title">暂时无法加载</text><text class="state-desc">{{error}}</text><view class="primary-button" bindtap="retry" hover-class="press" aria-role="button" aria-label="重新加载">重新加载</view></view>

  <block wx:else>
    <view wx:if="{{highlights.length}}" class="focus-section"><view class="section-head"><view><text class="section-title">建议下一步</text></view><text class="section-count">{{highlights.length}} 项</text></view><view class="focus-card"><view wx:for="{{highlights}}" wx:key="id" class="focus-row" data-id="{{item.id}}" bindtap="openApplication" hover-class="row-press" aria-role="button" aria-label="{{item.title}}，{{item.desc}}"><text class="focus-badge {{item.type}}">{{item.badge}}</text><view class="row-copy"><text class="row-title">{{item.title}}</text><text class="row-desc">{{item.desc}}</text></view><text class="focus-action">开始准备</text></view></view></view>

    <view class="summary-card">
      <view class="summary-head"><view><text class="summary-title">申请概览</text><text class="summary-label">{{activeCount}} 条正在推进</text></view><text class="summary-state">共 {{total}} 条</text></view>
      <view class="funnel" aria-label="申请阶段概览">
        <view wx:for="{{funnel}}" wx:key="key" class="funnel-item"><text class="funnel-count">{{item.count}}</text><text class="funnel-label">{{item.label}}</text></view>
      </view>
    </view>

    <view class="section list-section"><view class="section-head"><view><text class="section-title">全部申请</text></view></view>
      <scroll-view class="filter-scroll" scroll-x enhanced show-scrollbar="{{false}}"><view class="filter-row"><view wx:for="{{filters}}" wx:key="key" class="filter {{activeGroup===item.key?'active':''}}" data-group="{{item.key}}" bindtap="changeGroup" hover-class="press" aria-role="button" aria-label="筛选{{item.label}}，{{item.count}}条" aria-selected="{{activeGroup===item.key}}"><text>{{item.label}}</text><text class="filter-count">{{item.count}}</text></view></view></scroll-view>
      <view wx:if="{{visibleApplications.length===0}}" class="state-card empty-state"><view class="state-mark add"><text></text></view><text class="state-title">{{activeGroup==='all'?'还没有申请记录':'该阶段暂无申请'}}</text><text class="state-desc">从岗位页加入目标，或手动记录一条真实申请。</text><view class="empty-actions"><view class="primary-button small" bindtap="goJobs" hover-class="press" aria-role="button" aria-label="去找岗位">去找岗位</view><view class="secondary-button" bindtap="openCreate" hover-class="press" aria-role="button" aria-label="手动记录申请">手动记录</view></view></view>
      <view wx:else class="application-list"><view wx:for="{{visibleApplications}}" wx:key="id" class="application-card" data-id="{{item.id}}" bindtap="openApplication" hover-class="row-press" aria-role="button" aria-label="{{item.company}} {{item.jobTitle}}，{{item.statusText}}">
        <view class="card-top"><view class="company-mark tone-{{item.statusTone}}">{{item.companyInitial}}</view><view class="row-copy"><text class="job-title">{{item.company || '目标公司'}}｜{{item.jobTitle || '目标岗位'}}</text><text class="company">{{item.city || '地点待确认'}}</text></view><text class="status status-{{item.statusTone}}"><text class="status-dot"></text>{{item.statusText || item.groupLabel}}</text></view>
        <view class="next-action"><text class="next-label">下一步</text><text class="next-text">{{item.nextAction || '补充跟进计划'}}</text></view>
        <view class="card-meta"><view class="meta-copy"><text wx:if="{{item.interviewLabel}}" class="meta-pill interview">{{item.interviewLabel}}</text><text class="meta-pill {{item.deadlineTone}}">{{item.deadlineLabel}}</text></view><button class="status-button" size="mini" data-id="{{item.id}}" catchtap="quickStatus" loading="{{updatingId === '' + item.id}}" disabled="{{!!updatingId}}" aria-label="{{item.localOnly ? '编辑本机申请记录' : '更新申请状态'}}">{{item.localOnly ? '编辑记录' : '更新状态'}}</button></view>
      </view></view>
    </view>
  </block>

  <view wx:if="{{showCreate}}" class="modal-mask" catchtap="closeCreate" aria-role="button" aria-label="关闭新增申请弹窗"><view class="create-sheet" catchtap="stopModal" aria-role="dialog" aria-label="新增申请"><view class="sheet-handle" aria-hidden="true"></view><view class="sheet-head"><view><text class="sheet-title">新增申请</text><text class="sheet-subtitle">先记录事实，再逐步完善材料与进度</text></view><view class="sheet-close" bindtap="closeCreate" aria-role="button" aria-label="关闭新增申请"><text aria-hidden="true">×</text></view></view>
    <view class="field"><text class="field-label">公司名称 *</text><input class="field-input" value="{{createForm.company}}" data-field="company" bindinput="onCreateInput" placeholder="例如 Microsoft" maxlength="120" aria-label="公司名称，必填" /></view><view class="field"><text class="field-label">岗位名称 *</text><input class="field-input" value="{{createForm.jobTitle}}" data-field="jobTitle" bindinput="onCreateInput" placeholder="例如 SDE Intern" maxlength="160" aria-label="岗位名称，必填" /></view>
    <view class="form-row"><view class="field"><text class="field-label">城市 / 地区</text><input class="field-input" value="{{createForm.city}}" data-field="city" bindinput="onCreateInput" placeholder="例如 Seattle" maxlength="120" aria-label="城市或地区" /></view><view class="field"><text class="field-label">申请截止</text><picker mode="date" value="{{createForm.deadline}}" bindchange="onDeadlineChange" aria-label="选择申请截止日期"><view class="field-input picker-value {{createForm.deadline?'':'placeholder'}}">{{createForm.deadline || '选择日期'}}</view></picker></view></view>
    <view class="field"><text class="field-label">下一步行动</text><input class="field-input" value="{{createForm.nextAction}}" data-field="nextAction" bindinput="onCreateInput" placeholder="例如：周五前完成定制简历" maxlength="300" aria-label="下一步行动" /></view><text class="sheet-tip">正式投递仍由你亲自完成，职引只记录与辅助准备。</text><view class="sheet-actions"><view class="secondary-button" bindtap="closeCreate" aria-role="button" aria-label="取消新增申请">取消</view><view class="primary-button {{creating?'disabled':''}}" bindtap="submitCreate" aria-role="button" aria-label="{{creating?'正在保存申请':'加入求职进度'}}" aria-disabled="{{creating}}">{{creating?'正在保存…':'加入求职进度'}}</view></view></view></view>
  <c-login-popup show="{{authPromptVisible}}" subtitle="{{authPromptSubtitle}}" bindclose="closeAuthPrompt" bindsuccess="onAuthPromptSuccess" />
  <view class="bottom-spacer"></view>
</view>
