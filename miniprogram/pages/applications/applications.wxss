page { min-height: 100%; background: var(--zy-bg); }
.progress-page { min-height: 100vh; box-sizing: border-box; padding: 34rpx 28rpx 0; color: var(--zy-ink); background: radial-gradient(circle at 90% 0, rgba(19,138,104,.07), transparent 28%), var(--zy-bg); }
.page-head { display: flex; align-items: flex-start; justify-content: space-between; padding: 18rpx 4rpx 28rpx; }
.page-head > view:first-child { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.page-kicker,.section-eyebrow { color: var(--zy-brand); font-size: 24rpx; font-weight: 800; letter-spacing: 3rpx; line-height: 32rpx; }
.page-title { margin-top: 8rpx; color: var(--zy-ink); font-size: 52rpx; font-weight: 850; letter-spacing: -2rpx; line-height: 1.18; }
.page-sub { margin-top: 12rpx; color: var(--zy-muted); font-size: 27rpx; line-height: 1.55; }
.add-button { display: flex; align-items: center; justify-content: center; flex: none; min-width: 126rpx; min-height: 88rpx; margin-top: 16rpx; border: 1rpx solid var(--zy-line); border-radius: 999rpx; color: #fff; background: var(--zy-ink); font-size: 25rpx; font-weight: 740; transition: opacity 180ms ease; }
.add-line { position: relative; width: 26rpx; height: 26rpx; margin-right: 8rpx; }
.add-line::before,.add-line::after { position: absolute; top: 12rpx; left: 3rpx; width: 20rpx; height: 2rpx; background: currentColor; content: ''; }
.add-line::after { transform: rotate(90deg); }
.press,.row-press { opacity: .72; }

.focus-section { margin-bottom: 28rpx; }
.section { margin-top: 34rpx; }.list-section { margin-top: 38rpx; }
.section-head { display: flex; align-items: flex-end; justify-content: space-between; margin: 0 4rpx 18rpx; }
.section-head > view:first-child { display: flex; flex-direction: column; }
.section-title { margin-top: 3rpx; color: var(--zy-ink); font-size: 34rpx; font-weight: 820; line-height: 44rpx; }
.section-count { color: var(--zy-muted); font-size: 24rpx; line-height: 36rpx; }
.focus-card { overflow: hidden; border-radius: var(--zy-radius-lg); color: #fff; background: linear-gradient(145deg, #172033 0%, #283a5e 72%, #315ee8 150%); box-shadow: 0 24rpx 58rpx rgba(20,31,55,.18); }
.focus-row { display: flex; align-items: center; min-height: 126rpx; padding: 20rpx 24rpx; border-bottom: 1rpx solid rgba(255,255,255,.1); transition: opacity 180ms ease; }
.focus-row:last-child { border-bottom: 0; }
.focus-badge { display: flex; align-items: center; justify-content: center; flex: none; min-width: 86rpx; min-height: 54rpx; margin-right: 18rpx; padding: 0 14rpx; border-radius: 999rpx; color: #dce6ff; background: rgba(255,255,255,.12); font-size: 24rpx; font-weight: 740; }
.focus-row .row-title { color: #fff; }.focus-row .row-desc { color: rgba(255,255,255,.66); }.focus-row .row-arrow { color: rgba(255,255,255,.65); }

.summary-card { margin-bottom: 34rpx; padding: 30rpx 24rpx 24rpx; border: 1rpx solid var(--zy-line); border-radius: var(--zy-radius-lg); background: #fff; box-shadow: var(--zy-shadow-card); }
.summary-head { display: flex; align-items: flex-start; justify-content: space-between; padding: 0 6rpx 24rpx; }
.summary-head > view { display: flex; align-items: baseline; }
.summary-number { color: var(--zy-ink); font-size: 54rpx; font-weight: 880; line-height: 60rpx; }
.summary-label { margin-left: 12rpx; color: var(--zy-ink-2); font-size: 26rpx; font-weight: 680; }
.summary-state { padding: 9rpx 15rpx; border-radius: 999rpx; color: var(--zy-muted); background: var(--zy-surface-soft); font-size: 24rpx; line-height: 30rpx; }
.funnel { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10rpx; }
.funnel-item { display: flex; align-items: center; justify-content: center; min-width: 0; min-height: 104rpx; flex-direction: column; border-radius: 20rpx; background: var(--zy-surface-soft); }
.funnel-count { color: var(--zy-ink); font-size: 32rpx; font-weight: 820; line-height: 38rpx; }
.funnel-label { max-width: 100%; margin-top: 4rpx; overflow: hidden; color: var(--zy-muted); font-size: 24rpx; line-height: 30rpx; text-overflow: ellipsis; white-space: nowrap; }

.notice-card { display: flex; align-items: center; min-height: 88rpx; margin-bottom: 18rpx; padding: 0 22rpx; border-radius: 20rpx; color: var(--zy-ink-2); background: #fff8e9; font-size: 25rpx; line-height: 1.5; }
.notice-dot { flex: none; width: 10rpx; height: 10rpx; margin-right: 12rpx; border-radius: 50%; background: var(--zy-warning); }
.filter-scroll { width: calc(100% + 56rpx); margin-left: -28rpx; }
.filter-row { display: flex; gap: 10rpx; padding: 0 28rpx 18rpx; }
.filter { display: flex; align-items: center; justify-content: center; flex: none; min-height: 88rpx; padding: 0 22rpx; border: 1rpx solid var(--zy-line); border-radius: 999rpx; color: var(--zy-ink-2); background: #fff; font-size: 25rpx; font-weight: 660; transition: background-color 180ms ease, color 180ms ease; }
.filter.active { border-color: var(--zy-ink); color: #fff; background: var(--zy-ink); }
.filter-count { margin-left: 8rpx; opacity: .7; }

.application-list { display: flex; flex-direction: column; gap: 16rpx; }
.application-card { padding: 26rpx; border: 1rpx solid var(--zy-line); border-radius: var(--zy-radius-md); background: #fff; box-shadow: 0 12rpx 34rpx rgba(20,31,55,.055); transition: opacity 180ms ease; }
.card-top { display: flex; align-items: center; }
.company-mark { display: flex; align-items: center; justify-content: center; flex: none; width: 76rpx; height: 76rpx; margin-right: 18rpx; border-radius: 23rpx; color: #fff; background: var(--zy-ink); font-size: 28rpx; font-weight: 820; }
.tone-success { background: var(--zy-success); }.tone-warning { background: var(--zy-warning); }.tone-danger { background: var(--zy-danger); }
.row-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.row-title,.job-title { overflow: hidden; color: var(--zy-ink); font-size: 29rpx; font-weight: 780; line-height: 38rpx; text-overflow: ellipsis; white-space: nowrap; }
.row-desc,.company { margin-top: 4rpx; overflow: hidden; color: var(--zy-muted); font-size: 25rpx; line-height: 34rpx; text-overflow: ellipsis; white-space: nowrap; }
.row-arrow { flex: none; margin-left: 14rpx; font-size: 34rpx; }
.status { flex: none; margin-left: 14rpx; padding: 9rpx 15rpx; border-radius: 999rpx; color: var(--zy-brand-deep); background: var(--zy-brand-soft); font-size: 24rpx; font-weight: 720; }
.status-success { color: var(--zy-success); background: var(--zy-success-soft); }.status-warning { color: var(--zy-warning); background: var(--zy-warning-soft); }.status-danger { color: var(--zy-danger); background: var(--zy-danger-soft); }
.next-action { display: flex; align-items: center; min-height: 76rpx; margin-top: 20rpx; padding: 8rpx 16rpx; border-radius: 18rpx; background: var(--zy-surface-soft); }
.next-label { flex: none; margin-right: 16rpx; color: var(--zy-muted); font-size: 24rpx; }
.next-text { overflow: hidden; color: var(--zy-ink-2); font-size: 25rpx; font-weight: 660; text-overflow: ellipsis; white-space: nowrap; }
.card-meta { display: flex; align-items: center; justify-content: space-between; margin-top: 18rpx; }
.meta-copy { display: flex; flex: 1; min-width: 0; flex-wrap: wrap; gap: 8rpx; }
.meta-pill { padding: 7rpx 13rpx; border-radius: 999rpx; color: var(--zy-muted); background: #f2f4f7; font-size: 24rpx; line-height: 30rpx; }
.meta-pill.interview { color: var(--zy-brand-deep); background: var(--zy-brand-soft); }
.status-button { display: flex; align-items: center; justify-content: center; flex: none; min-width: 150rpx; min-height: 88rpx; margin: 0 0 0 12rpx; padding: 0 16rpx; border: 0; border-radius: 999rpx; color: var(--zy-ink); background: #eef1f5; font-size: 24rpx; font-weight: 720; line-height: 88rpx; }
.status-button::after { border: 0; }

.state-card { display: flex; align-items: center; justify-content: center; min-height: 320rpx; flex-direction: column; padding: 38rpx; border: 1rpx solid var(--zy-line); border-radius: var(--zy-radius-lg); background: #fff; box-shadow: var(--zy-shadow-card); text-align: center; }
.state-card.compact { min-height: 160rpx; }.state-card.empty-state { min-height: 300rpx; }
.state-mark { display: flex; align-items: center; justify-content: center; width: 82rpx; height: 82rpx; margin-bottom: 22rpx; border-radius: 26rpx; background: var(--zy-brand-soft); }
.state-mark text { width: 24rpx; height: 24rpx; border: 4rpx solid var(--zy-brand); border-radius: 50%; }
.state-mark.error { background: var(--zy-danger-soft); }.state-mark.error text { border-color: var(--zy-danger); }.state-mark.add text { border-radius: 4rpx; }
.state-title { color: var(--zy-ink); font-size: 32rpx; font-weight: 820; line-height: 42rpx; }
.state-desc { max-width: 520rpx; margin-top: 10rpx; color: var(--zy-muted); font-size: 25rpx; line-height: 1.6; }
.spinner { width: 34rpx; height: 34rpx; margin-bottom: 16rpx; border: 4rpx solid var(--zy-line); border-top-color: var(--zy-brand); border-radius: 50%; }
.empty-actions,.sheet-actions { display: flex; width: 100%; gap: 14rpx; margin-top: 28rpx; }
.primary-button, .secondary-button { display: flex; align-items: center; justify-content: center; flex: 1; min-height: 88rpx; padding: 0 24rpx; border-radius: 999rpx; font-size: 26rpx; font-weight: 760; }
.primary-button { color: #fff; background: var(--zy-ink); }.secondary-button { color: var(--zy-ink); background: #eef1f5; }.primary-button.small { min-width: 180rpx; }.primary-button.disabled { opacity: .5; }

.modal-mask { position: fixed; inset: 0; z-index: 12000; background: rgba(9,14,25,.5); }
.create-sheet { position: fixed; right: 0; bottom: 0; left: 0; z-index: 12001; max-height: 88vh; box-sizing: border-box; padding: 12rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); overflow-y: auto; border-radius: 38rpx 38rpx 0 0; background: #fff; }
.sheet-handle { width: 74rpx; height: 8rpx; margin: 0 auto 18rpx; border-radius: 999rpx; background: #d8dde6; }
.sheet-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.sheet-head > view:first-child { display: flex; flex-direction: column; }
.sheet-title { color: var(--zy-ink); font-size: 38rpx; font-weight: 850; line-height: 48rpx; }.sheet-subtitle { margin-top: 4rpx; color: var(--zy-muted); font-size: 24rpx; line-height: 34rpx; }
.sheet-close { display: flex; align-items: center; justify-content: center; width: 88rpx; min-height: 88rpx; color: var(--zy-muted); font-size: 36rpx; }
.field { display: flex; flex: 1; min-width: 0; flex-direction: column; margin-bottom: 18rpx; }.form-row { display: flex; gap: 14rpx; }
.field-label { margin: 0 0 9rpx 4rpx; color: var(--zy-ink-2); font-size: 25rpx; font-weight: 700; }
.field-input { min-height: 88rpx; box-sizing: border-box; padding: 0 20rpx; border: 1rpx solid var(--zy-line); border-radius: 18rpx; color: var(--zy-ink); background: var(--zy-surface-soft); font-size: 27rpx; line-height: 88rpx; }
.picker-value { display: flex; align-items: center; }.placeholder { color: #929bad; }.sheet-tip { display: block; color: var(--zy-muted); font-size: 24rpx; line-height: 1.55; }
.bottom-spacer { height: 230rpx; height: calc(230rpx + env(safe-area-inset-bottom)); }

@media (prefers-reduced-motion: reduce) {
  .add-button,.focus-row,.filter,.application-card { transition: none; }
}
