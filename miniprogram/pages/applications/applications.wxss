page { min-height: 100%; background: #f3f6fb; color: #14213d; }
view, text, input, button { box-sizing: border-box; }
.progress-page { min-height: 100vh; padding: 30rpx 28rpx calc(190rpx + env(safe-area-inset-bottom)); overflow-x: hidden; }
.page-head, .summary-head, .section-head, .card-top, .card-meta, .sheet-head, .sheet-actions, .empty-actions, .form-row { display: flex; align-items: center; }
.page-head, .summary-head, .section-head, .sheet-head { justify-content: space-between; }
.page-kicker, .page-title, .page-sub, .section-title, .section-sub, .summary-number, .state-title, .state-desc, .row-title, .row-desc, .job-title, .company, .next-label, .next-text, .sheet-title, .sheet-subtitle, .field-label { display: block; }
.page-kicker { color: #2b5ce6; font-size: 24rpx; font-weight: 700; letter-spacing: 2rpx; }
.page-title { margin-top: 7rpx; font-size: 42rpx; font-weight: 750; }
.page-sub { margin-top: 8rpx; color: #667085; font-size: 26rpx; }
.add-button { display: flex; align-items: center; justify-content: center; gap: 9rpx; min-width: 132rpx; min-height: 88rpx; border-radius: 20rpx; color: #fff; background: #2556c7; font-size: 24rpx; font-weight: 700; }
.add-line { position: relative; width: 24rpx; height: 3rpx; border-radius: 3rpx; background: #fff; }
.add-line::after { content: ''; position: absolute; left: 10rpx; top: -10rpx; width: 3rpx; height: 24rpx; background: #fff; }
.summary-card, .focus-card, .application-card, .state-card, .notice-card { border: 1rpx solid #e3e9f2; border-radius: 26rpx; background: #fff; }
.summary-card { margin-top: 28rpx; padding: 26rpx; }
.summary-number { display: inline; color: #173b8f; font-size: 48rpx; font-weight: 760; }
.summary-label { color: #475467; font-size: 26rpx; }
.summary-state, .section-count { color: #2b5ce6; font-size: 24rpx; }
.funnel { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 16rpx; margin-top: 24rpx; }
.funnel-top { display: flex; justify-content: space-between; color: #667085; font-size: 24rpx; }
.funnel-track { height: 10rpx; margin-top: 10rpx; overflow: hidden; border-radius: 999rpx; background: #edf1f6; }
.funnel-fill { height: 100%; min-width: 8%; border-radius: inherit; background: #2b5ce6; }
.funnel-applied { background: #635bdb; }.funnel-interview { background: #b66a00; }.funnel-offer { background: #178b69; }
.notice-card { display: flex; align-items: center; gap: 12rpx; margin-top: 16rpx; padding: 18rpx 22rpx; color: #526175; font-size: 24rpx; }
.notice-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #2b5ce6; }
.section-head { min-height: 92rpx; padding: 32rpx 4rpx 16rpx; }
.section-title { font-size: 30rpx; font-weight: 730; }
.section-sub { margin-top: 6rpx; color: #667085; font-size: 24rpx; }
.focus-row { display: flex; align-items: center; gap: 16rpx; min-height: 108rpx; padding: 18rpx 22rpx; border-bottom: 1rpx solid #edf0f5; }
.focus-row:last-child { border-bottom: 0; }
.focus-badge { flex: 0 0 auto; padding: 9rpx 13rpx; border-radius: 12rpx; color: #1f54bd; background: #eef4ff; font-size: 24rpx; }
.focus-badge.interview { color: #8a5100; background: #fff4de; }.focus-badge.danger { color: #b42318; background: #fff0ee; }
.row-copy { flex: 1; min-width: 0; }
.row-title, .job-title { overflow: hidden; font-size: 28rpx; font-weight: 680; text-overflow: ellipsis; white-space: nowrap; }
.row-desc, .company { margin-top: 6rpx; overflow: hidden; color: #667085; font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
.row-arrow { color: #98a2b3; font-size: 38rpx; }
.filter-scroll { width: 100%; white-space: nowrap; }
.filter-row { display: inline-flex; gap: 12rpx; padding: 0 2rpx 18rpx; }
.filter { display: inline-flex; align-items: center; justify-content: center; gap: 10rpx; min-height: 88rpx; padding: 0 20rpx; border: 1rpx solid #dfe5ee; border-radius: 999rpx; color: #596579; background: #fff; font-size: 24rpx; }
.filter.active { border-color: #2b5ce6; color: #1f54bd; background: #eef4ff; font-weight: 700; }
.filter-count { color: #667085; }.filter.active .filter-count { color: #1f54bd; }
.application-list { display: flex; flex-direction: column; gap: 16rpx; }
.application-card { padding: 22rpx; }
.company-mark { display: flex; align-items: center; justify-content: center; flex: 0 0 auto; width: 76rpx; height: 76rpx; margin-right: 16rpx; border-radius: 22rpx; color: #173b8f; background: #eaf0ff; font-size: 26rpx; font-weight: 750; }
.tone-orange { color: #8a5100; background: #fff4de; }.tone-green { color: #087a55; background: #e9f8f2; }.tone-gray { color: #667085; background: #f0f2f5; }
.status { flex: 0 0 auto; margin-left: 12rpx; padding: 8rpx 12rpx; border-radius: 999rpx; color: #1f54bd; background: #eef4ff; font-size: 24rpx; }
.status-orange { color: #8a5100; background: #fff4de; }.status-green { color: #087a55; background: #e9f8f2; }.status-gray { color: #667085; background: #f0f2f5; }
.next-action { margin-top: 20rpx; padding: 18rpx; border-radius: 18rpx; background: #f6f8fc; }
.next-label { color: #667085; font-size: 24rpx; }.next-text { margin-top: 5rpx; font-size: 26rpx; font-weight: 650; }
.card-meta { flex-wrap: wrap; gap: 10rpx; margin-top: 16rpx; }
.meta-pill { padding: 8rpx 12rpx; border-radius: 999rpx; color: #667085; background: #f1f3f7; font-size: 24rpx; }
.meta-pill.warning, .meta-pill.interview { color: #8a5100; background: #fff4de; }.meta-pill.danger { color: #b42318; background: #fff0ee; }
.status-button { min-height: 88rpx; margin: 0 0 0 auto; padding: 0 20rpx; border-radius: 16rpx; color: #2556c7; background: #eef4ff; font-size: 24rpx; }
.status-button::after { border: 0; }
.state-card { margin-top: 24rpx; padding: 48rpx 28rpx; text-align: center; }
.state-card.compact { display: flex; align-items: center; justify-content: center; gap: 16rpx; padding: 28rpx; }
.state-mark { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; margin: 0 auto 18rpx; border-radius: 22rpx; background: #eef4ff; }
.state-mark text { width: 28rpx; height: 4rpx; border-radius: 4rpx; background: #2b5ce6; }.state-mark.error text { background: #b42318; }
.state-title { font-size: 28rpx; font-weight: 720; }.state-desc { max-width: 560rpx; margin: 10rpx auto 0; color: #667085; font-size: 24rpx; line-height: 1.6; }
.spinner { width: 30rpx; height: 30rpx; border: 4rpx solid #dbe5f8; border-top-color: #2b5ce6; border-radius: 50%; animation: spin .8s linear 3; }
.primary-button, .secondary-button { display: flex; align-items: center; justify-content: center; min-height: 88rpx; padding: 0 28rpx; border-radius: 20rpx; font-size: 24rpx; font-weight: 700; }
.primary-button { max-width: 360rpx; margin: 24rpx auto 0; color: #fff; background: #2556c7; }.primary-button.small { margin: 0; }
.secondary-button { border: 1rpx solid #dfe5ee; color: #475467; background: #fff; }
.empty-actions { justify-content: center; gap: 14rpx; margin-top: 24rpx; }.press, .row-press { opacity: .78; }.row-press { background: #f7f9fd; }
.modal-mask { position: fixed; inset: 0; z-index: 1000; display: flex; align-items: flex-end; background: rgba(15,23,42,.46); }
.create-sheet { width: 100%; max-height: 90vh; padding: 16rpx 28rpx calc(30rpx + env(safe-area-inset-bottom)); overflow-y: auto; border-radius: 32rpx 32rpx 0 0; background: #fff; }
.sheet-handle { width: 72rpx; height: 8rpx; margin: 0 auto 20rpx; border-radius: 999rpx; background: #d0d5dd; }
.sheet-title { font-size: 32rpx; font-weight: 740; }.sheet-subtitle { margin-top: 5rpx; color: #667085; font-size: 24rpx; }
.sheet-close { display: flex; align-items: center; justify-content: center; width: 88rpx; min-width: 88rpx; height: 88rpx; min-height: 88rpx; color: #667085; font-size: 42rpx; }
.field { flex: 1; min-width: 0; margin-top: 20rpx; }.form-row { gap: 14rpx; align-items: flex-start; }
.field-label { margin-bottom: 9rpx; color: #475467; font-size: 24rpx; }
.field-input { width: 100%; min-height: 88rpx; padding: 0 20rpx; border: 1rpx solid #dfe5ee; border-radius: 18rpx; background: #f8faff; font-size: 24rpx; }
.picker-value { display: flex; align-items: center; }.placeholder { color: #667085; }
.sheet-tip { display: block; margin-top: 20rpx; color: #667085; font-size: 24rpx; line-height: 1.55; }
.sheet-actions { justify-content: flex-end; gap: 14rpx; margin-top: 24rpx; }.sheet-actions .primary-button { margin: 0; }.disabled { opacity: .55; }
@keyframes spin { to { transform: rotate(360deg); } }
@media (max-width: 340px) { .progress-page { padding-left: 22rpx; padding-right: 22rpx; }.funnel { gap: 9rpx; }.funnel-top { font-size: 24rpx; }.form-row { display: block; } }

/* Preserve the richer pre-simplification hierarchy. */
page { background: radial-gradient(circle at 92% -6%, rgba(105,133,255,.17), transparent 33%), linear-gradient(180deg,#fbfdff,#f3f7fd 58%,#f8fafc); }
.add-button,.primary-button { background: linear-gradient(135deg,#2b5ce6,#5b55df); box-shadow: 0 12rpx 28rpx rgba(43,92,230,.22); }
.summary-card { border-color: rgba(182,203,235,.76); background: radial-gradient(circle at 100% 0,rgba(111,143,255,.13),transparent 38%),linear-gradient(145deg,#fff,#f3f7ff); box-shadow: 0 20rpx 46rpx rgba(37,68,112,.105),inset 0 1rpx 0 rgba(255,255,255,.96); }
.focus-card,.application-card,.state-card,.notice-card { border-color: rgba(190,208,232,.72); background: linear-gradient(145deg,rgba(255,255,255,.99),rgba(247,250,255,.98)); box-shadow: 0 14rpx 34rpx rgba(36,58,92,.075),inset 0 1rpx 0 rgba(255,255,255,.95); }
.application-card { border-radius: 28rpx; }
.company-mark,.state-mark { background: linear-gradient(145deg,#eef5ff,#e4ecff); box-shadow: 0 9rpx 20rpx rgba(43,92,230,.08); }
.next-action { border: 1rpx solid rgba(213,223,239,.72); background: linear-gradient(135deg,#f7f9fd,#f1f5fc); }
.filter { border-color: rgba(197,211,231,.82); box-shadow: 0 7rpx 18rpx rgba(36,58,92,.04); }
.filter.active { border-color: rgba(76,112,224,.48); background: linear-gradient(135deg,#eef4ff,#e8edff); box-shadow: 0 8rpx 20rpx rgba(43,92,230,.09); }
