<view class="resource-page" style="padding-top: {{pageTop}}px;">
  <view class="resource-head"><text class="resource-title">资源中心</text><text class="resource-subtitle">找题库、面经和公司内容，为当前申请做准备</text></view>
  <scroll-view class="category-scroll" scroll-x enhanced show-scrollbar="{{false}}"><view class="category-row"><view wx:for="{{categories}}" wx:key="id" class="category-chip {{activeCategory === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectCategory">{{item.title}}</view></view></scroll-view>
  <view class="filter-card" wx:if="{{activeCategory !== 'favorites' && activeCategory !== 'purchased'}}">
    <input class="search-input" value="{{keyword}}" placeholder="搜索资源内容" bindinput="onKeyword" />
    <view class="filter-row"><input class="filter-input" value="{{company}}" placeholder="公司，如 Amazon" bindinput="onCompany" /><input class="filter-input" value="{{role}}" placeholder="岗位，如 Data" bindinput="onRole" /></view>
    <scroll-view wx:if="{{activeCategory === 'written' || activeCategory === 'interview'}}" class="type-scroll" scroll-x show-scrollbar="{{false}}"><view class="type-row"><view wx:for="{{questionTypes}}" wx:key="id" class="type-chip {{questionType === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectQuestionType">{{item.title}}</view></view></scroll-view>
  </view>
  <view class="asset-list" wx:if="{{assets.length}}"><view wx:for="{{assets}}" wx:key="id" class="asset-card" data-id="{{item.id}}" bindtap="openAsset" hover-class="card-hover"><view class="asset-main"><text class="asset-title">{{item.title}}</text><text class="asset-desc">{{item.desc}}</text><view class="tag-row"><text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="asset-tag">{{tag}}</text></view></view><text class="asset-arrow">›</text></view></view>
  <view class="empty-card" wx:else><text class="empty-title">{{emptyTitle}}</text><text class="empty-desc">{{emptyDesc}}</text><view wx:if="{{activeCategory !== 'purchased'}}" class="clear-btn" bindtap="clearFilters">清除筛选</view></view>
  <view class="note-card"><text class="note-title">关于资料权益</text><text class="note-desc">资料购买与交付能力尚未接入。本页不会模拟订单、价格、权益或“已购”记录。</text></view>
  <view class="bottom-spacer"></view>
</view>
