<view class="resource-page" style="padding-top: {{navTop}}px">
  <view class="resource-hero">
    <view class="search-card search-row">
      <image class="search-icon" src="/images/zhiyin-icons/search-muted.svg" mode="aspectFit" aria-hidden="true"/>
      <input class="search-input" value="{{keyword}}" placeholder="搜索题库、面经或公司资料" placeholder-class="placeholder" bindinput="onKeyword" aria-label="搜索求职准备资源"/>
    </view>
  </view>

  <view class="context-card" wx:if="{{company || role}}" aria-label="目标上下文">
    <view class="context-icon"><image src="/images/zhiyin-icons/target.svg" mode="aspectFit" aria-hidden="true"/></view>
    <view class="context-copy">
      <text class="context-label">当前目标</text>
      <text class="context-value">{{company || '公司待确认'}}{{company && role ? ' · ' : ''}}{{role || ''}}</text>
      <text class="context-note">目标上下文不代表搜索筛选结果或已绑定申请。</text>
    </view>
  </view>

  <view class="featured-section" wx:if="{{!keyword}}">
    <view class="section-head"><view><text class="section-title">精选资源</text></view></view>
    <view class="feature-grid">
      <view wx:for="{{featuredAssets}}" wx:key="id" class="feature-card feature-{{item.tone}}" data-id="{{item.id}}" bindtap="openAsset" hover-class="row-press" aria-role="button" aria-label="打开{{item.title}}；适用阶段：{{item.stage}}">
        <view class="feature-icon"><image src="{{item.icon}}" mode="aspectFit" aria-hidden="true"/></view>
        <text class="feature-title">{{item.title}}</text>
        <image class="feature-arrow" src="/images/zhiyin-icons/chevron.svg" mode="aspectFit" aria-hidden="true"/>
      </view>
    </view>
  </view>

  <view class="content-section">
    <view class="section-head"><view><text class="section-title">{{sectionTitle}}</text></view></view>
    <view class="asset-list" wx:if="{{listAssets.length}}">
      <view wx:for="{{listAssets}}" wx:key="id" class="asset-card" data-id="{{item.id}}" bindtap="openAsset" hover-class="row-press" aria-role="button" aria-label="打开{{item.title}}；适用阶段：{{item.stage}}">
        <view class="asset-mark asset-{{item.tone}}"><image src="{{item.icon}}" mode="aspectFit" aria-hidden="true"/></view>
        <view class="asset-copy"><text class="asset-title">{{item.title}}</text><text class="asset-stage">适用阶段：{{item.stage}}</text></view>
        <image class="asset-arrow" src="/images/zhiyin-icons/chevron.svg" mode="aspectFit" aria-hidden="true"/>
      </view>
    </view>
    <view class="empty-card" wx:else>
      <view class="empty-icon"><image src="/images/zhiyin-icons/search-blue.svg" mode="aspectFit" aria-hidden="true"/></view>
      <text class="empty-title">{{emptyTitle}}</text>
      <text class="empty-desc">{{emptyDesc}}</text>
      <view class="clear-button" bindtap="clearFilters" hover-class="chip-press" aria-role="button" aria-label="清除资源筛选">清除筛选</view>
    </view>
    <view class="unavailable-card" wx:if="{{!keyword}}" aria-role="button" aria-disabled="true" aria-label="我的已购，资料购买与交付能力尚未接入">
      <view class="asset-mark asset-unavailable"><image src="/images/zhiyin-icons/bookmark.svg" mode="aspectFit" aria-hidden="true"/></view>
      <view class="asset-copy"><text class="asset-title">我的已购</text><text class="asset-stage">资料购买与交付能力尚未接入</text></view>
      <text class="unavailable-badge">未开放</text>
    </view>
  </view>

  <view class="bottom-spacer"></view>
</view>
