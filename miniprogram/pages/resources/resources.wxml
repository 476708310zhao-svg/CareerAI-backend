<view class="resource-page">
  <view class="page-head"><text class="page-kicker">资源中心</text><text class="page-title">求职准备资源</text><text class="page-sub">按准备阶段进入真实可用的题库、面经、日历和公司内容</text></view>
  <view class="context-card" wx:if="{{company || role}}" aria-label="目标上下文"><text class="context-label">目标上下文</text><text class="context-value">{{company || '公司待确认'}}{{company && role ? ' · ' : ''}}{{role || ''}}</text><text class="context-note">仅用于带入后续页面，不代表搜索筛选结果或已绑定申请。</text></view>
  <view class="search-card" wx:if="{{activeCategory!=='favorites'}}"><view class="search-row"><view class="search-symbol"><text></text></view><input class="search-input" value="{{keyword}}" placeholder="搜索标题、标签或内容说明" placeholder-class="placeholder" bindinput="onKeyword" aria-label="搜索求职准备资源" /></view></view>
  <scroll-view class="category-scroll" scroll-x enhanced show-scrollbar="{{false}}"><view class="category-row"><block wx:for="{{categories}}" wx:key="id"><view wx:if="{{item.disabled}}" class="category-chip disabled" aria-role="button" aria-disabled="true" aria-label="{{item.title}}，暂未开放"><text>{{item.title}}</text><text class="disabled-badge">未开放</text></view><view wx:else class="category-chip {{activeCategory===item.id?'active':''}}" data-id="{{item.id}}" bindtap="selectCategory" hover-class="press" aria-role="button" aria-label="查看{{item.title}}" aria-selected="{{activeCategory===item.id}}">{{item.title}}</view></block></view></scroll-view>
  <scroll-view wx:if="{{activeCategory==='written'||activeCategory==='interview'}}" class="type-scroll" scroll-x show-scrollbar="{{false}}"><view class="type-row"><view wx:for="{{questionTypes}}" wx:key="id" class="type-chip {{questionType===item.id?'active':''}}" data-id="{{item.id}}" bindtap="selectQuestionType" hover-class="press" aria-role="button" aria-label="按{{item.title}}查看" aria-selected="{{questionType===item.id}}">{{item.title}}</view></view></scroll-view>
  <view class="section-head"><view><text class="section-title">{{activeCategory==='favorites'?'真实收藏':'可用能力'}}</text><text class="section-sub">列表只包含当前版本已经接入的能力</text></view><text class="section-count">{{assets.length}} 项</text></view>
  <view class="asset-list" wx:if="{{assets.length}}"><view wx:for="{{assets}}" wx:key="id" class="asset-card" data-id="{{item.id}}" bindtap="openAsset" hover-class="row-press" aria-role="button" aria-label="打开{{item.title}}；适用阶段：{{item.stage}}；作用：{{item.action}}"><view class="asset-mark tone-{{index%3}}"><text>{{item.mark}}</text></view><view class="asset-copy"><text class="asset-title">{{item.title}}</text><text class="asset-stage">适用阶段 · {{item.stage}}</text><text class="asset-desc">{{item.action}}</text><view class="tag-row"><text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="asset-tag">{{tag}}</text></view></view><text class="asset-arrow">›</text></view></view>
  <view class="empty-card" wx:else><view class="empty-mark"><text></text></view><text class="empty-title">{{emptyTitle}}</text><text class="empty-desc">{{emptyDesc}}</text><view class="clear-button" bindtap="clearFilters" hover-class="press" aria-role="button" aria-label="清除资源筛选">清除筛选</view></view>
  <view class="truth-card"><text class="truth-label">关于资料权益</text><text class="truth-title">只展示真实可用的内容</text><text class="truth-desc">资料购买与交付能力尚未接入。本页不会模拟订单、价格、权益或已购记录。</text></view>
  <view class="bottom-spacer"></view>
</view>
