page { min-height: 100%; background: var(--zy-bg); }
.resource-page { min-height: 100vh; box-sizing: border-box; padding: 28rpx 28rpx 0; color: var(--zy-ink); background: radial-gradient(circle at 86% 2%, rgba(103,200,255,.12), transparent 29%), var(--zy-bg); }
.resource-hero { margin-bottom: 24rpx; padding-top: 20rpx; }
.page-head { display: flex; flex-direction: column; padding: 6rpx 4rpx 24rpx; }
.page-kicker,.section-eyebrow { color: #9eb5ff; font-size: 24rpx; font-weight: 800; letter-spacing: 3rpx; line-height: 32rpx; }
.page-title { color: var(--zy-ink); font-size: 50rpx; font-weight: 850; letter-spacing: -2rpx; line-height: 1.18; }
.page-sub { max-width: 590rpx; margin-top: 12rpx; color: var(--zy-muted); font-size: 27rpx; line-height: 1.55; }
.search-card { padding: 6rpx; border: 1rpx solid var(--zy-line); border-radius: 26rpx; background: rgba(255,255,255,.96); box-shadow: var(--zy-shadow-card); }
.search-row { display: flex; align-items: center; min-height: 92rpx; padding: 0 14rpx; border-radius: 21rpx; background: rgba(255,255,255,.96); }
.search-symbol { position: relative; flex: none; width: 42rpx; height: 42rpx; margin-right: 8rpx; }
.search-symbol text { position: absolute; top: 7rpx; left: 6rpx; width: 19rpx; height: 19rpx; border: 3rpx solid #738097; border-radius: 50%; }
.search-symbol text::after { position: absolute; right: -10rpx; bottom: -7rpx; width: 14rpx; height: 3rpx; background: #738097; transform: rotate(45deg); content: ''; }
.search-input { flex: 1; min-width: 0; min-height: 88rpx; color: var(--zy-ink); font-size: 28rpx; line-height: 88rpx; }
.placeholder { color: #8c95a6; }

.context-card { display: flex; flex-direction: column; margin-bottom: 20rpx; padding: 22rpx 24rpx; border: 1rpx solid #dce4fb; border-radius: var(--zy-radius-md); background: #f3f6ff; }
.context-label { color: var(--zy-brand); font-size: 24rpx; font-weight: 780; line-height: 32rpx; }.context-value { margin-top: 5rpx; color: var(--zy-ink); font-size: 29rpx; font-weight: 780; line-height: 38rpx; }.context-note { margin-top: 7rpx; color: var(--zy-muted); font-size: 24rpx; line-height: 1.5; }
.category-scroll,.type-scroll { width: calc(100% + 56rpx); margin-left: -28rpx; }
.category-row,.type-row { display: flex; gap: 10rpx; padding: 0 28rpx 16rpx; }
.category-chip, .type-chip { display: flex; align-items: center; justify-content: center; flex: none; min-height: 88rpx; box-sizing: border-box; padding: 0 24rpx; border: 1rpx solid var(--zy-line); border-radius: 999rpx; color: var(--zy-ink-2); background: #fff; font-size: 25rpx; font-weight: 680; transition: background-color 180ms ease, color 180ms ease; }
.category-chip.active,.type-chip.active { border-color: #d7e2fb; color: var(--zy-brand); background: var(--zy-brand-soft); }
.category-chip.disabled { color: #8d96a5; background: #eceff3; }
.disabled-badge { margin-left: 8rpx; color: #8d96a5; font-size: 24rpx; }
.type-chip { min-height: 72rpx; background: var(--zy-surface-soft); }
.press,.row-press { opacity: .72; }

.section-head { display: flex; align-items: flex-end; justify-content: space-between; margin: 18rpx 4rpx 18rpx; }
.section-head > view:first-child { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.section-eyebrow { color: var(--zy-brand); }
.section-title { margin-top: 3rpx; color: var(--zy-ink); font-size: 34rpx; font-weight: 820; line-height: 44rpx; }
.section-sub { margin-top: 3rpx; color: var(--zy-muted); font-size: 24rpx; line-height: 34rpx; }
.section-count { flex: none; color: var(--zy-muted); font-size: 24rpx; line-height: 36rpx; }

.asset-list { display: flex; flex-direction: column; gap: 16rpx; }
.asset-card { display: flex; align-items: center; min-height: 146rpx; padding: 22rpx; border: 1rpx solid var(--zy-line); border-radius: var(--zy-radius-md); background: rgba(255,255,255,.96); box-shadow: 0 12rpx 34rpx rgba(49,94,232,.045); transition: opacity 180ms ease; }
.asset-mark { display: flex; align-items: center; justify-content: center; flex: none; width: 82rpx; height: 82rpx; margin-right: 20rpx; border: 1rpx solid #dce6f8; border-radius: 50%; color: var(--zy-brand); background: var(--zy-brand-soft); font-size: 29rpx; font-weight: 820; }
.asset-mark.tone-1,.asset-mark.tone-2 { color: var(--zy-brand); background: var(--zy-brand-soft); }
.asset-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.asset-title-row { display: flex; align-items: center; min-width: 0; }
.asset-title { flex: 1; overflow: hidden; color: var(--zy-ink); font-size: 29rpx; font-weight: 790; line-height: 38rpx; text-overflow: ellipsis; white-space: nowrap; }
.asset-stage { flex: none; max-width: 210rpx; margin-left: 12rpx; padding: 5rpx 11rpx; overflow: hidden; border-radius: 999rpx; color: var(--zy-brand-deep); background: var(--zy-brand-soft); font-size: 24rpx; font-weight: 680; text-overflow: ellipsis; white-space: nowrap; }
.asset-desc { margin-top: 6rpx; overflow: hidden; color: var(--zy-muted); font-size: 25rpx; line-height: 34rpx; text-overflow: ellipsis; white-space: nowrap; }
.tag-row { display: flex; gap: 8rpx; margin-top: 10rpx; overflow: hidden; }
.asset-tag { flex: none; padding: 5rpx 11rpx; border-radius: 999rpx; color: var(--zy-muted); background: #f2f4f7; font-size: 24rpx; line-height: 28rpx; }
.asset-arrow { flex: none; width: 34rpx; margin-left: 8rpx; color: #98a2b3; font-size: 36rpx; text-align: right; }

.empty-card { display: flex; align-items: center; justify-content: center; min-height: 320rpx; flex-direction: column; padding: 36rpx; border: 1rpx solid var(--zy-line); border-radius: var(--zy-radius-lg); background: #fff; text-align: center; }
.empty-mark { display: flex; align-items: center; justify-content: center; width: 82rpx; height: 82rpx; margin-bottom: 22rpx; border-radius: 26rpx; background: var(--zy-brand-soft); }
.empty-mark text { width: 24rpx; height: 24rpx; border: 4rpx solid var(--zy-brand); border-radius: 50%; }
.empty-title { color: var(--zy-ink); font-size: 32rpx; font-weight: 820; line-height: 42rpx; }.empty-desc { max-width: 520rpx; margin-top: 9rpx; color: var(--zy-muted); font-size: 25rpx; line-height: 1.6; }
.clear-button { display: flex; align-items: center; justify-content: center; min-width: 180rpx; min-height: 88rpx; margin-top: 24rpx; padding: 0 24rpx; border-radius: 999rpx; color: #fff; background: var(--zy-brand); font-size: 26rpx; font-weight: 760; }
.truth-card { display: flex; align-items: center; justify-content: center; margin-top: 28rpx; padding: 20rpx 24rpx; color: var(--zy-muted); text-align: center; }
.truth-label { flex: none; margin-right: 12rpx; color: var(--zy-brand); font-size: 24rpx; font-weight: 760; }.truth-desc { font-size: 24rpx; line-height: 1.55; }
.bottom-spacer { height: 230rpx; height: calc(230rpx + env(safe-area-inset-bottom)); }

@media (prefers-reduced-motion: reduce) {
  .category-chip,.type-chip,.asset-card { transition: none; }
}
