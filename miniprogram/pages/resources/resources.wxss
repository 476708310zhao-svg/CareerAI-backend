page { min-height: 100%; background: #f4f8ff; color: #101a34; }
.resource-page { min-height: 100vh; box-sizing: border-box; padding-right: 16rpx; padding-left: 16rpx; background: radial-gradient(circle at 84% 5%,rgba(90,174,255,.11),transparent 30%),linear-gradient(180deg,#f7faff 0%,#f2f7ff 100%); font-family: -apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif; }

.resource-hero { min-height: 96rpx; }
.search-card,.search-row { display: flex; align-items: center; min-height: 88rpx; box-sizing: border-box; padding: 0 22rpx; border: 1rpx solid #dbe5f6; border-radius: 25rpx; background: rgba(255,255,255,.97); box-shadow: 0 8rpx 24rpx rgba(60,101,175,.045); }
.search-row { min-height: 88rpx; }
.search-icon { display: block; flex: none; width: 36rpx; height: 36rpx; margin-right: 12rpx; }
.search-input { flex: 1; min-width: 0; min-height: 88rpx; color: #17213a; font-size: 26rpx; line-height: 36rpx; }
.placeholder { color: #667085; }

.context-card { display: flex; align-items: center; min-height: 104rpx; box-sizing: border-box; margin-top: 14rpx; padding: 10rpx 18rpx 10rpx 12rpx; border: 1rpx solid #dce8fb; border-radius: 24rpx; background: #edf4ff; }
.context-icon { display: flex; align-items: center; justify-content: center; flex: none; width: 72rpx; height: 72rpx; margin-right: 12rpx; border-radius: 20rpx; background: #fff; }
.context-icon image { display: block; width: 36rpx; height: 36rpx; }
.context-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.context-label { color: #65799e; font-size: 24rpx; line-height: 32rpx; }
.context-value { overflow: hidden; color: #1e3767; font-size: 26rpx; font-weight: 650; line-height: 36rpx; text-overflow: ellipsis; white-space: nowrap; }
.context-note { display: none; }

.featured-section { margin-top: 20rpx; }
.content-section { margin-top: 20rpx; }
.section-head { display: flex; align-items: center; justify-content: space-between; min-height: 48rpx; margin: 0 4rpx 12rpx; }
.section-head > view { display: flex; min-width: 0; flex-direction: column; }
.section-title { display: block; }
.section-title { color: #101a34; font-size: 31rpx; font-weight: 700; letter-spacing: -.3rpx; line-height: 42rpx; }

.feature-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.feature-card { position: relative; display: flex; align-items: center; flex: 0 0 calc(50% - 6rpx); min-width: 0; min-height: 108rpx; box-sizing: border-box; overflow: hidden; padding: 12rpx; border: 1rpx solid #e0e8f6; border-radius: 22rpx; background: #fff; box-shadow: 0 10rpx 28rpx rgba(61,102,176,.045); transition: opacity 160ms ease; }
.feature-card::after { position: absolute; top: -42rpx; right: -38rpx; width: 120rpx; height: 120rpx; border-radius: 50%; background: rgba(93,145,255,.07); content: ''; }
.feature-violet::after { background: rgba(135,106,255,.07); }
.feature-cyan::after { background: rgba(48,176,206,.075); }
.feature-icon { display: flex; align-items: center; justify-content: center; flex: none; width: 52rpx; height: 52rpx; border-radius: 16rpx; background: #edf4ff; }
.feature-violet .feature-icon { background: #f1efff; }
.feature-cyan .feature-icon { background: #eaf8fb; }
.feature-indigo .feature-icon { background: #eef0ff; }
.feature-icon image { display: block; width: 30rpx; height: 30rpx; }
.feature-title { flex: 1; min-width: 0; margin-left: 10rpx; overflow: hidden; color: #17213a; font-size: 25rpx; font-weight: 650; line-height: 36rpx; text-overflow: ellipsis; white-space: nowrap; }
.feature-arrow { display: block; flex: none; width: 22rpx; height: 22rpx; margin-left: 4rpx; opacity: .74; }

.asset-list { overflow: hidden; border: 1rpx solid #e1e9f6; border-radius: 28rpx; background: rgba(255,255,255,.98); box-shadow: 0 12rpx 34rpx rgba(61,102,176,.05); }
.asset-card { display: flex; align-items: center; min-height: 116rpx; box-sizing: border-box; margin: 0 20rpx; padding: 12rpx 0; border-bottom: 1rpx solid #e6ecf5; transition: opacity 160ms ease; }
.asset-card:last-child { border-bottom: 0; }
.asset-mark { display: flex; align-items: center; justify-content: center; flex: 0 0 72rpx; width: 72rpx; height: 72rpx; border-radius: 20rpx; background: #edf4ff; }
.asset-mark image { display: block; width: 36rpx; height: 36rpx; }
.asset-violet { background: #f1efff; }
.asset-cyan { background: #eaf8fb; }
.asset-indigo { background: #eef0ff; }
.asset-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; margin-left: 18rpx; }
.asset-title { overflow: hidden; color: #17213a; font-size: 28rpx; font-weight: 650; line-height: 38rpx; text-overflow: ellipsis; white-space: nowrap; }
.asset-stage { margin-top: 4rpx; overflow: hidden; color: #41679f; font-size: 24rpx; line-height: 32rpx; text-overflow: ellipsis; white-space: nowrap; }
.asset-arrow { display: block; flex: none; width: 30rpx; height: 30rpx; margin-left: 8rpx; opacity: .7; }
.unavailable-card { display: flex; align-items: center; min-height: 104rpx; box-sizing: border-box; margin-top: 12rpx; padding: 12rpx 20rpx; border: 1rpx solid #e1e9f6; border-radius: 24rpx; color: #8392aa; background: rgba(255,255,255,.74); }
.asset-unavailable { background: #f1f4f9; }
.asset-unavailable image { opacity: .48; }
.unavailable-card .asset-title,.unavailable-card .asset-stage { color: #8392aa; }
.unavailable-badge { flex: none; margin-left: 8rpx; padding: 5rpx 10rpx; border-radius: 10rpx; color: #8392aa; background: #edf1f6; font-size: 24rpx; line-height: 30rpx; }

.empty-card { display: flex; align-items: center; justify-content: center; min-height: 310rpx; box-sizing: border-box; flex-direction: column; padding: 36rpx 24rpx; border: 1rpx solid #e1e9f6; border-radius: 28rpx; background: rgba(255,255,255,.94); text-align: center; }
.empty-icon { display: flex; align-items: center; justify-content: center; width: 80rpx; height: 80rpx; border-radius: 24rpx; background: #edf4ff; }
.empty-icon image { display: block; width: 38rpx; height: 38rpx; }
.empty-title,.empty-desc { display: block; }
.empty-title { margin-top: 18rpx; color: #26334f; font-size: 28rpx; font-weight: 650; line-height: 38rpx; }
.empty-desc { margin-top: 6rpx; color: #7484a1; font-size: 24rpx; line-height: 34rpx; }
.clear-button { display: flex; align-items: center; justify-content: center; min-width: 176rpx; min-height: 88rpx; box-sizing: border-box; margin-top: 22rpx; padding: 0 28rpx; border-radius: 22rpx; color: #245fdc; background: #e6efff; font-size: 25rpx; font-weight: 600; transition: opacity 160ms ease; }

.bottom-spacer { height: 176rpx; height: calc(176rpx + env(safe-area-inset-bottom)); }

/* 旧模板缓存中的说明节点保持隐藏，避免以无样式文本散落。 */
.section-sub,
.feature-desc,
.asset-desc,
.truth-card,
.truth-label,
.truth-desc { display: none !important; }

.row-press,.chip-press { opacity: .68; }
@media (prefers-reduced-motion: reduce) { .feature-card,.asset-card,.clear-button { transition: none; } }
