page { min-height: 100%; background: #f3f6fb; color: #14213d; }
view, text, input { box-sizing: border-box; }
.resource-page { min-height: 100vh; padding: 30rpx 28rpx calc(190rpx + env(safe-area-inset-bottom)); overflow-x: hidden; }
.page-kicker, .page-title, .page-sub, .section-title, .section-sub, .asset-title, .asset-stage, .asset-desc, .empty-title, .empty-desc, .truth-label, .truth-title, .truth-desc, .context-label, .context-value, .context-note { display: block; }
.page-head { padding: 4rpx 4rpx 24rpx; }
.page-kicker { color: #2b5ce6; font-size: 24rpx; font-weight: 700; letter-spacing: 2rpx; }
.page-title { margin-top: 8rpx; font-size: 42rpx; font-weight: 750; }
.page-sub { margin-top: 10rpx; color: #667085; font-size: 26rpx; line-height: 1.55; }
.search-card, .context-card, .asset-card, .empty-card, .truth-card { border: 1rpx solid #e3e9f2; border-radius: 26rpx; background: #fff; }
.context-card { margin-bottom: 16rpx; padding: 22rpx; }
.context-label { color: #2b5ce6; font-size: 24rpx; font-weight: 700; }
.context-value { margin-top: 8rpx; font-size: 28rpx; font-weight: 700; }
.context-note { margin-top: 8rpx; color: #667085; font-size: 24rpx; line-height: 1.5; }
.search-card { padding: 18rpx; }
.search-row { display: flex; align-items: center; min-height: 88rpx; padding: 0 18rpx; border-radius: 20rpx; background: #f4f7fb; }
.search-symbol { position: relative; flex: 0 0 auto; width: 34rpx; height: 34rpx; margin-right: 14rpx; border: 3rpx solid #667085; border-radius: 50%; }
.search-symbol::after { content: ''; position: absolute; right: -7rpx; bottom: -4rpx; width: 12rpx; height: 3rpx; transform: rotate(45deg); background: #667085; }
.search-input { flex: 1; min-width: 0; min-height: 88rpx; font-size: 26rpx; }
.placeholder { color: #667085; }
.category-scroll, .type-scroll { width: 100%; white-space: nowrap; }
.category-row, .type-row { display: inline-flex; gap: 12rpx; padding: 20rpx 2rpx 4rpx; }
.category-chip, .type-chip { display: inline-flex; align-items: center; justify-content: center; gap: 8rpx; min-height: 88rpx; padding: 0 22rpx; border: 1rpx solid #dfe5ee; border-radius: 999rpx; color: #596579; background: #fff; font-size: 24rpx; }
.category-chip.active, .type-chip.active { border-color: #2b5ce6; color: #1f54bd; background: #eef4ff; font-weight: 700; }
.category-chip.disabled { color: #667085; background: #f2f4f7; opacity: .72; }
.disabled-badge { padding: 4rpx 8rpx; border-radius: 999rpx; color: #667085; background: #fff; font-size: 24rpx; }
.type-row { padding-top: 12rpx; }
.section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20rpx; min-height: 104rpx; padding: 30rpx 4rpx 16rpx; }
.section-title { font-size: 30rpx; font-weight: 730; }
.section-sub { margin-top: 6rpx; color: #667085; font-size: 24rpx; }
.section-count { color: #2b5ce6; font-size: 24rpx; }
.asset-list { display: flex; flex-direction: column; gap: 16rpx; }
.asset-card { display: flex; align-items: center; gap: 18rpx; min-height: 176rpx; padding: 22rpx; }
.asset-mark { display: flex; align-items: center; justify-content: center; flex: 0 0 auto; width: 76rpx; height: 76rpx; border-radius: 22rpx; color: #173b8f; background: #eaf0ff; font-size: 26rpx; font-weight: 750; }
.asset-mark.tone-1 { color: #087a55; background: #e9f8f2; }
.asset-mark.tone-2 { color: #8a5100; background: #fff4de; }
.asset-copy { flex: 1; min-width: 0; }
.asset-title { font-size: 28rpx; font-weight: 700; }
.asset-stage { margin-top: 7rpx; color: #475467; font-size: 24rpx; font-weight: 650; }
.asset-desc { display: -webkit-box; margin-top: 6rpx; overflow: hidden; color: #667085; font-size: 24rpx; line-height: 1.5; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.tag-row { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 12rpx; }
.asset-tag { padding: 7rpx 12rpx; border-radius: 999rpx; color: #596579; background: #f1f4f8; font-size: 24rpx; }
.asset-arrow { flex: 0 0 auto; color: #98a2b3; font-size: 38rpx; }
.row-press, .press { opacity: .76; background: #f7f9fd; }
.empty-card { padding: 48rpx 28rpx; text-align: center; }
.empty-mark { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; margin: 0 auto 18rpx; border-radius: 22rpx; background: #eef4ff; }
.empty-mark text { width: 28rpx; height: 4rpx; border-radius: 4rpx; background: #2b5ce6; }
.empty-title { font-size: 28rpx; font-weight: 720; }
.empty-desc { margin-top: 9rpx; color: #667085; font-size: 24rpx; line-height: 1.6; }
.clear-button { display: inline-flex; align-items: center; justify-content: center; min-width: 180rpx; min-height: 88rpx; margin-top: 22rpx; border: 1rpx solid #dfe5ee; border-radius: 20rpx; color: #2556c7; font-size: 24rpx; font-weight: 650; }
.truth-card { margin-top: 20rpx; padding: 24rpx; border-color: #dce5f4; background: #f8faff; }
.truth-label { color: #2b5ce6; font-size: 24rpx; font-weight: 700; }
.truth-title { margin-top: 7rpx; font-size: 28rpx; font-weight: 700; }
.truth-desc { margin-top: 7rpx; color: #667085; font-size: 24rpx; line-height: 1.55; }
.bottom-spacer { height: 16rpx; }
@media (max-width: 340px) { .resource-page { padding-left: 22rpx; padding-right: 22rpx; } }
