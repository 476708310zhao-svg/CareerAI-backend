page { min-height: 100%; background: #f5f7fb; }
.resource-page { min-height: 100vh; padding-left: 28rpx; padding-right: 28rpx; box-sizing: border-box; color: #17233d; }
.resource-head { padding: 0 4rpx 24rpx; }.resource-title { display: block; font-size: 42rpx; font-weight: 800; }.resource-subtitle { display: block; margin-top: 8rpx; color: #667085; font-size: 24rpx; line-height: 1.5; }
.category-scroll,.type-scroll { width: 100%; white-space: nowrap; }.category-row,.type-row { display: inline-flex; gap: 12rpx; padding: 2rpx 2rpx 18rpx; }.category-chip,.type-chip { padding: 14rpx 22rpx; border: 1rpx solid #dde4ef; border-radius: 999rpx; background: #fff; color: #596579; font-size: 23rpx; }.category-chip.active,.type-chip.active { border-color: #2f6bea; background: #edf3ff; color: #2459c7; font-weight: 700; }
.filter-card,.note-card,.empty-card { margin-top: 8rpx; padding: 22rpx; border: 1rpx solid #e3e9f2; border-radius: 24rpx; background: #fff; }.search-input,.filter-input { height: 76rpx; padding: 0 22rpx; box-sizing: border-box; border-radius: 18rpx; background: #f5f7fb; font-size: 25rpx; }.filter-row { display: flex; gap: 12rpx; margin-top: 12rpx; }.filter-input { flex: 1; min-width: 0; }.type-scroll { margin-top: 16rpx; }.type-row { padding-bottom: 0; }.type-chip { padding: 10rpx 18rpx; font-size: 22rpx; }
.asset-list { display: flex; flex-direction: column; gap: 16rpx; margin-top: 22rpx; }.asset-card { display: flex; align-items: center; gap: 18rpx; padding: 24rpx; border: 1rpx solid #e3e9f2; border-radius: 24rpx; background: #fff; }.asset-main { flex: 1; min-width: 0; }.asset-title { display: block; font-size: 29rpx; font-weight: 750; }.asset-desc { display: block; margin-top: 8rpx; color: #667085; font-size: 23rpx; line-height: 1.55; }.tag-row { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 14rpx; }.asset-tag { padding: 5rpx 12rpx; border-radius: 999rpx; background: #f0f4fa; color: #536177; font-size: 20rpx; }.asset-arrow { color: #8793a6; font-size: 40rpx; }.card-hover { opacity: .72; }
.empty-card { display: flex; flex-direction: column; align-items: center; padding: 54rpx 30rpx; text-align: center; }.empty-title,.note-title { display: block; font-size: 27rpx; font-weight: 750; }.empty-desc,.note-desc { display: block; margin-top: 10rpx; color: #667085; font-size: 23rpx; line-height: 1.6; }.clear-btn { margin-top: 22rpx; padding: 12rpx 24rpx; border-radius: 999rpx; background: #edf3ff; color: #2459c7; font-size: 23rpx; }.note-card { margin-top: 22rpx; background: #fffaf0; border-color: #f2e1b8; }.bottom-spacer { height: calc(180rpx + env(safe-area-inset-bottom)); }
