<view class="jobs-page" style="padding-top: {{navTop}}px">
  <view wx:if="{{!recruitmentEnabled}}" class="state-card"><text class="state-title">岗位服务暂未开放</text><text class="state-desc">你仍可使用资源中心，或查看校招日历中的公开信息。</text><view class="state-actions"><view class="primary-action" bindtap="openResources" aria-role="button" aria-label="打开资源中心">打开资源中心</view><view class="secondary-action" bindtap="openCampusWhileClosed" aria-role="button" aria-label="查看校招日历">校招日历</view></view></view>

  <block wx:else>
    <view class="search-line">
      <view class="search-box"><image class="search-symbol" src="/images/zhiyin-icons/search-muted.svg" mode="aspectFit" aria-hidden="true"/><input class="search-input" placeholder="搜索岗位、公司或关键词" placeholder-class="placeholder" value="{{searchKeyword}}" confirm-type="search" bindconfirm="searchJobs" aria-label="搜索岗位、公司或关键词"/><view class="clear-button" wx:if="{{searchKeyword}}" catchtap="clearSearch" aria-role="button" aria-label="清除搜索"><image src="/images/zhiyin-icons/close.svg" mode="aspectFit" aria-hidden="true"/></view></view>
      <view class="filter-button {{filterActive ? 'active' : ''}}" bindtap="openFilter" aria-role="button" aria-label="筛选岗位" aria-pressed="{{filterActive}}"><image class="filter-symbol" src="/images/zhiyin-icons/filter.svg" mode="aspectFit" aria-hidden="true"/><text>筛选</text></view>
    </view>
    <view class="campus-entry" bindtap="goCampusCalendar" hover-class="press" aria-role="button" aria-label="打开校招日历"><view class="campus-mark"><image src="/images/zhiyin-icons/calendar.svg" mode="aspectFit" aria-hidden="true"/></view><view class="campus-copy"><text class="campus-title">校招日历</text></view><text class="campus-action">查看</text><image class="campus-arrow" src="/images/zhiyin-icons/chevron.svg" mode="aspectFit" aria-hidden="true"/></view>

    <view wx:if="{{isMockData}}" class="source-notice">网络暂时不可用，当前展示本地备用职位。</view>
    <view wx:if="{{matchMode && !matchKeywords.length}}" class="profile-notice"><view><text class="notice-title">补全目标后排序更准确</text><text class="notice-desc">当前没有可验证的目标关键词。</text></view><view class="notice-action" bindtap="goToProfile" aria-role="button" aria-label="完善求职目标">去完善</view></view>
    <view wx:if="{{loadError && !loading}}" class="state-card"><text class="state-title">岗位加载失败</text><text class="state-desc">{{loadError}}</text><view class="primary-action" bindtap="retryJobs" aria-role="button" aria-label="重新加载岗位">重新加载</view></view>
    <view wx:elif="{{!loading && !loadError && jobs.length===0}}" class="state-card"><text class="state-title">暂无相关职位</text><text class="state-desc">换个关键词或调整筛选条件后再试。</text><view class="secondary-action" bindtap="resetFilter" aria-role="button" aria-label="清除岗位筛选">清除筛选</view></view>
    <view wx:else class="job-list">
      <view wx:if="{{jobs.length}}" class="job-list-head"><text class="job-list-title">岗位机会</text><text class="job-list-count">已显示 {{jobs.length}} 个{{filterActive ? ' · 已筛选' : ''}}</text></view>
      <c-job-card wx:for="{{jobs}}" wx:key="id" job="{{item}}" item-index="{{index}}" compact="{{true}}" show-match="{{matchMode || index===0}}" show-queue="{{true}}" queue-busy="{{queueingJobId === '' + item.id}}" bind:open="navigateToDetail" bind:favorite="toggleSave" bind:queue="addToQueue"/>
      <view wx:if="{{loading && !jobs.length}}" class="skeleton-list"><view wx:for="{{skeletonRows}}" wx:key="*this" wx:if="{{index < 3}}" class="skeleton-card"><view class="skeleton-logo shimmer"></view><view class="skeleton-copy"><view class="skeleton-title shimmer"></view><view class="skeleton-line shimmer"></view></view></view></view>
      <text wx:if="{{loading && jobs.length}}" class="list-tip">正在加载更多…</text><text wx:if="{{!hasMore && jobs.length}}" class="list-tip">已显示全部结果</text>
    </view>

    <page-container show="{{filterVisible}}" round position="bottom" custom-style="height:auto;background:#fff;border-radius:32rpx 32rpx 0 0;" bind:clickoverlay="closeFilter"><view class="filter-panel"><view class="panel-head"><text class="panel-title">筛选岗位</text><view class="panel-close" bindtap="closeFilter" aria-role="button" aria-label="关闭筛选"><image src="/images/zhiyin-icons/close.svg" mode="aspectFit" aria-hidden="true"/></view></view>
      <text class="filter-label">工作类型</text><view class="filter-chips"><view class="filter-chip {{filterType==='FULLTIME'?'active':''}}" bindtap="onFilterTypeSelect" data-val="FULLTIME" aria-role="button" aria-label="筛选全职">全职</view><view class="filter-chip {{filterType==='PARTTIME'?'active':''}}" bindtap="onFilterTypeSelect" data-val="PARTTIME" aria-role="button" aria-label="筛选兼职">兼职</view><view class="filter-chip {{filterType==='CONTRACTOR'?'active':''}}" bindtap="onFilterTypeSelect" data-val="CONTRACTOR" aria-role="button" aria-label="筛选合同工">合同工</view><view class="filter-chip {{filterType==='INTERN'?'active':''}}" bindtap="onFilterTypeSelect" data-val="INTERN" aria-role="button" aria-label="筛选实习">实习</view></view>
      <text class="filter-label">发布时间</text><view class="filter-chips"><view class="filter-chip {{filterDate==='today'?'active':''}}" bindtap="onFilterDateSelect" data-val="today" aria-role="button" aria-label="筛选今天发布">今天</view><view class="filter-chip {{filterDate==='week'?'active':''}}" bindtap="onFilterDateSelect" data-val="week" aria-role="button" aria-label="筛选近三天发布">近 3 天</view><view class="filter-chip {{filterDate==='month'?'active':''}}" bindtap="onFilterDateSelect" data-val="month" aria-role="button" aria-label="筛选近一个月发布">近一个月</view></view>
      <text class="filter-label">地区</text><view class="filter-chips"><view class="filter-chip {{filterCountry==='global'?'active':''}}" bindtap="onFilterCountrySelect" data-val="global" aria-role="button" aria-label="筛选全球岗位">全球</view><view class="filter-chip {{filterCountry==='us'?'active':''}}" bindtap="onFilterCountrySelect" data-val="us" aria-role="button" aria-label="筛选美国岗位">美国</view><view class="filter-chip {{filterCountry==='ca'?'active':''}}" bindtap="onFilterCountrySelect" data-val="ca" aria-role="button" aria-label="筛选加拿大岗位">加拿大</view><view class="filter-chip {{filterCountry==='gb'?'active':''}}" bindtap="onFilterCountrySelect" data-val="gb" aria-role="button" aria-label="筛选英国岗位">英国</view><view class="filter-chip {{filterCountry==='au'?'active':''}}" bindtap="onFilterCountrySelect" data-val="au" aria-role="button" aria-label="筛选澳大利亚岗位">澳大利亚</view><view class="filter-chip {{filterCountry==='sg'?'active':''}}" bindtap="onFilterCountrySelect" data-val="sg" aria-role="button" aria-label="筛选新加坡岗位">新加坡</view></view>
      <view class="country-more-row"><picker wx:if="{{countryList.length}}" mode="selector" range="{{countryList}}" range-key="name" bindchange="onCountryPickerChange"><view class="country-more-link">更多国家/地区 ›</view></picker><input class="country-code-input" value="{{countryCodeInput}}" placeholder="或输入两位国家代码" maxlength="2" bindinput="onCountryCodeInput" bindconfirm="onCountryCodeConfirm" confirm-type="done" aria-label="输入两位国家代码"/><view class="country-code-apply" bindtap="onCountryCodeConfirm" aria-role="button" aria-label="确认国家代码">确定</view></view>
      <text wx:if="{{filterCountry!=='global'}}" class="country-selected">当前选择：{{filterCountry}}</text>
      <text class="filter-label">工作资格（因地区而异）</text><view class="filter-chips"><view class="filter-chip {{filterSponsor==='international'?'active':''}}" bindtap="onFilterSponsorSelect" data-val="international" aria-role="button" aria-label="筛选国际生友好岗位">国际生友好</view><view class="filter-chip {{filterSponsor==='excludeCitizen'?'active':''}}" bindtap="onFilterSponsorSelect" data-val="excludeCitizen" aria-role="button" aria-label="筛选不限公民身份岗位">不限公民身份</view><view class="filter-chip {{filterSponsor==='h1b'?'active':''}}" bindtap="onFilterSponsorSelect" data-val="h1b" aria-role="button" aria-label="筛选美国 H-1B 支持岗位">美国 H-1B</view></view>
      <view class="panel-actions"><view class="secondary-action" bindtap="resetFilter" aria-role="button" aria-label="重置岗位筛选">重置</view><view class="primary-action" bindtap="applyFilter" aria-role="button" aria-label="应用筛选并查看结果">查看结果</view></view>
    </view></page-container>
  </block>
  <c-login-popup show="{{authPromptVisible}}" subtitle="{{authPromptSubtitle}}" bindclose="closeAuthPrompt" bindsuccess="onAuthPromptSuccess"/>
  <view class="safe-tail"></view>
</view>
