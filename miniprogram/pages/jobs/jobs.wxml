<view class="jobs-page">
  <view class="jobs-head"><text class="jobs-kicker">机会发现</text><text class="jobs-title">找岗位</text><text class="jobs-sub">搜索真实岗位，判断后再加入求职进度</text></view>
  <view wx:if="{{!recruitmentEnabled}}" class="closed-card"><view class="closed-mark"><text></text></view><text class="closed-title">岗位服务暂未开放</text><text class="closed-desc">岗位列表当前由运营开关暂停。你仍可使用资源中心，或查看校招日历中的公开信息。</text><view class="closed-actions"><button class="primary-action" bindtap="openResources" aria-label="打开资源中心">打开资源中心</button><button class="secondary-action" bindtap="openCampusWhileClosed" aria-label="查看校招日历">查看校招日历</button></view></view>
  <block wx:else>
    <view class="search-card">
      <view class="search-line"><view class="search-box"><view class="search-symbol" aria-hidden="true"><text></text></view><input class="search-input" placeholder="搜索岗位、公司或关键词" placeholder-class="placeholder" value="{{searchKeyword}}" confirm-type="search" bindconfirm="searchJobs" aria-label="搜索岗位、公司或关键词" /><view class="clear-button" wx:if="{{searchKeyword}}" catchtap="clearSearch" aria-role="button" aria-label="清除搜索"><text aria-hidden="true">×</text></view></view><view class="filter-button {{filterActive ? 'active' : ''}}" bindtap="openFilter" hover-class="press" aria-role="button" aria-label="筛选岗位" aria-pressed="{{filterActive}}"><text class="filter-lines" aria-hidden="true"></text><text>筛选</text></view></view>
      <scroll-view class="chip-scroll" scroll-x enhanced show-scrollbar="{{false}}"><view class="chip-row"><view wx:for="{{hotPositions}}" wx:key="*this" class="quick-chip {{activeTag===item?'active':''}}" bindtap="onQuickSearch" data-value="{{item}}" aria-role="button" aria-label="搜索{{item}}" aria-selected="{{activeTag===item}}">{{item}}</view></view></scroll-view>
      <view class="history" wx:if="{{searchHistory.length && !searchKeyword}}"><text class="history-label">最近搜索</text><scroll-view class="history-scroll" scroll-x show-scrollbar="{{false}}"><view class="history-row"><view wx:for="{{searchHistory}}" wx:key="*this" class="history-chip" bindtap="onHistoryTap" data-kw="{{item}}" aria-role="button" aria-label="再次搜索{{item}}">{{item}}</view></view></scroll-view><view class="history-clear" catchtap="clearHistory" aria-role="button" aria-label="清空搜索历史">清空</view></view>
    </view>
    <view class="control-row"><view><text class="result-title">{{searchKeyword || (matchMode ? '按目标排序' : '全部岗位')}}</text><text class="result-sub">{{loading && !jobs.length ? '正在获取岗位…' : (totalJobs || jobs.length) + ' 个可浏览机会'}}</text></view><view class="match-button {{matchMode?'active':''}}" bindtap="toggleMatchMode" hover-class="press" aria-role="button" aria-label="{{matchMode?'关闭按目标排序':'开启按目标排序'}}" aria-pressed="{{matchMode}}"><text class="match-dot" aria-hidden="true"></text><text>{{matchMode?'按目标排序中':'按目标排序'}}</text></view></view>
    <view wx:if="{{isMockData}}" class="source-notice">网络暂时不可用，当前仅展示明确标注的本地备用职位。</view>
    <view wx:if="{{matchMode && !matchKeywords.length}}" class="profile-notice"><view><text class="notice-title">补全目标后排序更准确</text><text class="notice-desc">当前没有可验证的目标关键词，只保留岗位原始信息。</text></view><view class="notice-action" bindtap="goToProfile" aria-role="button" aria-label="完善求职目标">去完善</view></view>
    <view wx:if="{{loadError && !loading}}" class="state-card"><text class="state-title">岗位加载失败</text><text class="state-desc">{{loadError}}</text><button class="primary-action" bindtap="retryJobs" aria-label="重新加载岗位">重新加载</button></view>
    <view wx:elif="{{!loading && !loadError && jobs.length===0}}" class="state-card"><view class="empty-mark"><text></text></view><text class="state-title">暂无相关职位</text><text class="state-desc">换个关键词或调整筛选条件后再试。</text><view class="secondary-action inline" bindtap="resetFilter" aria-role="button" aria-label="清除岗位筛选">清除筛选</view></view>
    <view wx:else class="job-list">
      <c-job-card wx:for="{{jobs}}" wx:key="id" job="{{item}}" item-index="{{index}}" show-match="{{matchMode}}" show-queue="{{true}}" queue-busy="{{queueingJobId === '' + item.id}}" bind:open="navigateToDetail" bind:favorite="toggleSave" bind:queue="addToQueue" />
      <view wx:if="{{loading && !jobs.length}}" class="skeleton-list" aria-role="status" aria-label="正在加载岗位列表"><view wx:for="{{skeletonRows}}" wx:key="*this" class="skeleton-card"><view class="skeleton-title shimmer"></view><view class="skeleton-line shimmer"></view><view class="skeleton-line short shimmer"></view></view></view>
      <text wx:if="{{loading && jobs.length}}" class="list-tip">正在加载更多…</text><text wx:if="{{!hasMore && jobs.length}}" class="list-tip">已显示全部结果</text>
    </view>
    <view class="campus-entry" bindtap="goCampusCalendar" hover-class="press" aria-role="button" aria-label="打开校招日历"><view class="campus-mark">日</view><view class="campus-copy"><text class="campus-title">校招日历</text><text class="campus-desc">按批次查看公开校招信息与截止日期</text></view><text class="campus-arrow" aria-hidden="true">›</text></view>
    <page-container show="{{filterVisible}}" round position="bottom" custom-style="height:auto;background:#fff;border-radius:32rpx 32rpx 0 0;" bind:clickoverlay="closeFilter"><view class="filter-panel"><view class="panel-head"><text class="panel-title">筛选岗位</text><view class="panel-close" bindtap="closeFilter" aria-role="button" aria-label="关闭筛选"><text aria-hidden="true">×</text></view></view>
      <text class="filter-label">工作类型</text><view class="filter-chips"><view class="filter-chip {{filterType==='FULLTIME'?'active':''}}" bindtap="onFilterTypeSelect" data-val="FULLTIME" aria-role="button" aria-label="筛选全职" aria-selected="{{filterType==='FULLTIME'}}">全职</view><view class="filter-chip {{filterType==='PARTTIME'?'active':''}}" bindtap="onFilterTypeSelect" data-val="PARTTIME" aria-role="button" aria-label="筛选兼职" aria-selected="{{filterType==='PARTTIME'}}">兼职</view><view class="filter-chip {{filterType==='CONTRACTOR'?'active':''}}" bindtap="onFilterTypeSelect" data-val="CONTRACTOR" aria-role="button" aria-label="筛选合同工" aria-selected="{{filterType==='CONTRACTOR'}}">合同工</view><view class="filter-chip {{filterType==='INTERN'?'active':''}}" bindtap="onFilterTypeSelect" data-val="INTERN" aria-role="button" aria-label="筛选实习" aria-selected="{{filterType==='INTERN'}}">实习</view></view>
      <text class="filter-label">发布时间</text><view class="filter-chips"><view class="filter-chip {{filterDate==='today'?'active':''}}" bindtap="onFilterDateSelect" data-val="today" aria-role="button" aria-label="筛选今天发布" aria-selected="{{filterDate==='today'}}">今天</view><view class="filter-chip {{filterDate==='week'?'active':''}}" bindtap="onFilterDateSelect" data-val="week" aria-role="button" aria-label="筛选近三天发布" aria-selected="{{filterDate==='week'}}">近 3 天</view><view class="filter-chip {{filterDate==='month'?'active':''}}" bindtap="onFilterDateSelect" data-val="month" aria-role="button" aria-label="筛选近一个月发布" aria-selected="{{filterDate==='month'}}">近一个月</view></view>
      <text class="filter-label">国家 / 地区</text><scroll-view class="country-scroll" scroll-x show-scrollbar="{{false}}"><view class="filter-chips nowrap"><view wx:for="{{countryList}}" wx:key="code" class="filter-chip {{filterCountry===item.api?'active':''}}" bindtap="onFilterCountrySelect" data-val="{{item.api}}" aria-role="button" aria-label="筛选{{item.name}}" aria-selected="{{filterCountry===item.api}}">{{item.name}}</view></view></scroll-view>
      <text class="filter-label">留学生与 Sponsor</text><view class="filter-chips"><view class="filter-chip {{filterSponsor==='opt'?'active':''}}" bindtap="onFilterSponsorSelect" data-val="opt" aria-role="button" aria-label="筛选 OPT 友好" aria-selected="{{filterSponsor==='opt'}}">OPT 友好</view><view class="filter-chip {{filterSponsor==='stem'?'active':''}}" bindtap="onFilterSponsorSelect" data-val="stem" aria-role="button" aria-label="筛选 STEM OPT" aria-selected="{{filterSponsor==='stem'}}">STEM OPT</view><view class="filter-chip {{filterSponsor==='h1b'?'active':''}}" bindtap="onFilterSponsorSelect" data-val="h1b" aria-role="button" aria-label="筛选 H-1B Sponsor" aria-selected="{{filterSponsor==='h1b'}}">H-1B Sponsor</view><view class="filter-chip {{filterSponsor==='international'?'active':''}}" bindtap="onFilterSponsorSelect" data-val="international" aria-role="button" aria-label="筛选国际生友好" aria-selected="{{filterSponsor==='international'}}">国际生友好</view></view>
      <view class="panel-actions"><view class="secondary-action" bindtap="resetFilter" aria-role="button" aria-label="重置岗位筛选">重置</view><view class="primary-action" bindtap="applyFilter" aria-role="button" aria-label="应用筛选并查看结果">查看结果</view></view>
    </view></page-container>
  </block>
  <c-login-popup show="{{authPromptVisible}}" subtitle="{{authPromptSubtitle}}" bindclose="closeAuthPrompt" bindsuccess="onAuthPromptSuccess" />
  <view class="safe-tail"></view>
</view>
