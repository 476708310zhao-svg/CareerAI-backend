page { min-height:100%; background:#f3f6fb; color:#14213d; } view,text,input,button { box-sizing:border-box; }.jobs-page { min-height:100vh; padding:30rpx 28rpx calc(190rpx + env(safe-area-inset-bottom)); overflow-x:hidden; }.jobs-kicker,.jobs-title,.jobs-sub,.result-title,.result-sub,.state-title,.state-desc,.notice-title,.notice-desc,.campus-title,.campus-desc,.filter-label { display:block; }.jobs-kicker { color:#2b5ce6; font-size:24rpx; font-weight:700; letter-spacing:2rpx; }.jobs-title { margin-top:7rpx; font-size:42rpx; font-weight:750; }.jobs-sub { margin-top:8rpx; color:#667085; font-size:26rpx; }.search-card,.closed-card,.state-card,.profile-notice,.campus-entry,.source-notice { border:1rpx solid #e3e9f2; border-radius:26rpx; background:#fff; }.search-card { margin-top:26rpx; padding:18rpx; }.search-line { display:flex; gap:12rpx; }.search-box { display:flex; align-items:center; flex:1; min-width:0; min-height:88rpx; padding:0 18rpx; border-radius:20rpx; background:#f4f7fb; }.search-symbol { position:relative; flex:0 0 auto; width:34rpx; height:34rpx; margin-right:12rpx; border:3rpx solid #667085; border-radius:50%; }.search-symbol::after { content:''; position:absolute; right:-7rpx; bottom:-4rpx; width:12rpx; height:3rpx; transform:rotate(45deg); background:#667085; }.search-input { flex:1; min-width:0; min-height:88rpx; font-size:26rpx; }.placeholder { color:#667085; }.clear-button,.panel-close { display:flex; align-items:center; justify-content:center; min-width:88rpx; width:88rpx; min-height:88rpx; height:88rpx; color:#667085; font-size:36rpx; }.filter-button { display:flex; align-items:center; justify-content:center; flex:0 0 auto; gap:9rpx; min-width:128rpx; min-height:88rpx; border:1rpx solid #dfe5ee; border-radius:20rpx; color:#475467; font-size:24rpx; }.filter-button.active { border-color:#2b5ce6; color:#1f54bd; background:#eef4ff; }.filter-lines { position:relative; width:25rpx; height:3rpx; background:currentColor; }.filter-lines::before,.filter-lines::after { content:''; position:absolute; left:0; width:25rpx; height:3rpx; background:currentColor; }.filter-lines::before { top:-8rpx; width:18rpx; }.filter-lines::after { top:8rpx; width:12rpx; }.chip-scroll,.history-scroll,.country-scroll { width:100%; white-space:nowrap; }.chip-row,.history-row { display:inline-flex; gap:10rpx; padding-top:16rpx; }.quick-chip,.history-chip,.filter-chip { display:inline-flex; align-items:center; justify-content:center; min-height:88rpx; padding:0 20rpx; border:1rpx solid #dfe5ee; border-radius:999rpx; color:#596579; background:#fff; font-size:24rpx; }.quick-chip.active,.filter-chip.active { border-color:#2b5ce6; color:#1f54bd; background:#eef4ff; font-weight:700; }.history { display:flex; align-items:center; gap:12rpx; margin-top:12rpx; }.history-label { flex:0 0 auto; color:#667085; font-size:24rpx; }.history-scroll { flex:1; min-width:0; }.history-row { padding:0; }.history-chip { min-height:88rpx; padding:0 18rpx; background:#f7f8fb; }.history-clear { display:flex; align-items:center; justify-content:center; min-width:88rpx; min-height:88rpx; color:#2b5ce6; font-size:24rpx; }
.control-row { display:flex; align-items:center; justify-content:space-between; gap:20rpx; min-height:116rpx; padding:24rpx 4rpx 12rpx; }.result-title { max-width:420rpx; overflow:hidden; font-size:30rpx; font-weight:730; text-overflow:ellipsis; white-space:nowrap; }.result-sub { margin-top:5rpx; color:#667085; font-size:24rpx; }.match-button { display:flex; align-items:center; justify-content:center; gap:10rpx; min-width:188rpx; min-height:88rpx; border:1rpx solid #dfe5ee; border-radius:999rpx; color:#596579; background:#fff; font-size:24rpx; }.match-button.active { border-color:#b9d0ff; color:#1f54bd; background:#eef4ff; }.match-dot { width:13rpx; height:13rpx; border-radius:50%; background:#98a2b3; }.match-button.active .match-dot { background:#2b5ce6; box-shadow:0 0 0 6rpx rgba(43,92,230,.12); }.job-list { display:flex; flex-direction:column; gap:16rpx; }.source-notice { padding:18rpx 20rpx; color:#526175; background:#f8fafc; font-size:24rpx; line-height:1.5; }.profile-notice,.campus-entry { display:flex; align-items:center; gap:16rpx; margin-bottom:16rpx; padding:20rpx 22rpx; }.notice-title,.campus-title { font-size:26rpx; font-weight:680; }.notice-desc,.campus-desc { margin-top:5rpx; color:#667085; font-size:24rpx; line-height:1.45; }.notice-action { display:flex; align-items:center; justify-content:center; flex:0 0 auto; min-width:108rpx; min-height:88rpx; color:#2556c7; font-size:24rpx; }.campus-entry { min-height:112rpx; margin-top:24rpx; margin-bottom:0; }.campus-mark { display:flex; align-items:center; justify-content:center; width:70rpx; height:70rpx; border-radius:20rpx; color:#173b8f; background:#eaf0ff; font-size:24rpx; font-weight:750; }.campus-copy { flex:1; min-width:0; }.campus-arrow { color:#98a2b3; font-size:38rpx; }
.closed-card,.state-card { margin-top:26rpx; padding:50rpx 28rpx; text-align:center; }.closed-mark,.empty-mark { display:flex; align-items:center; justify-content:center; width:76rpx; height:76rpx; margin:0 auto 18rpx; border-radius:22rpx; background:#eef4ff; }.closed-mark text,.empty-mark text { width:28rpx; height:4rpx; border-radius:4rpx; background:#2b5ce6; }.closed-title,.state-title { display:block; font-size:29rpx; font-weight:730; }.closed-desc,.state-desc { display:block; max-width:560rpx; margin:10rpx auto 0; color:#667085; font-size:24rpx; line-height:1.6; }.closed-actions,.panel-actions { display:flex; justify-content:center; gap:14rpx; margin-top:26rpx; }.primary-action,.secondary-action { display:flex; align-items:center; justify-content:center; min-height:88rpx; margin:0; padding:0 26rpx; border-radius:20rpx; font-size:24rpx; font-weight:700; }.primary-action { color:#fff; background:#2556c7; }.secondary-action { border:1rpx solid #dfe5ee; color:#475467; background:#fff; }.primary-action::after,.secondary-action::after { border:0; }.secondary-action.inline { max-width:220rpx; margin:24rpx auto 0; }.press { opacity:.76; }
.skeleton-list { display:flex; flex-direction:column; gap:16rpx; }.skeleton-card { padding:26rpx; border:1rpx solid #e3e9f2; border-radius:26rpx; background:#fff; }.skeleton-title { width:58%; height:28rpx; border-radius:8rpx; }.skeleton-line { width:82%; height:20rpx; margin-top:20rpx; border-radius:8rpx; }.skeleton-line.short { width:44%; }.shimmer { background:linear-gradient(90deg,#edf1f6 20%,#f8fafc 50%,#edf1f6 80%); background-size:200% 100%; animation:shimmer 1.2s linear 3; }.list-tip { display:block; padding:22rpx; color:#667085; font-size:24rpx; text-align:center; }
.filter-panel { padding:18rpx 28rpx calc(30rpx + env(safe-area-inset-bottom)); }.panel-head { display:flex; align-items:center; justify-content:space-between; }.panel-title { font-size:32rpx; font-weight:740; }.filter-label { margin-top:24rpx; margin-bottom:13rpx; color:#344054; font-size:24rpx; font-weight:650; }.filter-chips { display:flex; flex-wrap:wrap; gap:12rpx; }.filter-chips.nowrap { display:inline-flex; flex-wrap:nowrap; padding-bottom:4rpx; }.filter-chip { min-height:88rpx; }.panel-actions .primary-action,.panel-actions .secondary-action { flex:1; }.safe-tail { height:10rpx; } @keyframes shimmer { to { background-position:-200% 0; } }
@media (max-width:340px) { .jobs-page { padding-left:22rpx; padding-right:22rpx; }.filter-button { min-width:110rpx; }.filter-button text:last-child { display:none; }.closed-actions { flex-direction:column; } }

/* Layered cards and floating controls from the established UI. */
page { background: radial-gradient(circle at 90% -6%, rgba(105,133,255,.16), transparent 32%), linear-gradient(180deg,#fbfdff,#f3f7fd 56%,#f8fafc); }
.search-card,.closed-card,.state-card,.profile-notice,.campus-entry,.source-notice { border-color: rgba(190,208,232,.7); background: linear-gradient(145deg,rgba(255,255,255,.99),rgba(247,250,255,.98)); box-shadow: 0 14rpx 34rpx rgba(36,58,92,.075), inset 0 1rpx 0 rgba(255,255,255,.95); }
.search-card { border-radius: 30rpx; box-shadow: 0 20rpx 46rpx rgba(37,68,112,.1), inset 0 1rpx 0 rgba(255,255,255,.96); }
.search-box { border: 1rpx solid rgba(205,217,235,.76); background: rgba(247,250,255,.96); }
.filter-button,.match-button { border-color: rgba(190,208,232,.82); background: rgba(255,255,255,.9); box-shadow: 0 8rpx 22rpx rgba(36,58,92,.055); }
.quick-chip,.history-chip,.filter-chip { border-color: rgba(197,211,231,.82); box-shadow: 0 7rpx 18rpx rgba(36,58,92,.04); }
.quick-chip.active,.filter-chip.active,.match-button.active { border-color: rgba(76,112,224,.48); background: linear-gradient(135deg,#eef4ff,#e8edff); box-shadow: 0 8rpx 20rpx rgba(43,92,230,.09); }
.primary-action { background: linear-gradient(135deg,#2b5ce6,#5d55df); box-shadow: 0 12rpx 28rpx rgba(43,92,230,.22); }
.campus-mark { background: linear-gradient(145deg,#eef5ff,#e4ecff); box-shadow: 0 9rpx 20rpx rgba(43,92,230,.1); }
