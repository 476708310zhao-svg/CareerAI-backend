page { min-height: 100%; background: #f3f6fb; color: #14213d; }
view, text, image { box-sizing: border-box; }
.zy-page { width: 100%; min-height: 100vh; padding: 30rpx 28rpx calc(190rpx + env(safe-area-inset-bottom)); overflow-x: hidden; }
.zy-home-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; padding: 8rpx 4rpx 28rpx; }.zy-home-copy,.zy-row-copy { flex: 1; min-width: 0; }
.zy-kicker,.zy-page-title,.zy-page-sub,.zy-section-title,.zy-section-sub,.zy-main-title,.zy-main-desc,.zy-row-title,.zy-row-desc,.zy-empty-title,.zy-empty-desc { display: block; }
.zy-kicker { color: #2b5ce6; font-size: 24rpx; font-weight: 700; letter-spacing: 2rpx; }.zy-page-title { margin-top: 8rpx; font-size: 42rpx; font-weight: 750; line-height: 1.25; }.zy-page-sub { max-width: 560rpx; margin-top: 10rpx; color: #667085; font-size: 26rpx; line-height: 1.55; }
.zy-avatar { flex: 0 0 auto; width: 76rpx; height: 76rpx; border: 4rpx solid #fff; border-radius: 24rpx; background: #e8eef8; }
.zy-main-action { position: relative; overflow: hidden; min-height: 304rpx; padding: 30rpx; border-radius: 30rpx; color: #fff; background: #173b8f; box-shadow: 0 18rpx 38rpx rgba(23,59,143,.16); }.zy-main-action::after { content: ''; position: absolute; top: -90rpx; right: -74rpx; width: 260rpx; height: 260rpx; border: 46rpx solid rgba(255,255,255,.055); border-radius: 50%; }.zy-main-action--pressed { opacity: .88; box-shadow: 0 10rpx 24rpx rgba(23,59,143,.12); }
.zy-main-meta { position: relative; z-index: 1; display: flex; align-items: flex-start; gap: 12rpx; color: rgba(255,255,255,.86); font-size: 24rpx; line-height: 1.45; }.zy-main-dot { flex: 0 0 auto; width: 12rpx; height: 12rpx; margin-top: 10rpx; border-radius: 50%; background: #63d8bd; }.zy-main-title { position: relative; z-index: 1; max-width: 560rpx; margin-top: 24rpx; font-size: 40rpx; font-weight: 720; line-height: 1.28; }.zy-main-desc { position: relative; z-index: 1; max-width: 570rpx; margin-top: 12rpx; color: rgba(255,255,255,.9); font-size: 26rpx; line-height: 1.55; }
.zy-main-cta { position: relative; z-index: 1; display: inline-flex; align-items: center; gap: 16rpx; min-height: 88rpx; margin-top: 22rpx; padding: 0 28rpx; border-radius: 20rpx; color: #173b8f; background: #fff; font-size: 26rpx; font-weight: 700; }.zy-arrow { font-size: 38rpx; line-height: 1; }
.zy-section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20rpx; min-height: 88rpx; padding: 32rpx 4rpx 16rpx; }.zy-section-title { font-size: 30rpx; font-weight: 730; }.zy-section-sub { margin-top: 6rpx; color: #667085; font-size: 24rpx; }.zy-section-count,.zy-text-action { color: #2b5ce6; font-size: 24rpx; }.zy-text-action { display: flex; align-items: center; justify-content: center; min-width: 112rpx; min-height: 88rpx; margin: -22rpx -16rpx -18rpx 0; }
.zy-list-card,.zy-job-card,.zy-empty-card { overflow: hidden; border: 1rpx solid #e3e9f2; border-radius: 26rpx; background: #fff; }.zy-task,.zy-job-card { display: flex; align-items: center; gap: 18rpx; min-height: 116rpx; padding: 18rpx 22rpx; }.zy-task { border-bottom: 1rpx solid #edf0f5; }.zy-task:last-child { border-bottom: 0; }
.zy-task-check { display: flex; align-items: center; justify-content: center; flex: 0 0 auto; width: 88rpx; min-width: 88rpx; height: 88rpx; min-height: 88rpx; border: 3rpx solid #bdc7d6; border-radius: 18rpx; color: #475467; font-size: 24rpx; }.zy-task.is-done .zy-task-check { border-color: #178b69; color: #fff; background: #178b69; }.zy-task.is-done .zy-row-title { color: #667085; text-decoration: line-through; }
.zy-row-title { overflow: hidden; font-size: 28rpx; font-weight: 680; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }.zy-row-desc { display: -webkit-box; margin-top: 6rpx; overflow: hidden; color: #667085; font-size: 24rpx; line-height: 1.45; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }.zy-row-arrow { flex: 0 0 auto; color: #98a2b3; font-size: 38rpx; }.zy-row--pressed { background: #f7f9fd; opacity: .82; }
.zy-empty-card { padding: 42rpx 28rpx; text-align: center; }.zy-empty-compact { padding: 34rpx 26rpx; }.zy-empty-mark { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; margin: 0 auto 18rpx; border-radius: 22rpx; background: #eef4ff; }.zy-empty-mark text { width: 26rpx; height: 4rpx; border-radius: 999rpx; background: #2b5ce6; }.zy-empty-title { font-size: 28rpx; font-weight: 700; }.zy-empty-desc { margin-top: 9rpx; color: #667085; font-size: 24rpx; line-height: 1.55; }
.zy-company-mark { display: flex; align-items: center; justify-content: center; flex: 0 0 auto; width: 78rpx; height: 78rpx; border-radius: 22rpx; color: #173b8f; background: #eaf0ff; font-size: 26rpx; font-weight: 750; }.zy-match-tag { flex: 0 0 auto; padding: 10rpx 16rpx; border-radius: 999rpx; color: #087a55; background: #e9f8f2; font-size: 24rpx; }.zy-home-tail { height: 16rpx; }
@media (max-width:340px) { .zy-page { padding-left: 22rpx; padding-right: 22rpx; }.zy-main-title { font-size: 36rpx; } }

/* Restore the original layered visual language while keeping the simplified workbench. */
page { background: radial-gradient(circle at 92% -8%, rgba(104, 130, 255, .18), transparent 34%), linear-gradient(180deg, #fbfdff 0%, #f3f7fd 58%, #f8fafc 100%); }
.zy-home-head { padding: 12rpx 6rpx 30rpx; }
.zy-avatar { border-color: rgba(255,255,255,.96); border-radius: 26rpx; box-shadow: 0 12rpx 30rpx rgba(31,55,96,.12); }
.zy-main-action { border: 1rpx solid rgba(255,255,255,.24); background: radial-gradient(circle at 100% 0, rgba(124,92,255,.5), transparent 42%), linear-gradient(135deg,#173b8f 0%,#2f5fd5 58%,#5d55da 100%); box-shadow: 0 24rpx 54rpx rgba(34,70,163,.24), inset 0 1rpx 0 rgba(255,255,255,.24); }
.zy-main-cta { border: 1rpx solid rgba(255,255,255,.7); border-radius: 999rpx; box-shadow: 0 12rpx 26rpx rgba(12,39,101,.16); }
.zy-list-card,.zy-job-card,.zy-empty-card { border-color: rgba(190,208,232,.72); background: linear-gradient(145deg,rgba(255,255,255,.99),rgba(247,250,255,.98)); box-shadow: 0 14rpx 34rpx rgba(36,58,92,.08), inset 0 1rpx 0 rgba(255,255,255,.95); }
.zy-task-check { border-color: #aebbd0; background: rgba(248,250,255,.9); }
.zy-company-mark,.zy-empty-mark { background: linear-gradient(145deg,#edf4ff,#e3ebff); box-shadow: inset 0 1rpx 0 rgba(255,255,255,.9); }
