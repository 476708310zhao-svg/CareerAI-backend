page { min-height: 100%; background: #f5f7fc; }
.zy-page { --home-brand: #2468f2; min-height: 100vh; box-sizing: border-box; padding: 0 32rpx; color: #17253e; background: linear-gradient(180deg,#eaf2ff 0,#f5f7fc 560rpx); font-family: -apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif; }
.zy-row--pressed { opacity: .7; }
.zy-top { margin: 0 8rpx; }
.zy-home-head { display: flex; align-items: center; min-height: 64rpx; margin-bottom: 8rpx; }
.zy-brand { display: flex; align-items: center; min-width: 0; gap: 14rpx; }
.zy-brand-word { position: relative; flex: none; padding-right: 5rpx; }
.zy-brand-name { display: block; color: #0d2b69; font-size: 44rpx; font-style: italic; font-weight: 800; line-height: 60rpx; letter-spacing: -3rpx; transform: skew(-6deg); }
.zy-brand-swoosh { position: absolute; right: 0; bottom: 2rpx; width: 48rpx; height: 9rpx; border-bottom: 6rpx solid #339ef7; border-radius: 50%; transform: rotate(-9deg); }
.zy-brand-divider { flex: none; width: 2rpx; height: 28rpx; background: #a7b6ca; }
.zy-brand-sub { overflow: hidden; min-width: 0; color: #52617b; font-size: 24rpx; white-space: nowrap; text-overflow: ellipsis; }
.zy-head-actions { display: flex; align-items: center; flex: none; gap: 8rpx; }
.zy-head-button { position: relative; display: flex; align-items: center; justify-content: center; width: 88rpx; min-height: 88rpx; box-sizing: border-box; border: 1rpx solid #dce6f5; border-radius: 50%; background: #fff; box-shadow: 0 5rpx 12rpx rgba(35,83,173,.08); }
.zy-head-button image { width: 42rpx; height: 42rpx; }
.zy-unread-dot { position: absolute; top: 9rpx; right: 9rpx; width: 14rpx; height: 14rpx; border: 3rpx solid #fff; border-radius: 50%; background: #f03b46; }
.zy-search-line { display: flex; align-items: center; margin-bottom: 20rpx; gap: 10rpx; }
.zy-search { display: flex; align-items: center; flex: 1; min-width: 0; min-height: 88rpx; box-sizing: border-box; padding: 0 22rpx; border: 1rpx solid #dce6f4; border-radius: 46rpx; background: #fff; box-shadow: 0 4rpx 12rpx rgba(46,93,186,.05); }
.zy-search-icon { width: 38rpx; height: 38rpx; margin-right: 16rpx; }
.zy-search-text { overflow: hidden; color: #66738a; font-size: 26rpx; white-space: nowrap; text-overflow: ellipsis; }
.zy-section-card { overflow: hidden; margin-bottom: 24rpx; border-radius: 32rpx; background: #fff; }
.zy-section-head { display: flex; align-items: center; justify-content: space-between; min-height: 74rpx; padding: 20rpx 30rpx 4rpx; gap: 12rpx; }
.zy-section-title { color: #17253e; font-size: 32rpx; font-weight: 700; line-height: 44rpx; }
.zy-text-action { display: flex; align-items: center; justify-content: flex-end; min-height: 88rpx; flex: none; padding-left: 16rpx; color: #2468f2; font-size: 24rpx; }
.zy-plan-card { position: relative; overflow: hidden; border-radius: 28rpx; background: #eaf2ff; box-shadow: 0 8rpx 28rpx rgba(46,93,186,.12); }
.zy-plan-cover { position: relative; padding: 20rpx 12rpx 20rpx; background: linear-gradient(180deg,rgba(255,255,255,0) 58%,#fff 100%),linear-gradient(110deg,#2e67e7 0%,#4ba9ff 100%); }
.zy-plan-art { position: absolute; top: -22rpx; right: 30rpx; width: 144rpx; height: 116rpx; opacity: .78; }
.zy-plan-heading { position: relative; z-index: 1; display: flex; align-items: center; min-height: 44rpx; margin: 0 12rpx; gap: 12rpx; color: #fff; font-size: 32rpx; font-weight: 700; line-height: 44rpx; }
.zy-plan-head-icon { flex: none; width: 36rpx; height: 36rpx; }
.zy-plan-metrics { position: relative; z-index: 1; display: flex; gap: 8rpx; margin-top: 20rpx; }
.zy-plan-metric { display: flex; align-items: center; flex: 1; min-width: 0; min-height: 92rpx; box-sizing: border-box; padding: 0 8rpx; gap: 7rpx; border: 6rpx solid rgba(255,255,255,.94); border-radius: 19rpx; }
.zy-plan-metric--active { background: #e7f0ff; }.zy-plan-metric--due { background: #fff1e4; }.zy-plan-metric--interview { background: #f0eaff; }
.zy-plan-metric image { flex: none; width: 29rpx; height: 29rpx; }
.zy-plan-metric-label { overflow: hidden; flex: 1; min-width: 0; color: #162f60; font-size: 24rpx; font-weight: 700; white-space: nowrap; text-overflow: ellipsis; }
.zy-plan-metric-value { flex: none; color: #0d2b69; font-size: 32rpx; font-weight: 700; line-height: 40rpx; font-variant-numeric: tabular-nums; }
.zy-plan-metric--due .zy-plan-metric-label,.zy-plan-metric--due .zy-plan-metric-value { color: #be4e12; }
.zy-plan-metric--interview .zy-plan-metric-label,.zy-plan-metric--interview .zy-plan-metric-value { color: #5d3fc4; }
.zy-todo-panel { position: relative; z-index: 1; padding: 0 12rpx 8rpx; background: #fff; }
.zy-todo-header { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; padding: 0 6rpx; gap: 10rpx; border-bottom: 1rpx solid #e8edf5; }
.zy-todo-title { flex: none; color: #17253e; font-size: 29rpx; font-weight: 700; }
.zy-todo-progress { display: flex; align-items: center; min-width: 0; gap: 10rpx; color: #33415b; font-size: 24rpx; white-space: nowrap; }
.zy-progress-track { flex: none; width: 116rpx; height: 9rpx; overflow: hidden; border-radius: 8rpx; background: #e5ebf5; }
.zy-progress-fill { height: 100%; border-radius: 8rpx; background: #2468f2; transition: width 180ms ease; }
.zy-action-row { display: flex; align-items: center; min-height: 100rpx; padding: 8rpx 6rpx; border-bottom: 1rpx solid #e8edf5; gap: 12rpx; }
.zy-action-row:last-of-type { border-bottom: 0; }
.zy-action-icon { display: flex; align-items: center; justify-content: center; flex: none; width: 62rpx; height: 62rpx; border-radius: 15rpx; background: #e9f1ff; }
.zy-action-icon image { width: 38rpx; height: 38rpx; }.zy-action-icon--progress { background: #e3f7ec; }.zy-action-icon--deadline,.zy-action-icon--practice { background: #fff0e2; }.zy-action-icon--jobs,.zy-action-icon--interview { background: #efe9ff; }
.zy-action-copy { flex: 1; min-width: 0; }.zy-action-title { display: block; overflow: hidden; color: #17253e; font-size: 25rpx; font-weight: 700; line-height: 34rpx; text-overflow: ellipsis; white-space: nowrap; }.zy-action-desc { display: block; overflow: hidden; margin-top: 1rpx; color: #66738a; font-size: 24rpx; line-height: 32rpx; text-overflow: ellipsis; white-space: nowrap; }
.zy-task-controls { display: flex; align-items: center; flex: none; gap: 8rpx; }
.zy-task-state { flex: none; padding: 5rpx 9rpx; border-radius: 12rpx; color: #25836b; background: #e7f6ef; font-size: 24rpx; white-space: nowrap; }
.zy-action-cta { display: flex; align-items: center; justify-content: center; flex: none; min-height: 88rpx; box-sizing: border-box; color: #17253e; font-size: 24rpx; font-weight: 700; white-space: nowrap; }
.zy-action-cta--primary { color: #fff; }.zy-cta-pill { display: flex; align-items: center; justify-content: center; min-height: 60rpx; padding: 0 13rpx; border-radius: 18rpx; background: #f0f4fb; }.zy-action-cta--primary .zy-cta-pill { background: #2468f2; }
.zy-task-unavailable { color: #8792a5; font-size: 24rpx; }
.zy-more-tasks { display: flex; align-items: center; justify-content: center; min-height: 88rpx; color: #2468f2; font-size: 24rpx; }
.zy-login-prompt { display: flex; align-items: center; justify-content: space-between; min-height: 100rpx; padding: 0 8rpx; color: #66738a; font-size: 24rpx; }.zy-login-prompt view { display: flex; align-items: center; min-height: 88rpx; padding: 0 14rpx; color: #2468f2; }
.zy-todo-message { display: flex; align-items: center; justify-content: center; min-height: 106rpx; color: #66738a; font-size: 24rpx; }.zy-todo-message--error { justify-content: space-between; }.zy-todo-message--error view { display: flex; align-items: center; min-height: 88rpx; padding: 0 12rpx; color: #2468f2; }
.zy-shortcuts { display: flex; justify-content: space-between; padding: 18rpx 22rpx 28rpx; }
.zy-shortcut { display: flex; align-items: center; flex: 1; min-width: 0; min-height: 130rpx; flex-direction: column; justify-content: center; color: #17253e; font-size: 24rpx; font-weight: 600; white-space: nowrap; }
.zy-shortcut-icon { display: flex; align-items: center; justify-content: center; width: 70rpx; height: 70rpx; margin-bottom: 12rpx; border-radius: 22rpx; background: #e9f1ff; }.zy-shortcut:nth-child(2) .zy-shortcut-icon { background: #e5f7f0; }.zy-shortcut:nth-child(3) .zy-shortcut-icon { background: #f2ecff; }.zy-shortcut:nth-child(4) .zy-shortcut-icon { background: #fff1e4; }.zy-shortcut-icon image { width: 38rpx; height: 38rpx; }
.zy-shortcut--disabled { color: #98a4b7; }.zy-shortcut--disabled .zy-shortcut-icon { opacity: .5; }
.zy-job-card,.zy-assessment-row,.zy-campus-row { display: flex; align-items: center; box-sizing: border-box; min-height: 122rpx; margin: 0 30rpx; padding: 16rpx 0; border-top: 1rpx solid #e8edf5; gap: 16rpx; }
.zy-job-card:first-of-type,.zy-assessment-row:first-of-type,.zy-campus-row:first-of-type { border-top: 0; }
.zy-company-mark,.zy-resource-mark,.zy-campus-icon { display: flex; align-items: center; justify-content: center; flex: none; width: 70rpx; height: 70rpx; overflow: hidden; border-radius: 18rpx; color: #2468f2; background: #e9f1ff; font-size: 24rpx; font-weight: 700; }.zy-company-mark image,.zy-campus-icon image { width: 60rpx; height: 60rpx; }.zy-resource-mark image { width: 38rpx; height: 38rpx; }
.zy-row-copy { flex: 1; min-width: 0; }.zy-job-top { display: flex; justify-content: space-between; gap: 8rpx; }.zy-job-company,.zy-campus-company { display: block; overflow: hidden; color: #66738a; font-size: 24rpx; line-height: 30rpx; white-space: nowrap; text-overflow: ellipsis; }.zy-job-updated { flex: none; color: #98a4b7; font-size: 24rpx; }.zy-row-title { display: -webkit-box; overflow: hidden; color: #17253e; font-size: 25rpx; font-weight: 700; line-height: 34rpx; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }.zy-job-meta,.zy-campus-facts { display: block; overflow: hidden; margin-top: 4rpx; color: #66738a; font-size: 24rpx; white-space: nowrap; text-overflow: ellipsis; }.zy-row-arrow { flex: none; width: 28rpx; height: 28rpx; }
.zy-assessment-price { flex: none; padding: 6rpx 14rpx; border-radius: 14rpx; color: #7857ea; background: #f2ecff; font-size: 24rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.zy-job-meta { color: #66738a; }
.zy-campus-heading-line { display: flex; align-items: center; min-width: 0; gap: 12rpx; }.zy-campus-live { padding: 4rpx 10rpx; border-radius: 9rpx; color: #2468f2; background: #e9f1ff; font-size: 24rpx; white-space: nowrap; }.zy-campus-position { display: block; overflow: hidden; color: #17253e; font-size: 24rpx; font-weight: 700; line-height: 34rpx; white-space: nowrap; text-overflow: ellipsis; }.zy-campus-deadline { flex: none; max-width: 130rpx; color: #2468f2; font-size: 24rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.zy-loading-row { min-height: 110rpx; padding: 25rpx 30rpx; box-sizing: border-box; color: #66738a; font-size: 24rpx; }.zy-empty-card { display: flex; align-items: center; justify-content: space-between; min-height: 110rpx; padding: 16rpx 30rpx; gap: 12rpx; }.zy-empty-title { color: #66738a; font-size: 24rpx; }.zy-campus-retry { display: flex; align-items: center; justify-content: center; flex: none; min-height: 88rpx; padding: 0 15rpx; color: #2468f2; font-size: 24rpx; }
.zy-skeleton-list { padding: 0 30rpx 18rpx; }.zy-skeleton-row { display: flex; align-items: center; min-height: 122rpx; gap: 16rpx; border-top: 1rpx solid #e8edf5; }.zy-skeleton-mark { flex: none; width: 70rpx; height: 70rpx; border-radius: 18rpx; background: #e8edf5; }.zy-skeleton-copy { flex: 1; min-width: 0; }.zy-skeleton-copy view { width: 72%; height: 18rpx; margin: 10rpx 0; border-radius: 9rpx; background: #e8edf5; }.zy-skeleton-copy view:last-child { width: 48%; }
.zy-home-tail { height: calc(150rpx + env(safe-area-inset-bottom)); }
@media (max-width: 350px) { .zy-page { padding-left: 22rpx; padding-right: 22rpx; }.zy-brand-sub { font-size: 24rpx; }.zy-shortcut { font-size: 24rpx; }.zy-plan-metric { padding: 0 4rpx; gap: 2rpx; border-width: 4rpx; }.zy-plan-metric image { width: 25rpx; height: 25rpx; }.zy-plan-metric-value { font-size: 28rpx; }.zy-task-controls { gap: 4rpx; }.zy-task-state { padding-left: 5rpx; padding-right: 5rpx; }.zy-cta-pill { padding-left: 7rpx; padding-right: 7rpx; } }
@media (prefers-reduced-motion: reduce) { .zy-progress-fill { transition: none; } }
