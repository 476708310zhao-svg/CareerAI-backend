<view class="zy-page" style="padding-top: {{navTop}}px;">
  <view class="zy-search" bindtap="navigateToPage" data-url="/pages/jobs/jobs" hover-class="zy-row--pressed" aria-role="button" aria-label="搜索岗位、公司或关键词">
    <image class="zy-search-icon" src="/images/zhiyin-icons/search-muted.svg" mode="aspectFit" aria-hidden="true" />
    <text class="zy-search-text">搜索岗位、公司或关键词</text>
  </view>

  <view class="zy-main-action" bindtap="navigateToPage" data-url="{{workbench.primaryUrl}}" hover-class="zy-main-action--pressed" aria-role="button" aria-label="{{workbench.primaryText}}：{{workbench.title}}">
    <view class="zy-main-meta"><image class="zy-target-mark" src="/images/zhiyin-icons/target.svg" mode="aspectFit" aria-hidden="true" /><text>今日重点</text></view>
    <text class="zy-main-title">{{workbench.title}}</text>
    <view class="zy-action-visual" aria-hidden="true"><view class="zy-paper-illustration"><view></view><view></view><view></view></view><view class="zy-pencil-illustration"></view></view>
    <view class="zy-main-cta"><text>{{workbench.primaryText}}</text><image class="zy-arrow" src="/images/zhiyin-icons/chevron-white.svg" mode="aspectFit" aria-hidden="true" /></view>
  </view>

  <view class="zy-signal-card">
    <view class="zy-signal-head"><text class="zy-signal-title">申请进度</text><view class="zy-signal-link" bindtap="navigateToPage" data-url="/pages/applications/applications" hover-class="zy-row--pressed" aria-role="button" aria-label="查看全部申请进度"><text>查看全部</text><image class="zy-inline-chevron" src="/images/zhiyin-icons/chevron.svg" mode="aspectFit" aria-hidden="true" /></view></view>
    <view class="zy-signal-panel" bindtap="navigateToPage" data-url="/pages/applications/applications" hover-class="zy-row--pressed" aria-role="button" aria-label="查看申请概览，{{progressSummary.active}}条进行中">
      <view class="zy-signal"><view class="zy-signal-label-row"><image class="zy-signal-icon" src="/images/zhiyin-icons/document.svg" mode="aspectFit" aria-hidden="true" /><text class="zy-signal-label">进行中</text></view><text class="zy-signal-value">{{progressSummary.active}}</text></view>
      <view class="zy-signal-divider"></view>
      <view class="zy-signal"><view class="zy-signal-label-row"><image class="zy-signal-icon" src="/images/zhiyin-icons/clock.svg" mode="aspectFit" aria-hidden="true" /><text class="zy-signal-label">即将截止</text></view><text class="zy-signal-value zy-warning-value">{{progressSummary.dueSoon}}</text></view>
      <view class="zy-signal-divider"></view>
      <view class="zy-signal"><view class="zy-signal-label-row"><image class="zy-signal-icon" src="/images/zhiyin-icons/person.svg" mode="aspectFit" aria-hidden="true" /><text class="zy-signal-label">今日面试</text></view><text class="zy-signal-value">{{progressSummary.todayInterviews}}</text></view>
    </view>
  </view>

  <view class="zy-section-card zy-shortcuts-card">
    <view class="zy-section-head"><text class="zy-section-title">常用功能</text></view>
    <view class="zy-shortcuts">
      <view class="zy-shortcut" bindtap="navigateToPage" data-url="/package-career/pages/resume-center/resume-center" hover-class="zy-row--pressed" aria-role="button" aria-label="简历优化"><view class="zy-shortcut-icon tone-blue"><image src="/images/zhiyin-icons/document.svg" mode="aspectFit" aria-hidden="true" /></view><text>简历优化</text></view>
      <view class="zy-shortcut" bindtap="navigateToPage" data-url="/package-ai/pages/jd-match/jd-match?source=home" hover-class="zy-row--pressed" aria-role="button" aria-label="岗位匹配"><view class="zy-shortcut-icon tone-violet"><image src="/images/zhiyin-icons/target.svg" mode="aspectFit" aria-hidden="true" /></view><text>岗位匹配</text></view>
      <view class="zy-shortcut" bindtap="navigateToPage" data-url="/package-ai/pages/interview-setup/interview-setup" hover-class="zy-row--pressed" aria-role="button" aria-label="模拟面试"><view class="zy-shortcut-icon tone-cyan"><image src="/images/zhiyin-icons/person.svg" mode="aspectFit" aria-hidden="true" /></view><text>模拟面试</text></view>
      <view class="zy-shortcut" bindtap="navigateToPage" data-url="/pages/campus/campus" hover-class="zy-row--pressed" aria-role="button" aria-label="校招日历"><view class="zy-shortcut-icon tone-orange"><image src="/images/zhiyin-icons/calendar.svg" mode="aspectFit" aria-hidden="true" /></view><text>校招日历</text></view>
    </view>
  </view>

  <view class="zy-section-card zy-today-card">
    <view class="zy-section-head"><text class="zy-section-title">今天还要做</text><text class="zy-section-count">{{todaySecondaryTasks.length}} 项</text></view>
    <view class="zy-list-card" wx:if="{{todaySecondaryTasks.length}}">
      <view wx:for="{{todaySecondaryTasks}}" wx:key="id" class="zy-task {{item.done ? 'is-done' : ''}}" bindtap="openTodayTask" data-url="{{item.url}}" hover-class="zy-row--pressed" aria-role="button" aria-label="打开任务：{{item.title}}，{{item.desc}}">
        <view class="zy-task-check type-{{item.type || 'default'}}" catchtap="toggleTodayTask" data-id="{{item.id}}" aria-role="button" aria-label="{{item.done ? '标记为未完成' : '标记为已完成'}}" aria-pressed="{{item.done}}"><image class="zy-task-glyph" src="{{item.type === 'interview' ? '/images/zhiyin-icons/calendar.svg' : '/images/zhiyin-icons/search-blue.svg'}}" mode="aspectFit" aria-hidden="true" /></view>
        <view class="zy-row-copy"><text class="zy-row-title">{{item.title}}</text></view><image class="zy-row-arrow" src="/images/zhiyin-icons/chevron.svg" mode="aspectFit" aria-hidden="true" />
      </view>
    </view>
    <view class="zy-empty-card" wx:else><view class="zy-empty-mark" aria-hidden="true"><text></text></view><view><text class="zy-empty-title">其他事项已清空</text><text class="zy-empty-desc">专注完成上方的关键行动。</text></view></view>
  </view>

  <block wx:if="{{recruitmentEnabled}}">
    <view class="zy-section-card zy-recommend-section">
      <view class="zy-section-head zy-recommend-head"><text class="zy-section-title">{{homeRecommendationsEnabled ? '为你推荐' : '最新机会'}}</text><view class="zy-text-action" bindtap="navigateToPage" data-url="/pages/jobs/jobs" hover-class="zy-row--pressed" aria-role="button" aria-label="查看全部岗位"><text>查看全部</text><image class="zy-inline-chevron" src="/images/zhiyin-icons/chevron.svg" mode="aspectFit" aria-hidden="true" /></view></view>
      <block wx:for="{{homeRecommendationsEnabled ? recommendJobs : latestJobs}}" wx:key="id">
      <view class="zy-job-card" wx:if="{{index < 2}}" bindtap="goToJobDetail" data-id="{{item.id}}" data-title="{{item.title}}" hover-class="zy-row--pressed" aria-role="button" aria-label="查看岗位 {{item.title}}，{{item.sourceSummary}}">
        <view class="zy-company-mark"><image wx:if="{{item.logoSrc && !item.logoFailed}}" src="{{item.logoSrc}}" mode="aspectFit" data-index="{{index}}" data-list="{{homeRecommendationsEnabled ? 'recommend' : 'latest'}}" binderror="onJobLogoError" aria-hidden="true" /><image wx:else src="/images/zhiyin-icons/company.svg" mode="aspectFit" aria-hidden="true" /></view>
        <view class="zy-row-copy"><text class="zy-row-title">{{item.title}}</text><text class="zy-job-meta">{{item.company}} · {{item.city || '地点待确认'}}</text><view class="zy-job-tags"><text wx:if="{{item.type}}">{{item.type}}</text><text class="zy-provenance-tag">{{item.sourceSummary}}</text></view></view><image class="zy-row-arrow" src="/images/zhiyin-icons/chevron.svg" mode="aspectFit" aria-hidden="true" />
      </view>
      </block>
      <view class="zy-loading-row" wx:if="{{!(homeRecommendationsEnabled ? recommendJobs.length : latestJobs.length) && (homeRecommendationsEnabled ? loadingJobs : loadingLatestJobs)}}">正在查找新机会…</view>
      <view class="zy-empty-card zy-empty-compact" wx:if="{{!(homeRecommendationsEnabled ? recommendJobs.length : latestJobs.length) && !(homeRecommendationsEnabled ? loadingJobs : loadingLatestJobs)}}"><view><text class="zy-empty-title">暂时没有可核实的新岗位</text><text class="zy-empty-desc">去找岗位查看更多机会</text></view></view>
    </view>
  </block>
  <view class="zy-section-card zy-campus-section">
    <view class="zy-section-head"><text class="zy-section-title">求职动态</text><view class="zy-text-action" bindtap="goToCampusList" hover-class="zy-row--pressed" aria-role="button" aria-label="查看全部校招动态"><text>查看全部</text><image class="zy-inline-chevron" src="/images/zhiyin-icons/chevron.svg" mode="aspectFit" aria-hidden="true" /></view></view>
    <view class="zy-campus-row" wx:for="{{campusDigest}}" wx:key="id" bindtap="goToCampusUpdateDetail" data-id="{{item.id}}" hover-class="zy-row--pressed" aria-role="button" aria-label="查看{{item.title}}，{{item.sourceSummary}}">
      <view class="zy-campus-icon"><image src="/images/zhiyin-icons/calendar.svg" mode="aspectFit" aria-hidden="true" /></view>
      <view class="zy-row-copy"><text class="zy-row-title">{{item.title}}</text><text class="zy-job-meta">{{item.digestMeta}}</text><text class="zy-source-text">{{item.sourceSummary}}</text></view>
      <text class="zy-campus-badge {{item.isUrgent ? 'is-urgent' : ''}}">{{item.digestLabel}}</text><image class="zy-row-arrow" src="/images/zhiyin-icons/chevron.svg" mode="aspectFit" aria-hidden="true" />
    </view>
    <view class="zy-loading-row" wx:if="{{!campusDigest.length && loadingCampusDigest}}">正在读取校招动态…</view>
    <view class="zy-empty-card zy-empty-compact" wx:if="{{!campusDigest.length && !loadingCampusDigest}}"><view><text class="zy-empty-title">暂无可核实的校招更新</text><text class="zy-empty-desc">进入校招日历查看全部信息</text></view></view>
  </view>
  <view class="zy-home-tail"></view>
</view>
