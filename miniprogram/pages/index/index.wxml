<view class="zy-page">
  <view class="zy-home-head">
    <view class="zy-home-copy">
      <text class="zy-kicker">今日行动台</text>
      <text class="zy-page-title">{{greeting}}</text>
      <text class="zy-page-sub">{{progressSummary.active ? '你有 ' + progressSummary.active + ' 条申请正在推进，先完成最关键的一步。' : '从一个真实目标开始，逐步建立你的求职进度。'}}</text>
    </view>
    <image class="zy-avatar" src="{{avatarUrl}}" mode="aspectFill" binderror="onAvatarError" aria-label="个人头像" />
  </view>
  <view class="zy-main-action" bindtap="navigateToPage" data-url="{{workbench.primaryUrl}}" hover-class="zy-main-action--pressed" aria-role="button" aria-label="{{workbench.primaryText}}：{{workbench.title}}">
    <view class="zy-main-meta"><text class="zy-main-dot" aria-hidden="true"></text><text>{{workbench.meta}}</text></view>
    <text class="zy-main-title">{{workbench.title}}</text>
    <text class="zy-main-desc">{{workbench.subtitle}}</text>
    <view class="zy-main-cta"><text>{{workbench.primaryText}}</text><text class="zy-arrow" aria-hidden="true">›</text></view>
  </view>
  <view class="zy-section-head"><view><text class="zy-section-title">今天还要做</text><text class="zy-section-sub">主任务之外最多展示两项</text></view><text class="zy-section-count">{{todaySecondaryTasks.length}} 项</text></view>
  <view class="zy-list-card" wx:if="{{todaySecondaryTasks.length}}">
    <view wx:for="{{todaySecondaryTasks}}" wx:key="id" class="zy-task {{item.done ? 'is-done' : ''}}" bindtap="openTodayTask" data-url="{{item.url}}" hover-class="zy-row--pressed" aria-role="button" aria-label="打开任务：{{item.title}}，{{item.desc}}">
      <view class="zy-task-check" catchtap="toggleTodayTask" data-id="{{item.id}}" aria-role="button" aria-label="{{item.done ? '标记为未完成' : '标记为已完成'}}" aria-pressed="{{item.done}}"><text wx:if="{{item.done}}">完成</text></view>
      <view class="zy-row-copy"><text class="zy-row-title">{{item.title}}</text><text class="zy-row-desc">{{item.desc}}</text></view><text class="zy-row-arrow" aria-hidden="true">›</text>
    </view>
  </view>
  <view class="zy-empty-card" wx:else><view class="zy-empty-mark"><text></text></view><text class="zy-empty-title">主任务之外没有其他事项</text><text class="zy-empty-desc">先完成上方行动，之后可回顾申请进度。</text></view>
  <block wx:if="{{recruitmentEnabled && homeRecommendationsEnabled}}">
    <view class="zy-section-head"><view><text class="zy-section-title">与你的目标相关</text><text class="zy-section-sub">{{recommendTitle}}</text></view><view class="zy-text-action" bindtap="viewMoreJobs" aria-role="button" aria-label="查看更多岗位">找岗位</view></view>
    <view class="zy-job-card" wx:if="{{recommendJobs.length}}" bindtap="goToJobDetail" data-id="{{recommendJobs[0].id}}" hover-class="zy-row--pressed" aria-role="button" aria-label="查看推荐岗位 {{recommendJobs[0].title}}"><view class="zy-company-mark">{{recommendJobs[0].companyInitial || '职'}}</view><view class="zy-row-copy"><text class="zy-row-title">{{recommendJobs[0].title}}</text><text class="zy-row-desc">{{recommendJobs[0].company}} · {{recommendJobs[0].location || '地点待确认'}}</text></view><text class="zy-match-tag">推荐</text></view>
    <view class="zy-empty-card zy-empty-compact" wx:elif="{{!loadingJobs}}"><text class="zy-empty-title">暂无可验证的岗位推荐</text><text class="zy-empty-desc">完善求职目标后再来看看，系统不会填充演示结果。</text></view>
  </block>
  <view class="zy-home-tail"></view>
</view>
