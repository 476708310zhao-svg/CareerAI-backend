.compat-page { display:flex; min-height:70vh; align-items:center; justify-content:center; flex-direction:column; gap:20rpx; color:#667085; font-size:24rpx; }
.compat-spinner { width:40rpx; height:40rpx; border:5rpx solid #e7ebf2; border-top-color:#5146d8; border-radius:50%; animation:spin .8s linear infinite; }
@keyframes spin { to { transform:rotate(360deg); } }
