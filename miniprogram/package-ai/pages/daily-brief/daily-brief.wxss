/* package-ai/pages/daily-brief/daily-brief.wxss */
page {
  background: #f7f9fc;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'PingFang SC', sans-serif;
}

.page {
  min-height: 100vh;
  padding: 16rpx 0 40rpx;
  box-sizing: border-box;
  color: #111c31;
  background:
    radial-gradient(circle at 16% 0%, rgba(43, 92, 230, 0.08), transparent 30%),
    linear-gradient(180deg, #fbfdff 0%, #f7f9fc 52%, #f9fbfd 100%);
}

/* ── 今日概览 ─────────────────────────────────────────────── */
.brief-hero {
  position: relative;
  overflow: hidden;
  margin: 18rpx 28rpx 0;
  padding: 28rpx;
  border: 1.5rpx solid #d9e5f4;
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 100% 0%, rgba(73, 139, 255, 0.11), transparent 34%),
    linear-gradient(145deg, #ffffff 0%, #f5f9ff 100%);
  box-shadow: 0 14rpx 34rpx rgba(38, 77, 132, 0.07);
}

.hero-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.hero-copy {
  min-width: 0;
  flex: 1;
}

.hero-kicker,
.hero-title,
.hero-subtitle,
.hero-metric-label,
.hero-metric-value,
.hero-tip-label,
.hero-tip-text {
  display: block;
}

.hero-kicker {
  color: #1769e8;
  font-size: 21rpx;
  font-weight: 850;
  letter-spacing: 0.5rpx;
}

.hero-title {
  margin-top: 7rpx;
  color: #101a2d;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.25;
}

.hero-subtitle {
  margin-top: 9rpx;
  color: #728198;
  font-size: 21rpx;
  line-height: 1.45;
}

.hero-mark {
  width: 66rpx;
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 20rpx;
  color: #ffffff;
  background: linear-gradient(145deg, #2563eb 0%, #6d5dfc 100%);
  box-shadow: 0 10rpx 22rpx rgba(64, 91, 214, 0.2);
}

.hero-mark-icon {
  font-size: 34rpx;
  font-weight: 900;
}

.hero-metrics {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 11rpx;
  margin-top: 24rpx;
}

.hero-metric {
  min-width: 0;
  min-height: 106rpx;
  padding: 16rpx 12rpx 14rpx;
  box-sizing: border-box;
  border: 1rpx solid #dce8f6;
  border-radius: 19rpx;
  background: rgba(248, 251, 255, 0.96);
}

.hero-metric.blue {
  border-color: #d4e4f8;
  background: #f4f8ff;
}

.hero-metric.amber {
  border-color: #f0dfc8;
  background: #fff9f1;
}

.hero-metric.purple {
  border-color: #e2dcf8;
  background: #f8f6ff;
}

.hero-metric.green {
  border-color: #d2ecdf;
  background: #f4fbf7;
}

.hero-metric-label {
  overflow: hidden;
  color: #607088;
  font-size: 18rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-metric-value {
  margin-top: 12rpx;
  color: #101b2f;
  font-size: 35rpx;
  font-weight: 900;
  line-height: 1;
}

.hero-metric.green .hero-metric-value {
  color: #159767;
}

.hero-tip {
  min-height: 76rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
  padding: 13rpx 15rpx;
  box-sizing: border-box;
  border: 1rpx solid #dce6f2;
  border-radius: 19rpx;
  background: rgba(255, 255, 255, 0.92);
}

.hero-tip-mark {
  width: 42rpx;
  height: 42rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  color: #14a666;
  background: #e7f8ef;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 42rpx;
  text-align: center;
}

.hero-tip-copy {
  min-width: 0;
  flex: 1;
}

.hero-tip-label {
  color: #25344b;
  font-size: 19rpx;
  font-weight: 850;
}

.hero-tip-text {
  margin-top: 4rpx;
  overflow: hidden;
  color: #7f8da2;
  font-size: 18rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-tip-action {
  flex-shrink: 0;
  color: #1766ec;
  font-size: 19rpx;
  font-weight: 850;
}

/* ── 内容模块 ─────────────────────────────────────────────── */
.brief-module,
.section,
.summary-banner {
  margin: 22rpx 28rpx 0;
  padding: 26rpx;
  box-sizing: border-box;
  border: 1.5rpx solid #e0e8f3;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 10rpx 28rpx rgba(38, 62, 98, 0.055);
}

.module-head,
.summary-banner-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 17rpx;
}

.module-title,
.section-title {
  color: #15213a;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.3;
}

.module-link {
  flex-shrink: 0;
  color: #1769e8;
  font-size: 23rpx;
  font-weight: 850;
}

.brief-job-card,
.deadline-brief-card,
.task-card,
.question-row,
.news-brief-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 19rpx 0;
  border-top: 1rpx solid #edf1f6;
}

.brief-job-card:first-of-type,
.deadline-brief-card:first-of-type,
.task-card:first-of-type,
.question-row:first-of-type,
.news-brief-row:first-of-type {
  border-top: 0;
}

.task-card {
  position: relative;
  align-items: flex-start;
  flex-direction: column;
  padding-left: 28rpx;
}

.task-card::before {
  position: absolute;
  top: 26rpx;
  left: 0;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #3d82f6;
  box-shadow: 0 0 0 7rpx #edf4ff;
  content: '';
}

.task-card.done::before {
  background: #18a66b;
  box-shadow: 0 0 0 7rpx #eaf8f1;
}

.brief-job-title,
.deadline-company,
.task-title,
.news-brief-title {
  display: block;
  color: #162238;
  font-size: 26rpx;
  font-weight: 850;
  line-height: 1.4;
}

.brief-job-company,
.deadline-role,
.task-sub,
.news-brief-time {
  display: block;
  margin-top: 6rpx;
  color: #75839a;
  font-size: 22rpx;
  line-height: 1.45;
}

.brief-job-salary,
.deadline-badge {
  max-width: 190rpx;
  overflow: hidden;
  flex-shrink: 0;
  padding: 8rpx 13rpx;
  border-radius: 999rpx;
  color: #1769e8;
  background: #edf4ff;
  font-size: 21rpx;
  font-weight: 850;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.deadline-badge {
  color: #b45309;
  background: #fff6e8;
}

.soft-empty {
  padding: 22rpx;
  border: 1rpx dashed #d8e2ef;
  border-radius: 18rpx;
  color: #718096;
  background: #f8fafc;
  font-size: 23rpx;
  line-height: 1.6;
}

.question-row {
  justify-content: flex-start;
}

.question-index {
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 13rpx;
  color: #ffffff;
  background: linear-gradient(145deg, #2563eb, #6d5dfc);
  font-size: 21rpx;
  font-weight: 900;
}

.question-text {
  min-width: 0;
  flex: 1;
  color: #344054;
  font-size: 25rpx;
  line-height: 1.5;
}

.card-press {
  opacity: 0.82;
  transform: scale(0.986);
}

/* ── AI 今日总结 ───────────────────────────────────────────── */
.summary-banner {
  position: relative;
  overflow: hidden;
  border-color: #d6e5f8;
  background:
    radial-gradient(circle at 100% 0%, rgba(61, 130, 246, 0.11), transparent 36%),
    linear-gradient(145deg, #ffffff 0%, #f3f8ff 100%);
}

.summary-banner::before {
  position: absolute;
  top: 24rpx;
  bottom: 24rpx;
  left: 0;
  width: 6rpx;
  border-radius: 0 999rpx 999rpx 0;
  background: linear-gradient(180deg, #2563eb, #7c3aed);
  content: '';
}

.summary-banner-title {
  color: #1769e8;
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 0.5rpx;
}

.refresh-btn {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  color: #2767cb;
  background: #eaf2ff;
  font-size: 21rpx;
  font-weight: 800;
}

.summary-txt {
  color: #27364d;
  font-size: 27rpx;
  font-weight: 550;
  line-height: 1.72;
}

/* ── 数据与建议 ────────────────────────────────────────────── */
.section-title {
  margin-bottom: 19rpx;
}

.highlights-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.highlight-card {
  position: relative;
  overflow: hidden;
  min-width: 0;
  min-height: 118rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  padding: 16rpx 10rpx;
  box-sizing: border-box;
  border: 1rpx solid #dde8f5;
  border-radius: 19rpx;
  background: #f7faff;
}

.highlight-card::before {
  position: absolute;
  top: 0;
  right: 22rpx;
  left: 22rpx;
  height: 5rpx;
  border-radius: 0 0 999rpx 999rpx;
  background: linear-gradient(90deg, #3b82f6, #7c6df2);
  content: '';
}

.highlight-card:nth-child(2)::before {
  background: linear-gradient(90deg, #f3a743, #f5c86e);
}

.highlight-card:nth-child(3)::before {
  background: linear-gradient(90deg, #20aa75, #62c99d);
}

.hl-value {
  max-width: 100%;
  overflow: hidden;
  color: #15213a;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.25;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hl-label {
  color: #7a889d;
  font-size: 20rpx;
}

.focus-card {
  display: flex;
  align-items: flex-start;
  gap: 17rpx;
  padding: 23rpx;
  border: 1rpx solid #dbe8fb;
  border-radius: 19rpx;
  background: linear-gradient(135deg, #f3f7ff, #eef4ff);
}

.focus-icon-wrap {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 15rpx;
  background: #dfeaff;
}

.focus-icon {
  font-size: 27rpx;
}

.focus-txt {
  min-width: 0;
  flex: 1;
  color: #294d86;
  font-size: 26rpx;
  font-weight: 650;
  line-height: 1.62;
}

.plan-item {
  display: flex;
  align-items: flex-start;
  gap: 17rpx;
  padding: 19rpx 0;
  border-top: 1rpx solid #edf1f6;
}

.plan-item:first-of-type {
  border-top: 0;
}

.plan-time-wrap {
  flex-shrink: 0;
  padding: 8rpx 13rpx;
  border-radius: 11rpx;
  background: #eef4ff;
}

.plan-time {
  color: #2864bd;
  font-size: 21rpx;
  font-weight: 800;
}

.plan-body {
  min-width: 0;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  flex: 1;
}

.plan-task {
  min-width: 0;
  flex: 1;
  color: #334158;
  font-size: 26rpx;
  line-height: 1.5;
}

.plan-priority {
  flex-shrink: 0;
  padding: 5rpx 11rpx;
  border-radius: 9rpx;
  font-size: 19rpx;
  font-weight: 800;
  white-space: nowrap;
}

.plan-priority.high {
  color: #dc2626;
  background: #fef2f2;
}

.plan-priority.medium {
  color: #b86a08;
  background: #fff7e8;
}

.plan-priority.low {
  color: #16875c;
  background: #ecf9f2;
}

.advice-card {
  position: relative;
  padding: 23rpx;
  border: 1rpx solid #dddff8;
  border-radius: 19rpx;
  background: linear-gradient(145deg, #faf9ff, #f5f4ff);
}

.advice-ai-tag {
  width: fit-content;
  margin-bottom: 14rpx;
  padding: 5rpx 14rpx;
  border-radius: 10rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #2563eb, #7c3aed);
  font-size: 19rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.advice-txt {
  color: #3b435d;
  font-size: 26rpx;
  line-height: 1.72;
}

.motivation-card {
  margin: 22rpx 28rpx 0;
  padding: 24rpx 28rpx;
  border: 1rpx solid #eadfbf;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #fffdf5, #fff8e7);
  text-align: center;
}

.motivation-txt {
  color: #8b5c18;
  font-size: 26rpx;
  font-weight: 650;
  line-height: 1.6;
}

/* ── 加载与空态 ────────────────────────────────────────────── */
.loading-card,
.idle-card {
  margin: 22rpx 28rpx 0;
  padding: 68rpx 42rpx;
  border: 1.5rpx solid #e0e8f3;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 10rpx 28rpx rgba(38, 62, 98, 0.055);
  text-align: center;
}

.loading-card,
.idle-card {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-rings {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.ring {
  position: absolute;
  border: 5rpx solid transparent;
  border-radius: 50%;
}

.r1 {
  width: 112rpx;
  height: 112rpx;
  border-top-color: #2563eb;
  animation: spin 1.2s linear infinite;
}

.r2 {
  width: 80rpx;
  height: 80rpx;
  border-top-color: #7c6df2;
  animation: spin 0.8s linear infinite reverse;
}

.ring-icon {
  z-index: 1;
  font-size: 38rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-tip {
  color: #718096;
  font-size: 26rpx;
}

.idle-emoji {
  margin-bottom: 20rpx;
  font-size: 70rpx;
}

.idle-title {
  margin-bottom: 10rpx;
  color: #15213a;
  font-size: 32rpx;
  font-weight: 900;
}

.idle-desc {
  max-width: 540rpx;
  margin-bottom: 32rpx;
  color: #75839a;
  font-size: 24rpx;
  line-height: 1.6;
}

.gen-btn {
  padding: 22rpx 52rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #1766ec, #4a8df8);
  box-shadow: 0 9rpx 20rpx rgba(30, 105, 232, 0.2);
  font-size: 27rpx;
  font-weight: 850;
}
