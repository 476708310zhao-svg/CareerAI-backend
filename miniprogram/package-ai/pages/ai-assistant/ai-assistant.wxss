/* Compact conversation menu: content height, quiet rows, and safe area clearance. */
.drawer-mask { background: rgba(17, 24, 39, .28); }
.drawer { bottom: auto; width: 80%; max-width: 600rpx; max-height: 72vh; padding: 12rpx 18rpx 18rpx; border: 1rpx solid #e2e8f3; border-left: 0; border-radius: 0 28rpx 28rpx 0; background: #fff; box-shadow: 16rpx 16rpx 44rpx rgba(29, 45, 76, .14); transform: translateX(-105%); }
.drawer-scroll { height: auto; max-height: calc(72vh - 30rpx); }
.drawer-brand { min-height: 88rpx; margin: 0 4rpx 4rpx; }
.drawer-close { display: flex; align-items: center; justify-content: center; min-width: 88rpx; min-height: 88rpx; margin-left: auto; color: #315ee8; font-size: 21rpx; font-weight: 700; }
.drawer-logo { width: 48rpx; height: 48rpx; border-radius: 14rpx; color: #315ee8; background: #edf3ff; font-size: 18rpx; }
.drawer-title { margin-left: 14rpx; color: #111827; font-size: 28rpx; font-weight: 800; }
.drawer-new { min-height: 88rpx; padding: 0 14rpx; border-bottom: 1rpx solid #e8edf5; border-radius: 14rpx; color: #315ee8; background: transparent; font-size: 23rpx; box-sizing: border-box; }
.drawer-new-icon { display: flex; align-items: center; justify-content: center; width: 40rpx; height: 40rpx; margin-right: 16rpx; border-radius: 12rpx; background: #edf3ff; font-size: 29rpx; line-height: 1; }
.drawer-section-title { margin: 16rpx 12rpx 5rpx; color: #667085; font-size: 20rpx; }
.drawer-tool, .recent-chat { min-height: 88rpx; margin: 0; padding: 0 12rpx; border: 0; border-radius: 14rpx; background: transparent; box-sizing: border-box; }
.drawer-tool-icon { display: flex; align-items: center; justify-content: center; width: 40rpx; height: 40rpx; border-radius: 12rpx; color: #315ee8; background: #f1f5ff; font-size: 18rpx; font-weight: 750; }
.drawer-tool-copy, .recent-copy { margin-left: 16rpx; }
.drawer-tool-title, .recent-name { overflow: hidden; color: #1d2939; font-size: 23rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.drawer-more { display: flex; align-items: center; min-height: 88rpx; padding: 0 14rpx; color: #315ee8; font-size: 21rpx; font-weight: 700; text-align: left; box-sizing: border-box; }
.drawer-hint { display: block; margin: 8rpx 12rpx 0; padding-top: 14rpx; border-top: 1rpx solid #eef1f6; color: #667085; font-size: 19rpx; line-height: 1.5; }
@media (prefers-reduced-motion: reduce) { .drawer { transition: none; } }

/* Shared AI conversation prototype visual language. */
