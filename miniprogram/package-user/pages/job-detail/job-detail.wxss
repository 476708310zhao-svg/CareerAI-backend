page {
  --detail-brand: #2563eb;
  --detail-brand-soft: #eff6ff;
  --detail-ai: #6941c6;
  --detail-ai-soft: #f4f3ff;
  --detail-bg: #f4f6f8;
  --detail-panel: #ffffff;
  --detail-title: #101828;
  --detail-body: #475467;
  --detail-muted: #98a2b3;
  --detail-border: #e5e9ef;
  --detail-success: #087f5b;
  --detail-warning: #b54708;
  --detail-danger: #b42318;
  min-height: 100%;
  overflow-x: hidden;
  background: var(--detail-bg);
  color: var(--detail-title);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

.page {
  min-height: 100vh;
  padding: 20rpx 24rpx 0;
  box-sizing: border-box;
  overflow-x: hidden;
  background: var(--detail-bg);
}

.core-card,
.section-card {
  width: 100%;
  margin-bottom: 20rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--detail-border);
  border-radius: 20rpx;
  background: var(--detail-panel);
  box-shadow: 0 8rpx 22rpx rgba(30, 42, 62, 0.055);
}

.core-card {
  padding: 28rpx;
}

.core-title-row,
.core-status-row,
.section-heading-row,
.company-summary-main,
.company-summary-card,
.timeline-row,
.similar-heading {
  display: flex;
  align-items: center;
}

.core-title-row,
.core-status-row,
.section-heading-row,
.company-summary-card,
.similar-heading {
  justify-content: space-between;
}

.core-title {
  min-width: 0;
  flex: 1;
  padding-right: 18rpx;
  color: var(--detail-title);
  font-size: 38rpx;
  font-weight: 850;
  line-height: 1.3;
  word-break: break-word;
}

.core-favorite {
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 64rpx;
  border: 1rpx solid var(--detail-border);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--detail-body);
  background: #f8fafc;
  font-size: 34rpx;
}

.core-favorite.active {
  color: var(--detail-warning);
  border-color: #fde68a;
  background: #fffbeb;
}

.core-salary {
  display: block;
  margin-top: 14rpx;
  color: var(--detail-success);
  font-size: 36rpx;
  font-weight: 850;
  line-height: 1.25;
}

.core-company-line {
  display: block;
  margin-top: 14rpx;
  color: var(--detail-body);
  font-size: 26rpx;
  line-height: 1.55;
  word-break: break-word;
}

.core-tags,
.sponsor-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.core-tags {
  margin-top: 20rpx;
}

.core-tag,
.sponsor-tag {
  max-width: 100%;
  padding: 8rpx 16rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  color: #344054;
  background: #f2f4f7;
  font-size: 22rpx;
  line-height: 1.35;
}

.core-tag-more {
  color: #175cd3;
  background: var(--detail-brand-soft);
}

.core-status-row {
  align-items: flex-end;
  gap: 20rpx;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #edf0f3;
}

.core-aux {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 18rpx;
  color: var(--detail-muted);
  font-size: 22rpx;
}

.core-applied {
  color: var(--detail-success);
  font-weight: 750;
}

.core-deadline,
.timeline-status {
  flex: 0 0 auto;
  color: #175cd3;
  font-size: 23rpx;
  font-weight: 800;
}

.core-deadline--urgent,
.timeline-status--urgent {
  color: var(--detail-warning);
}

.core-deadline--closed,
.timeline-status--closed {
  color: var(--detail-muted);
}

.section-card {
  padding: 26rpx;
}

.company-summary-card {
  gap: 20rpx;
}

.company-summary-main {
  min-width: 0;
  flex: 1;
  gap: 18rpx;
}

.company-summary-logo,
.ap-job-logo-wrap {
  flex: 0 0 auto;
}

.company-summary-copy,
.ap-job-info {
  min-width: 0;
  flex: 1;
}

.company-summary-name,
.company-summary-meta,
.section-kicker,
.section-title,
.match-status,
.match-column-title,
.basic-label,
.basic-value,
.timeline-label,
.timeline-date,
.company-description,
.prepare-title,
.prepare-sub,
.match-kicker,
.match-title,
.score-num,
.score-label,
.score-job,
.score-risk,
.match-section-title,
.match-body,
.match-empty,
.ap-job-title,
.ap-job-company,
.ap-resume-label,
.ap-rname,
.ap-rsub,
.ap-rcontact,
.ap-rskills,
.ap-tip {
  display: block;
}

.company-summary-name {
  overflow: hidden;
  color: var(--detail-title);
  font-size: 29rpx;
  font-weight: 820;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.company-summary-meta {
  margin-top: 8rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.45;
}

.company-link,
.inline-match-action,
.company-expand,
.ap-resume-link {
  flex: 0 0 auto;
  color: #175cd3;
  font-size: 23rpx;
  font-weight: 750;
}

.section-heading-row {
  gap: 20rpx;
  margin-bottom: 22rpx;
}

.section-title {
  color: var(--detail-title);
  font-size: 30rpx;
  font-weight: 850;
  line-height: 1.3;
}

.section-kicker {
  margin-bottom: 4rpx;
  color: var(--detail-ai);
  font-size: 18rpx;
  font-weight: 850;
  letter-spacing: 1.6rpx;
}

.match-summary-card {
  border-color: #d9d6fe;
  background: #fbfaff;
}

.match-score-box {
  flex: 0 0 auto;
  color: var(--detail-ai);
}

.match-score-number {
  font-size: 44rpx;
  font-weight: 900;
}

.match-score-unit {
  margin-left: 2rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.match-status {
  margin-top: -8rpx;
  color: var(--detail-body);
  font-size: 24rpx;
  line-height: 1.5;
}

.match-columns {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 20rpx;
}

.match-column {
  min-width: 0;
  padding: 18rpx;
  border: 1rpx solid #ebe9fe;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.78);
}

.match-column-title {
  margin-bottom: 12rpx;
  color: #344054;
  font-size: 23rpx;
  font-weight: 800;
}

.match-line {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 8rpx;
  color: var(--detail-body);
  font-size: 22rpx;
  line-height: 1.5;
}

.match-dot {
  width: 10rpx;
  height: 10rpx;
  flex: 0 0 10rpx;
  margin-top: 11rpx;
  border-radius: 50%;
}

.match-dot.good {
  background: #12b76a;
}

.match-dot.gap {
  background: #f79009;
}

.inline-match-action,
.company-expand {
  margin-top: 20rpx;
  text-align: right;
}

.basic-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.basic-item {
  min-width: 0;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #f8fafc;
}

.basic-label {
  color: var(--detail-muted);
  font-size: 21rpx;
}

.basic-value {
  margin-top: 8rpx;
  color: #344054;
  font-size: 25rpx;
  font-weight: 750;
  line-height: 1.45;
  word-break: break-word;
}

.content-block {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 16rpx;
}

.content-block:first-of-type {
  margin-top: 0;
}

.content-dot {
  width: 9rpx;
  height: 9rpx;
  flex: 0 0 9rpx;
  margin-top: 16rpx;
  border-radius: 50%;
  background: var(--detail-brand);
}

.content-text {
  min-width: 0;
  flex: 1;
  color: var(--detail-body);
  font-size: 27rpx;
  line-height: 1.82;
  white-space: pre-wrap;
  word-break: break-word;
}

.timeline-row {
  align-items: flex-start;
  gap: 16rpx;
}

.timeline-marker {
  width: 14rpx;
  height: 14rpx;
  flex: 0 0 14rpx;
  margin-top: 10rpx;
  border: 8rpx solid #d1e9ff;
  border-radius: 50%;
  background: #1570ef;
}

.timeline-marker--urgent {
  border-color: #fef0c7;
  background: #f79009;
}

.timeline-marker--closed {
  border-color: #eaecf0;
  background: var(--detail-muted);
}

.timeline-copy {
  min-width: 0;
  flex: 1;
}

.timeline-label {
  color: #344054;
  font-size: 25rpx;
  font-weight: 800;
}

.timeline-date {
  margin-top: 7rpx;
  color: #667085;
  font-size: 23rpx;
}

.sponsor-card {
  border-color: #d9e5ff;
  background: #f7faff;
}

.sponsor-confidence {
  color: #667085;
  font-size: 21rpx;
}

.sponsor-tag {
  color: #067647;
  background: #ecfdf3;
  font-weight: 750;
}

.sponsor-tag--risk {
  color: var(--detail-danger);
  background: #fef3f2;
}

.sponsor-tag--unknown {
  color: var(--detail-body);
  background: #eaecf0;
}

.sponsor-evidence {
  display: block;
  margin-top: 14rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.5;
}

.company-description {
  overflow: hidden;
  color: var(--detail-body);
  font-size: 26rpx;
  line-height: 1.75;
  word-break: break-word;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 5;
}

.company-description.expanded {
  display: block;
  -webkit-line-clamp: unset;
}

.prepare-card {
  padding-bottom: 8rpx;
}

.prepare-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid #edf0f3;
}

.prepare-row:first-of-type {
  border-top: 0;
}

.prepare-title {
  color: #344054;
  font-size: 26rpx;
  font-weight: 800;
}

.prepare-sub {
  margin-top: 7rpx;
  color: var(--detail-muted);
  font-size: 22rpx;
  line-height: 1.45;
}

.prepare-arrow {
  flex: 0 0 auto;
  color: var(--detail-muted);
  font-size: 32rpx;
}

.similar-section {
  margin-top: 6rpx;
}

.similar-heading {
  margin: 0 4rpx 18rpx;
}

.similar-count {
  color: var(--detail-muted);
  font-size: 22rpx;
}

.detail-safe-tail {
  height: calc(148rpx + env(safe-area-inset-bottom));
}

/* Fixed decision bar */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 300;
  min-height: calc(116rpx + env(safe-area-inset-bottom));
  padding: 14rpx 24rpx calc(14rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 14rpx;
  border-top: 1rpx solid var(--detail-border);
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -12rpx 30rpx rgba(15, 23, 42, 0.07);
}

.footer-favorite,
.footer-match,
.footer-apply {
  height: 82rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 850;
}

.footer-favorite {
  width: 104rpx;
  flex: 0 0 104rpx;
  flex-direction: column;
  gap: 2rpx;
  color: var(--detail-body);
  background: var(--detail-panel);
  border: 1rpx solid var(--detail-border);
  font-size: 19rpx;
}

.footer-favorite.active {
  color: var(--detail-warning);
  border-color: #fde68a;
  background: #fffbeb;
}

.footer-favorite-icon {
  font-size: 30rpx;
  line-height: 1;
}

.footer-match {
  width: 180rpx;
  flex: 0 0 180rpx;
  gap: 10rpx;
  color: #344054;
  background: #f8fafc;
  border: 1rpx solid var(--detail-border);
}

.footer-ai {
  width: 42rpx;
  height: 42rpx;
  border-radius: 12rpx;
  color: #ffffff;
  background: var(--detail-ai);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  font-weight: 900;
}

.footer-apply {
  min-width: 0;
  flex: 1;
  color: #ffffff;
  background: var(--detail-brand);
  box-shadow: 0 10rpx 22rpx rgba(37, 99, 235, 0.2);
}

.footer-apply.disabled,
.ap-btn-submit.disabled {
  color: var(--detail-muted);
  background: #eaecf0;
  border-color: #eaecf0;
  box-shadow: none;
}

.footer-apply--pressed,
.tap-muted {
  opacity: 0.72;
}

/* Loading and error */
.detail-skeleton {
  width: 100%;
}

.skeleton-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  background: var(--detail-panel);
}

.skeleton-line,
.skeleton-chip {
  border-radius: 12rpx;
  background: #eaecf0;
}

.skeleton-line {
  height: 28rpx;
  margin-top: 18rpx;
}

.skeleton-title {
  width: 78%;
  height: 42rpx;
  margin-top: 0;
}

.skeleton-salary {
  width: 42%;
  height: 34rpx;
}

.skeleton-meta {
  width: 66%;
}

.skeleton-heading {
  width: 34%;
  height: 34rpx;
  margin-top: 0;
}

.skeleton-body {
  width: 100%;
}

.skeleton-body.short {
  width: 65%;
}

.skeleton-tags {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
}

.skeleton-chip {
  width: 128rpx;
  height: 52rpx;
}

.shimmer {
  position: relative;
  overflow: hidden;
}

.shimmer::after {
  content: '';
  position: absolute;
  inset: 0;
  transform: translateX(-100%);
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.72), transparent);
  animation: detail-shimmer 1.25s infinite;
}

@keyframes detail-shimmer {
  100% { transform: translateX(100%); }
}

.detail-empty {
  min-height: calc(100vh - 40rpx);
  padding: 220rpx 36rpx 80rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.detail-empty-title {
  color: var(--detail-title);
  font-size: 36rpx;
  font-weight: 850;
}

.detail-empty-sub {
  margin-top: 14rpx;
  color: #667085;
  font-size: 25rpx;
  line-height: 1.5;
}

.detail-empty-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 34rpx;
}

.detail-empty-btn {
  height: 76rpx;
  padding: 0 32rpx;
  border-radius: 22rpx;
  color: #ffffff;
  background: var(--detail-brand);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 800;
}

.detail-empty-btn.secondary {
  color: #344054;
  background: var(--detail-panel);
  border: 1rpx solid #d0d5dd;
}

/* AI analysis sheet */
.match-mask,
.apply-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.58);
}

.match-mask {
  z-index: 500;
}

.match-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 501;
  max-height: 86vh;
  padding: 30rpx 34rpx calc(30rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-y: auto;
  border-radius: 34rpx 34rpx 0 0;
  background: var(--detail-panel);
  box-shadow: 0 -22rpx 58rpx rgba(15, 23, 42, 0.18);
}

.match-header,
.match-score-row,
.match-actions,
.ap-header,
.ap-job-row,
.ap-btns {
  display: flex;
  align-items: center;
}

.match-header,
.match-actions,
.ap-header {
  justify-content: space-between;
}

.match-kicker {
  color: var(--detail-ai);
  font-size: 20rpx;
  font-weight: 850;
}

.match-title,
.ap-title {
  margin-top: 5rpx;
  color: var(--detail-title);
  font-size: 34rpx;
  font-weight: 850;
}

.match-close,
.ap-close {
  width: 58rpx;
  height: 58rpx;
  padding: 0;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #344054;
  background: #f2f4f7;
  font-size: 30rpx;
}

.match-score-row {
  gap: 24rpx;
  margin-top: 26rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: var(--detail-ai-soft);
}

.score-ring {
  width: 112rpx;
  height: 112rpx;
  flex: 0 0 112rpx;
  border: 8rpx solid #d9d6fe;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--detail-ai);
  background: var(--detail-panel);
}

.score-num {
  font-size: 40rpx;
  font-weight: 900;
}

.score-label {
  font-size: 18rpx;
}

.match-score-copy {
  min-width: 0;
  flex: 1;
}

.score-job {
  color: var(--detail-title);
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.4;
}

.score-risk {
  margin-top: 8rpx;
  color: #667085;
  font-size: 21rpx;
  line-height: 1.45;
}

.match-section {
  margin-top: 26rpx;
}

.match-section-title {
  margin-bottom: 14rpx;
  color: #344054;
  font-size: 26rpx;
  font-weight: 850;
}

.match-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.match-chip {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: var(--detail-warning);
  background: #fffaeb;
  font-size: 22rpx;
}

.match-body,
.match-empty,
.suggestion-text {
  color: var(--detail-body);
  font-size: 24rpx;
  line-height: 1.65;
}

.match-suggestion {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 12rpx;
}

.suggestion-dot {
  width: 9rpx;
  height: 9rpx;
  flex: 0 0 9rpx;
  margin-top: 14rpx;
  border-radius: 50%;
  background: var(--detail-ai);
}

.match-actions {
  gap: 16rpx;
  margin-top: 30rpx;
}

.match-action {
  height: 82rpx;
  flex: 1;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
}

.match-action.secondary {
  color: #344054;
  background: #f2f4f7;
}

.match-action.primary {
  color: #ffffff;
  background: var(--detail-brand);
}

/* Apply sheet */
.apply-mask {
  z-index: 600;
}

.apply-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 601;
  padding: 34rpx 36rpx calc(34rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-radius: 34rpx 34rpx 0 0;
  background: var(--detail-panel);
  box-shadow: 0 -22rpx 58rpx rgba(15, 23, 42, 0.18);
  transform: translateY(100%);
  transition: transform 0.26s ease;
}

.apply-panel.show {
  transform: translateY(0);
}

.ap-header {
  margin-bottom: 24rpx;
}

.ap-title {
  margin-top: 0;
}

.ap-job-row {
  gap: 18rpx;
  padding: 18rpx;
  border: 1rpx solid var(--detail-border);
  border-radius: 18rpx;
  background: #f8fafc;
}

.ap-job-title {
  overflow: hidden;
  color: var(--detail-title);
  font-size: 26rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ap-job-company {
  margin-top: 7rpx;
  overflow: hidden;
  color: #667085;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ap-resume-card {
  margin-top: 20rpx;
  padding: 22rpx;
  border: 1rpx solid var(--detail-border);
  border-radius: 18rpx;
  background: var(--detail-panel);
}

.ap-resume-label {
  margin-bottom: 14rpx;
  color: #667085;
  font-size: 21rpx;
}

.ap-rname {
  color: var(--detail-title);
  font-size: 27rpx;
  font-weight: 850;
}

.ap-rsub,
.ap-rcontact,
.ap-rskills,
.ap-resume-empty {
  margin-top: 8rpx;
  color: var(--detail-body);
  font-size: 22rpx;
  line-height: 1.5;
}

.ap-resume-link {
  display: inline-block;
  margin-top: 12rpx;
}

.ap-btns {
  gap: 16rpx;
  margin-top: 24rpx;
}

.ap-btn-cancel,
.ap-btn-submit {
  height: 82rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 850;
}

.ap-btn-cancel {
  width: 30%;
  color: #344054;
  background: #f2f4f7;
}

.ap-btn-submit {
  min-width: 0;
  flex: 1;
  color: #ffffff;
  background: var(--detail-brand);
}

.ap-tip {
  margin-top: 16rpx;
  color: #667085;
  font-size: 21rpx;
  line-height: 1.5;
}

@media (max-width: 340px) {
  .match-columns,
  .basic-grid {
    grid-template-columns: 1fr;
  }

  .footer-match {
    width: 148rpx;
    flex-basis: 148rpx;
  }
}
