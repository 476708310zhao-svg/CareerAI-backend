.page{min-height:100vh;padding:28rpx;background:#f5f7fb;box-sizing:border-box;color:#182133}.card{background:#fff;border-radius:20rpx;padding:28rpx;margin-bottom:20rpx}.title{display:block;font-size:36rpx;font-weight:700;margin-bottom:14rpx}.hint{display:block;color:#657087;font-size:25rpx;line-height:1.6;margin:12rpx 0}.choice{padding:20rpx 0;border-bottom:1rpx solid #edf0f5;font-size:28rpx}.input{box-sizing:border-box;width:100%;min-height:150rpx;border:1rpx solid #dce2ed;border-radius:12rpx;padding:16rpx;margin:18rpx 0}.request{display:flex;flex-direction:column;gap:8rpx;padding:16rpx 0;border-bottom:1rpx solid #edf0f5}.error{color:#b42318;padding:18rpx}.notice{color:#13755d;padding:18rpx}
