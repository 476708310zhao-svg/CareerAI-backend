<!-- pages/feedback/feedback.wxml -->
<view class="container">
  <view class="feedback-hero">
    <view>
      <text class="hero-title">意见反馈</text>
      <text class="hero-sub">描述问题或建议，帮助我们定位和改进。</text>
    </view>
  </view>

  <view class="support-card">
    <view class="support-main">
      <text class="support-title">需要马上沟通？</text>
      <text class="support-desc">可以直接进入微信客服会话，适合账号、会员、投递和紧急问题。</text>
    </view>
    <button
      class="support-contact-btn"
      open-type="contact"
      session-from="feedback"
      show-message-card="true"
      send-message-title="职引客服"
      send-message-path="/package-user/pages/feedback/feedback"
    >联系客服</button>
  </view>

  <view class="form-section">
    <view class="section-head">
      <text class="label">反馈类型</text>
      <text class="section-tip">选择最接近的一类，方便我们更快定位</text>
    </view>
    <view class="type-grid">
      <block wx:for="{{typeOptions}}" wx:key="label">
        <view class="type-card {{typeIndex === index ? 'active' : ''}}" bindtap="selectType" data-index="{{index}}">
          <view class="type-body">
            <text class="type-title">{{item.label}}</text>
            <text class="type-desc">{{item.desc}}</text>
          </view>
        </view>
      </block>
    </view>
  </view>

  <view class="form-section">
    <view class="section-head">
      <text class="label">反馈内容</text>
      <text class="section-tip">请尽量说明页面、操作步骤和期望结果</text>
    </view>
    <textarea class="textarea" placeholder="例如：在职位详情页点击收藏后没有状态反馈，希望能增加收藏成功提示..." maxlength="500" value="{{content}}" bindinput="onContentInput"></textarea>
    <view class="textarea-foot">
      <text class="helper-text">至少 10 个字</text>
      <text class="char-count {{content.length >= 450 ? 'warn' : ''}}">{{content.length}}/500</text>
    </view>
  </view>

  <view class="form-section">
    <view class="section-head">
      <text class="label">联系方式（选填）</text>
      <text class="section-tip">需要进一步确认时才会联系你</text>
    </view>
    <input class="input" placeholder="邮箱或微信号，方便我们联系您" value="{{contact}}" bindinput="onContactInput" />
  </view>

  <view class="feedback-error" wx:if="{{submitError}}" aria-role="alert">{{submitError}}</view>

  <view class="submit-wrap">
    <c-button class="submit-btn" bindtap="submitFeedback" disabled="{{submitting}}" loading="{{submitting}}">
      {{submitting ? '提交中...' : '提交反馈'}}
    </c-button>
  </view>

  <view class="feedback-history" aria-label="我的反馈记录">
    <view class="history-heading">
      <view><text class="history-title">我的反馈</text><text class="history-sub">官网与小程序使用同一账号时，可查看同一批处理状态。</text></view>
      <button class="history-refresh" bindtap="refreshHistory" disabled="{{historyLoading || historyAuthRequired}}">刷新</button>
    </view>
    <view class="history-state" wx:if="{{historyAuthRequired}}">{{historyError || '登录后可查看自己的反馈记录。'}}</view>
    <view class="history-state" wx:elif="{{historyLoading &amp;&amp; history.length === 0}}" role="status">正在加载反馈记录…</view>
    <view class="history-state history-error" wx:elif="{{historyError}}" role="alert">
      <text>{{historyError}}</text><button bindtap="retryHistory">重试</button>
    </view>
    <view class="history-state" wx:elif="{{history.length === 0}}">还没有反馈记录。提交后可在这里查看处理进度。</view>
    <block wx:for="{{history}}" wx:key="id">
      <view class="history-item">
        <view class="history-item-head"><text class="history-type">{{item.type}}</text><text class="history-status status-{{item.status}}">{{item.statusLabel}}</text></view>
        <text class="history-content">{{item.content}}</text>
        <text class="history-meta">{{item.createdAt}}{{item.jobId ? ' · 岗位 ' + item.jobId : ''}}</text>
      </view>
    </block>
    <button class="history-more" wx:if="{{nextCursor &amp;&amp; !historyError}}" bindtap="loadMoreHistory" disabled="{{historyLoading}}">{{historyLoading ? '加载中…' : '加载更多'}}</button>
  </view>
</view>
