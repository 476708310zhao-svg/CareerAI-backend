<!-- pages/messages/messages.wxml -->
<view class="container">

  <view class="message-hero">
    <view>
      <text class="hero-title">消息通知</text>
      <text class="hero-sub">查看申请、互动和系统消息</text>
    </view>
    <view class="hero-count">
      <text class="count-num">{{syncError ? '—' : unreadTotal}}</text>
      <text class="count-label">{{syncError ? '未同步' : '未读'}}</text>
    </view>
  </view>

  <!-- Tab 栏 -->
  <view class="tab-bar">
    <block wx:for="{{tabs}}" wx:key="*this">
      <view class="tab-item {{currentTab === index ? 'active' : ''}}" bindtap="switchTab" data-index="{{index}}">
        <text>{{item}}</text>
        <text class="tab-count">{{syncError ? '—' : (tabCounts[index] || 0)}}</text>
      </view>
    </block>
    <view class="read-all-btn" wx:if="{{unreadTotal > 0}}" bindtap="markAllRead">全部已读</view>
  </view>

  <!-- 消息列表 -->
  <view class="message-list">
    <view class="message-state" wx:if="{{loading}}">正在加载消息…</view>
    <view class="message-warning" wx:if="{{syncError}}"><text>暂时无法同步消息。</text><text class="message-retry" bindtap="loadMessages" aria-role="button">重试</text></view>
    <block wx:for="{{filteredMessages}}" wx:key="id">
      <view class="message-card {{item.isRead ? 'read' : 'unread'}}" bindtap="tapMessage" data-index="{{index}}">
        <!-- 未读红点 -->
        <view class="unread-dot" wx:if="{{!item.isRead}}"></view>

        <!-- 图标 -->
        <view class="msg-icon-wrap">
          <image class="msg-icon-img" src="{{item.icon}}" mode="aspectFit" lazy-load></image>
        </view>

        <!-- 内容 -->
        <view class="msg-body">
          <view class="msg-top">
            <text class="msg-title">{{item.title}}</text>
            <text class="msg-time">{{item.createdAt}}</text>
          </view>
          <text class="msg-content">{{item.content}}</text>
        </view>
      </view>
    </block>

    <!-- 空状态 -->
    <view wx:if="{{!loading && filteredMessages.length === 0}}" class="empty">
      <text class="empty-text">{{syncError ? '消息暂不可用' : '暂无消息'}}</text>
      <text class="empty-sub">{{syncError ? '请检查网络后重试。' : '新的申请、互动与系统消息会出现在这里。'}}</text>
      <view class="empty-actions">
        <view class="empty-action primary" bindtap="goApplications">查看网申</view>
      </view>
    </view>
  </view>

</view>
