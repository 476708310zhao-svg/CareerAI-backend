page {
  background: var(--zy-bg);
  color: var(--zy-ink);
  font-family: -apple-system, 'PingFang SC', sans-serif;
}

.container {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--zy-bg);
}

.message-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 116rpx;
  padding: 20rpx 26rpx;
  border: 1rpx solid var(--zy-line);
  border-radius: var(--zy-radius-md);
  background: var(--zy-surface);
  box-shadow: var(--zy-shadow-card);
}

.summary-copy {
  flex: 1;
  min-width: 0;
}

.summary-eyebrow,
.summary-title,
.tab-label,
.msg-title,
.msg-content,
.empty-text,
.empty-sub {
  display: block;
}

.summary-eyebrow {
  color: var(--zy-muted);
  font-size: 23rpx;
  line-height: 32rpx;
}

.summary-title {
  margin-top: 4rpx;
  color: var(--zy-ink);
  font-size: 34rpx;
  line-height: 46rpx;
  font-weight: 750;
}

.read-all-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-height: 88rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  background: var(--zy-brand-soft);
  color: var(--zy-brand-deep);
  font-size: 26rpx;
  font-weight: 700;
}

.read-all-btn:active {
  background: #dce8ff;
}

.tab-bar {
  display: flex;
  align-items: stretch;
  gap: 4rpx;
  margin-top: 20rpx;
  padding: 8rpx;
  border: 1rpx solid var(--zy-line);
  border-radius: 24rpx;
  background: var(--zy-surface);
}

.tab-item {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-width: 0;
  min-height: 88rpx;
  gap: 5rpx;
  padding: 8rpx 2rpx;
  border-radius: 18rpx;
  color: var(--zy-muted);
  font-size: 28rpx;
  font-weight: 600;
  white-space: nowrap;
}

.tab-item.active {
  background: var(--zy-brand-soft);
  color: var(--zy-brand-deep);
  font-weight: 750;
}

.tab-item:active {
  background: var(--zy-brand-soft);
}

.tab-count {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 4rpx;
  border-radius: 999rpx;
  background: #e8edf6;
  color: var(--zy-ink-2);
  font-size: 19rpx;
  line-height: 28rpx;
  font-weight: 700;
}

.tab-item.active .tab-count {
  background: var(--zy-brand);
  color: #fff;
}

.message-list {
  padding-top: 20rpx;
}

.message-card {
  position: relative;
  box-sizing: border-box;
  margin-bottom: 16rpx;
  padding: 26rpx 28rpx;
  overflow: hidden;
  border: 1rpx solid var(--zy-line);
  border-radius: var(--zy-radius-md);
  background: var(--zy-surface);
  box-shadow: var(--zy-shadow-card);
}

.message-card.unread::before {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 5rpx;
  background: var(--zy-brand);
}

.message-card:active {
  background: var(--zy-surface-soft);
}

.msg-header {
  display: flex;
  align-items: center;
  min-height: 64rpx;
  margin-bottom: 16rpx;
}

.msg-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  margin-right: 14rpx;
  border-radius: 18rpx;
  background: var(--zy-brand-soft);
}

.type-payment .msg-icon-wrap {
  background: var(--zy-warning-soft);
}

.type-application .msg-icon-wrap {
  background: var(--zy-success-soft);
}

.msg-icon-img {
  width: 34rpx;
  height: 34rpx;
}

.msg-type {
  color: var(--zy-ink-2);
  font-size: 24rpx;
  font-weight: 700;
}

.msg-time {
  margin-left: auto;
  color: var(--zy-muted);
  font-size: 23rpx;
  white-space: nowrap;
}

.unread-dot {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  margin-left: 12rpx;
  border-radius: 50%;
  background: var(--zy-brand);
}

.msg-title {
  color: var(--zy-ink);
  font-size: 32rpx;
  line-height: 46rpx;
  font-weight: 750;
}

.msg-content {
  margin-top: 8rpx;
  color: var(--zy-ink-2);
  font-size: 30rpx;
  line-height: 46rpx;
  overflow-wrap: anywhere;
}

.msg-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 52rpx;
  margin-top: 18rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--zy-line);
  color: var(--zy-brand-deep);
  font-size: 24rpx;
  font-weight: 700;
}

.msg-chevron {
  font-size: 36rpx;
  line-height: 32rpx;
}

.message-state,
.message-warning {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  margin-bottom: 16rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--zy-line);
  border-radius: 20rpx;
  background: var(--zy-surface);
  color: var(--zy-ink-2);
  font-size: 26rpx;
}

.message-warning {
  border-color: #f5dfbd;
  background: var(--zy-warning-soft);
  color: var(--zy-warning);
}

.message-retry {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  min-height: 88rpx;
  margin-left: 16rpx;
  color: var(--zy-brand-deep);
  font-weight: 700;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 4rpx;
  padding: 68rpx 26rpx;
  border: 1rpx solid var(--zy-line);
  border-radius: var(--zy-radius-md);
  background: var(--zy-surface);
  text-align: center;
}

.empty-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
  background: var(--zy-brand-soft);
}

.empty-icon {
  width: 42rpx;
  height: 42rpx;
}

.empty-text {
  margin-top: 20rpx;
  color: var(--zy-ink);
  font-size: 30rpx;
  font-weight: 750;
}

.empty-sub {
  max-width: 520rpx;
  margin-top: 10rpx;
  color: var(--zy-muted);
  font-size: 25rpx;
  line-height: 38rpx;
}

.empty-actions {
  margin-top: 26rpx;
}

.empty-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 176rpx;
  min-height: 88rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: var(--zy-brand-soft);
  color: var(--zy-brand-deep);
  font-size: 26rpx;
  font-weight: 700;
}
