<view class="container">
  <view class="settings-hero">
    <text class="hero-title">账号与设置</text>
    <text class="hero-sub">管理登录、消息、本机缓存和个人数据。</text>
  </view>

  <view class="setting-section">
    <view class="section-head"><text class="section-title">账号</text></view>
    <view class="setting-card">
      <view class="setting-row link" bindtap="loginOnComputer" aria-role="button">
        <view class="setting-main"><text class="setting-title">登录电脑工作台</text><text class="setting-desc">生成一次性登录码，在电脑继续管理申请和简历</text></view><text class="arrow">›</text>
      </view>
    </view>
  </view>

  <view class="setting-section">
    <view class="section-head"><text class="section-title">消息与存储</text></view>
    <view class="setting-card">
      <view class="setting-row link" bindtap="goToMessages" aria-role="button">
        <view class="setting-main"><text class="setting-title">消息通知</text><text class="setting-desc">查看申请、互动和系统消息</text></view><text class="arrow">›</text>
      </view>
      <view class="setting-row link" bindtap="clearCache" aria-role="button">
        <view class="setting-main"><text class="setting-title">清除本机缓存</text><text class="setting-desc">清理搜索和浏览记录，不影响账号资料</text></view>
        <view class="row-right"><text class="cache-size">{{cacheSize}}</text><text class="arrow">›</text></view>
      </view>
    </view>
  </view>

  <view class="setting-section">
    <view class="section-head"><text class="section-title">帮助与隐私</text></view>
    <view class="setting-card">
      <view class="setting-row link" bindtap="goToFeedback" aria-role="button"><view class="setting-main"><text class="setting-title">意见反馈</text></view><text class="arrow">›</text></view>
      <view class="setting-row link" bindtap="goToAbout" aria-role="button"><view class="setting-main"><text class="setting-title">关于我们</text></view><text class="arrow">›</text></view>
      <view class="setting-row link" bindtap="goToPrivacy" aria-role="button"><view class="setting-main"><text class="setting-title">隐私政策</text></view><text class="arrow">›</text></view>
      <view class="setting-row link" bindtap="openWechatPrivacy" aria-role="button"><view class="setting-main"><text class="setting-title">微信隐私保护指引</text></view><text class="arrow">›</text></view>
    </view>
  </view>

  <view class="setting-section">
    <view class="section-head"><text class="section-title">数据管理</text><text class="section-sub">删除操作会先请你确认</text></view>
    <view class="setting-card">
      <view class="setting-row link" bindtap="requestDataDeletion" aria-role="button"><view class="setting-main"><text class="setting-title">了解数据处理范围</text><text class="setting-desc">查看可自助清理的内容</text></view><text class="arrow">›</text></view>
      <view class="setting-row link" bindtap="clearAiLocalRecords" aria-role="button"><view class="setting-main"><text class="setting-title">删除本机 AI 与语音记录</text><text class="setting-desc">清理本机对话、报告和复盘缓存</text></view><text class="arrow">›</text></view>
      <view class="setting-row link" bindtap="deleteServerData" aria-role="button"><view class="setting-main"><text class="setting-title">清空服务端个人数据</text><text class="setting-desc">删除简历、进度、收藏和相关记录</text></view><text class="arrow">›</text></view>
      <view class="setting-row link" bindtap="deleteAccount" aria-role="button"><view class="setting-main"><text class="setting-title danger-title">注销账号</text><text class="setting-desc">删除账号和个人业务数据，无法恢复</text></view><text class="arrow">›</text></view>
    </view>
  </view>

  <view class="status-card"><text class="status-desc">清除本机缓存不会影响已保存的简历、收藏和账号信息。</text></view>
</view>

<c-login-popup show="{{authPromptVisible}}" subtitle="{{authPromptSubtitle}}" bindclose="closeAuthPrompt" bindsuccess="onAuthPromptSuccess"/>
