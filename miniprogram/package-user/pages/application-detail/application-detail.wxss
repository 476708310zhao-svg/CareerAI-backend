page { background: #F5F7FB; color: #101828; font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif; }
.page { padding: 24rpx 24rpx 160rpx; }
.loading, .empty { padding: 100rpx 20rpx; color: #667085; text-align: center; font-size: 26rpx; }
.hero { position: relative; padding: 32rpx; border-radius: 28rpx; color: #fff; background: linear-gradient(135deg, #1D4ED8, #4F46E5); box-shadow: 0 18rpx 44rpx rgba(37, 99, 235, .22); }
.hero-main { display: flex; flex-direction: column; padding-right: 150rpx; }
.hero-kicker { color: #BFDBFE; font-size: 20rpx; font-weight: 800; letter-spacing: 2rpx; }
.hero-title { margin-top: 12rpx; font-size: 36rpx; font-weight: 900; line-height: 1.3; }
.hero-company { margin-top: 10rpx; color: #DBEAFE; font-size: 25rpx; }
.status-pill { position: absolute; top: 30rpx; right: 28rpx; padding: 9rpx 18rpx; border-radius: 999rpx; color: #172554; background: #fff; font-size: 22rpx; font-weight: 800; }
.hero-action { margin-top: 28rpx; font-size: 24rpx; font-weight: 700; }
.context-ai-action { display: flex; align-items: center; width: fit-content; min-height: 72rpx; margin-top: 18rpx; padding: 0 22rpx; border: 1rpx solid rgba(255,255,255,.34); border-radius: 999rpx; background: rgba(255,255,255,.15); box-shadow: inset 0 1rpx 0 rgba(255,255,255,.2); }
.primary-action-bar { display: flex; align-items: center; justify-content: space-between; margin-top: 18rpx; padding: 22rpx 26rpx; border: 1rpx solid #BFDBFE; border-radius: 20rpx; color: #1E3A8A; background: #EFF6FF; box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, .10); }
.primary-action-copy { display: flex; flex-direction: column; gap: 6rpx; }
.primary-action-kicker { color: #64748B; font-size: 21rpx; }
.primary-action-label { font-size: 29rpx; font-weight: 850; }
.primary-action-arrow { font-size: 42rpx; line-height: 1; }
.section-card, .match-card { margin-top: 22rpx; padding: 28rpx; border: 1rpx solid #EAECF0; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 28rpx rgba(16, 24, 40, .05); }
.match-card { display: flex; align-items: center; gap: 24rpx; }
.match-score { display: flex; align-items: baseline; justify-content: center; width: 112rpx; height: 112rpx; border-radius: 50%; color: #1D4ED8; background: #EFF6FF; font-size: 22rpx; font-weight: 800; }
.match-num { margin-top: 27rpx; font-size: 42rpx; font-weight: 900; }
.match-copy, .task-copy, .contact-copy, .timeline-copy { display: flex; flex: 1; flex-direction: column; gap: 7rpx; min-width: 0; }
.match-gap { color: #B54708; font-size: 22rpx; }
.match-action { align-self: flex-end; padding: 10rpx 14rpx; border-radius: 999rpx; color: #1D4ED8; background: #EFF6FF; font-size: 21rpx; font-weight: 800; }
.match-start-btn { margin-top: 0; text-align: center; line-height: 76rpx; }
.section-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.card-title { font-size: 29rpx; font-weight: 850; }
.section-note, .muted { color: #667085; font-size: 22rpx; line-height: 1.45; }
.field, .textarea { width: 100%; box-sizing: border-box; margin-top: 14rpx; padding: 0 20rpx; border: 1rpx solid #D0D5DD; border-radius: 16rpx; color: #101828; background: #F9FAFB; font-size: 25rpx; }
.field { height: 76rpx; line-height: 76rpx; }
.textarea { min-height: 150rpx; padding-top: 18rpx; line-height: 1.6; }
.date-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }
.picker { color: #475467; }
.follow-up-card .date-grid > view { min-width: 0; }
.follow-up-card .picker { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.clear-date { padding: 6rpx 0; margin: 0; color: #667085; background: transparent; font-size: 22rpx; text-align: left; }
.clear-date::after { border: 0; }
.load-error { color: #B54708; font-size: 26rpx; }
.primary-btn, .secondary-btn { margin-top: 20rpx; border: 0; border-radius: 16rpx; font-size: 27rpx; font-weight: 800; }
.primary-btn { color: #fff; background: #2563EB; }
.secondary-btn { color: #1D4ED8; background: #EFF6FF; }
.task-item, .contact-item, .timeline-item, .material-item { display: flex; align-items: flex-start; gap: 16rpx; padding: 18rpx 0; border-bottom: 1rpx solid #F2F4F7; font-size: 25rpx; }
.task-item.completed { opacity: .58; }
.task-check { width: 36rpx; height: 36rpx; border: 2rpx solid #2563EB; border-radius: 50%; color: #fff; background: #2563EB; text-align: center; line-height: 34rpx; }
.completed .task-copy > text:first-child { text-decoration: line-through; }
.inline-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.compact { width: 220rpx; }
.priority-row { display: flex; gap: 10rpx; }
.priority { padding: 10rpx 18rpx; border-radius: 999rpx; color: #475467; background: #F2F4F7; font-size: 22rpx; }
.priority.active { color: #fff; background: #2563EB; }
.contact-avatar { width: 64rpx; height: 64rpx; border-radius: 18rpx; color: #1D4ED8; background: #DBEAFE; text-align: center; line-height: 64rpx; font-weight: 900; }
.timeline-item { position: relative; padding-left: 6rpx; }
.timeline-dot { width: 18rpx; height: 18rpx; margin-top: 8rpx; border: 6rpx solid #DBEAFE; border-radius: 50%; background: #2563EB; }
.material-item { justify-content: space-between; }
.application-pack-note { display: block; margin-top: 6rpx; max-width: 500rpx; }
.application-pack-actions { display: flex; gap: 14rpx; margin-top: 18rpx; }
.pack-btn { flex: 1; margin-top: 0; text-align: center; line-height: 76rpx; }
.transition-row { display: flex; flex-wrap: wrap; gap: 14rpx; }
.transition-btn { padding: 16rpx 24rpx; border: 1rpx solid #BFDBFE; border-radius: 999rpx; color: #1D4ED8; background: #EFF6FF; font-size: 24rpx; font-weight: 800; }
.submission-card { border-color: #BFDBFE; background: #F8FAFF; }
.submission-help, .submission-note, .submission-done, .submission-error { display: block; font-size: 24rpx; line-height: 1.55; }
.submission-help, .submission-note { color: #475467; }
.submission-note, .submission-done, .submission-error { margin-top: 14rpx; }
.submission-done { color: #166534; font-weight: 800; }
.submission-error { color: #B42318; }
.submission-action, .submission-secondary { min-height: 88rpx; margin: 20rpx 0 0; padding: 12rpx 24rpx; border-radius: 16rpx; font-size: 26rpx; font-weight: 800; line-height: 1.35; }
.submission-action::after, .submission-secondary::after { border: 0; }
.submission-action { color: #fff; background: #2563EB; }
.submission-secondary { color: #1D4ED8; background: #DBEAFE; }
.submission-review { margin-top: 18rpx; padding: 20rpx; border-radius: 16rpx; background: #fff; }
.submission-review > text { color: #344054; font-size: 24rpx; line-height: 1.55; }
.submission-check { display: flex; align-items: center; gap: 12rpx; margin-top: 18rpx; color: #101828; font-size: 23rpx; line-height: 1.4; }
.submission-buttons { display: flex; gap: 14rpx; }
.submission-buttons button { flex: 1; min-width: 0; }
.readiness-card { border-color: #dce5f4; background: #f8faff; }
.readiness-help, .readiness-empty, .readiness-error { display: block; color: #475467; font-size: 24rpx; line-height: 1.55; }
.readiness-empty { margin: 18rpx 0; }
.readiness-error { margin-top: 14rpx; color: #b42318; }
.readiness-resume, .readiness-checklist { margin-top: 22rpx; }
.readiness-checklist { padding-top: 20rpx; border-top: 1rpx solid #dce5f4; }
.readiness-label { display: block; margin-bottom: 12rpx; color: #172554; font-size: 27rpx; font-weight: 800; }
.readiness-picker, .readiness-add input, .readiness-edit input { min-height: 88rpx; box-sizing: border-box; padding: 20rpx; border: 1rpx solid #bdcde7; border-radius: 16rpx; color: #101828; background: #fff; font-size: 26rpx; }
.readiness-picker { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.readiness-button, .readiness-secondary, .readiness-item-actions button, .readiness-edit button, .readiness-add button { min-height: 88rpx; box-sizing: border-box; padding: 16rpx 22rpx; border: 0; border-radius: 16rpx; font-size: 25rpx; font-weight: 800; line-height: 1.3; }
.readiness-button, .readiness-add button { margin: 18rpx 0 0; color: #fff; background: #2563eb; }
.readiness-secondary, .readiness-item-actions button, .readiness-edit button { margin: 10rpx 0 0; color: #1d4ed8; background: #eaf1ff; }
.readiness-button::after, .readiness-secondary::after, .readiness-item-actions button::after, .readiness-edit button::after, .readiness-add button::after { border: 0; }
.readiness-button[disabled], .readiness-secondary[disabled], .readiness-item-actions button[disabled], .readiness-edit button[disabled], .readiness-add button[disabled] { opacity: .55; }
.readiness-item { padding: 20rpx 0; border-bottom: 1rpx solid #e4eaf4; }
.readiness-item-label { display: block; color: #101828; font-size: 26rpx; font-weight: 700; overflow-wrap: anywhere; }
.readiness-item-actions, .readiness-edit { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; }
.readiness-item-actions { margin-top: 12rpx; }
.readiness-item-actions button, .readiness-edit button { margin-top: 0; }
.readiness-state { min-height: 88rpx; box-sizing: border-box; padding: 24rpx 14rpx; border-radius: 12rpx; color: #1d4ed8; background: #eaf1ff; font-size: 25rpx; font-weight: 700; }
.readiness-edit input { flex: 1; min-width: 220rpx; }
.readiness-add { margin-top: 20rpx; }
.readiness-add input { width: 100%; }
