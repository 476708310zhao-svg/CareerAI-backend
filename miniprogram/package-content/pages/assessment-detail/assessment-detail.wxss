@import "../../assessment-shared.wxss";

.detail-page { padding-top: 20rpx; }
.detail-preview-note { margin-bottom: 18rpx; padding: 14rpx 18rpx; border-radius: 14rpx; background: #fff5e7; color: #985a10; font-size: 23rpx; line-height: 34rpx; }
.detail-cover { display: flex; align-items: center; justify-content: space-between; width: 100%; height: 340rpx; box-sizing: border-box; padding: 28rpx 32rpx; border-radius: 26rpx; color: #fff; background: linear-gradient(120deg, var(--cover-strong) 0%, var(--cover-deep) 100%); box-shadow: 0 16rpx 34rpx rgba(38, 64, 130, .12); }
.detail-cover::before { position: absolute; top: -92rpx; right: -68rpx; width: 310rpx; height: 310rpx; border: 34rpx solid rgba(255,255,255,.13); border-radius: 50%; content: ''; }
.detail-cover-copy { position: relative; z-index: 1; display: flex; flex: 1; min-width: 0; flex-direction: column; }
.detail-cover-eyebrow { font-size: 23rpx; font-weight: 700; line-height: 34rpx; opacity: .9; }
.detail-cover-company { display: block; overflow: hidden; margin-top: 12rpx; font-size: 60rpx; font-weight: 850; line-height: 76rpx; text-overflow: ellipsis; white-space: nowrap; }
.detail-cover-season { display: inline-block; align-self: flex-start; max-width: 100%; overflow: hidden; margin-top: 18rpx; padding: 7rpx 14rpx; border: 1rpx solid rgba(255,255,255,.36); border-radius: 10rpx; background: rgba(255,255,255,.14); font-size: 23rpx; line-height: 32rpx; text-overflow: ellipsis; white-space: nowrap; }
.detail-cover-stack { position: relative; z-index: 1; flex: none; width: 176rpx; height: 210rpx; margin-left: 12rpx; }
.detail-cover-sheet { position: absolute; width: 134rpx; height: 184rpx; border: 1rpx solid rgba(255,255,255,.65); border-radius: 13rpx; background: rgba(255,255,255,.82); box-shadow: 0 12rpx 30rpx rgba(27,39,87,.16); }
.detail-cover-sheet-back { top: 5rpx; right: 13rpx; transform: rotate(13deg); opacity: .57; }
.detail-cover-sheet-front { display: flex; flex-direction: column; justify-content: center; gap: 14rpx; top: 13rpx; left: 10rpx; padding: 22rpx; transform: rotate(-8deg); }
.detail-cover-sheet-front view { height: 6rpx; border-radius: 6rpx; background: var(--cover-strong); opacity: .45; }
.detail-cover-sheet-front view:first-child { width: 44rpx; height: 44rpx; border-radius: 10rpx; opacity: .8; }
.detail-cover-sheet-front view:last-child { width: 65%; }

.detail-overview { margin-top: 18rpx; padding: 28rpx 26rpx; border: 1rpx solid var(--zy-line, #e2e8f3); border-radius: 24rpx; background: #fff; }
.detail-title { display: block; color: var(--zy-ink, #111827); font-size: 35rpx; font-weight: 750; line-height: 48rpx; overflow-wrap: anywhere; }
.detail-meta { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 16rpx; }
.detail-meta-pill { max-width: 100%; box-sizing: border-box; overflow: hidden; padding: 6rpx 14rpx; border-radius: 10rpx; background: #edf3ff; color: #3158b6; font-size: 23rpx; line-height: 32rpx; text-overflow: ellipsis; white-space: nowrap; }
.detail-meta-season { background: #f3f5f9; color: #5c687b; }
.detail-overview-price { display: flex; align-items: baseline; justify-content: space-between; margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid #edf0f5; }
.detail-price-label { color: #667085; font-size: 24rpx; line-height: 36rpx; }
.detail-price { font-size: 42rpx; line-height: 52rpx; }
.detail-summary { display: block; margin-top: 12rpx; color: #48566b; font-size: 25rpx; line-height: 39rpx; white-space: pre-wrap; overflow-wrap: anywhere; }

.detail-section { margin: 18rpx 0 0; padding: 26rpx 24rpx; border-radius: 24rpx; }
.detail-section-heading { display: flex; align-items: center; gap: 12rpx; margin-bottom: 18rpx; }
.detail-section-heading .a-section-title { margin: 0; font-size: 29rpx; line-height: 40rpx; }
.detail-section-mark { flex: none; width: 7rpx; height: 26rpx; border-radius: 6rpx; background: var(--zy-brand, #315ee8); }
.detail-body-text { color: #344054; font-size: 26rpx; line-height: 43rpx; }
.detail-inset { padding: 18rpx 20rpx; border-radius: 16rpx; background: #f5f8ff; }
.detail-info-line { display: block; margin-top: 14rpx; color: #526176; font-size: 25rpx; line-height: 40rpx; white-space: pre-wrap; overflow-wrap: anywhere; }
.detail-inset + .detail-info-line { margin-top: 18rpx; }
.sample-image { display: block; width: 100%; margin-top: 16rpx; border-radius: 14rpx; background: #f3f6fb; }

.detail-status { margin-top: 18rpx; padding: 20rpx 24rpx; border-radius: 18rpx; font-size: 25rpx; line-height: 38rpx; }
.detail-status-warning { background: #fff6e9; color: #895610; }
.detail-status-success { background: #eaf8f2; color: #087a55; }
.detail-status-title { display: block; font-weight: 700; }
.detail-status-copy { display: block; margin-top: 4rpx; }
.detail-purchases { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; box-sizing: border-box; margin-top: 18rpx; padding: 0 24rpx; border: 1rpx solid var(--zy-line, #e2e8f3); border-radius: 20rpx; background: #fff; color: var(--zy-brand, #315ee8); font-size: 26rpx; font-weight: 600; }
.detail-purchases-arrow { color: #91a2bd; font-size: 42rpx; font-weight: 400; line-height: 1; }
.detail-spacer { height: calc(170rpx + env(safe-area-inset-bottom)); }
.detail-footer { position: fixed; z-index: 8; bottom: 0; left: 0; right: 0; display: flex; align-items: center; gap: 24rpx; box-sizing: border-box; padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e2e8f3; background: #fff; box-shadow: 0 -8rpx 28rpx rgba(26, 45, 92, .05); }
.detail-footer-price { display: flex; flex: none; flex-direction: column; min-width: 120rpx; gap: 2rpx; }
.detail-footer-label { color: #667085; font-size: 22rpx; line-height: 30rpx; }
.detail-footer-price .a-price { font-size: 31rpx; line-height: 42rpx; }
.detail-footer .a-button { flex: 1; min-width: 0; margin: 0; font-size: 27rpx; }
