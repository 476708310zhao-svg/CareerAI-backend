:host{display:block;width:100%}
.job-card{display:flex;position:relative;width:100%;min-height:216rpx;margin-bottom:20rpx;padding:26rpx 30rpx 24rpx 24rpx;border:1rpx solid rgba(218,228,245,.86);border-radius:28rpx;background:rgba(255,255,255,.96);box-shadow:0 14rpx 36rpx rgba(71,104,166,.055);box-sizing:border-box;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif}
.job-card--pressed{opacity:.82}
.job-card--closed{opacity:.64}
.job-card__logo-wrap{display:flex;align-items:flex-start;justify-content:center;flex:0 0 92rpx;width:92rpx;height:92rpx;border:1rpx solid #dbe7fb;border-radius:18rpx;background:#fff;overflow:hidden}
.job-card__logo{width:92rpx!important;height:92rpx!important;border-radius:18rpx!important;box-shadow:none!important}
.job-card__body{flex:1;min-width:0;margin-left:28rpx;padding-right:48rpx}
.job-card__headline{display:flex;align-items:center;gap:12rpx;min-width:0}
.job-card__title{overflow:hidden;color:#11182c;font-size:30rpx;font-weight:600;line-height:42rpx;text-overflow:ellipsis;white-space:nowrap}
.job-card__related{flex-shrink:0;padding:4rpx 13rpx;border-radius:8rpx;color:#1266f1;background:#eaf3ff;font-size:24rpx;font-weight:600;line-height:30rpx}
.job-card__company{display:block;overflow:hidden;margin-top:3rpx;color:#6f83aa;font-size:25rpx;line-height:36rpx;text-overflow:ellipsis;white-space:nowrap}
.job-card__tags{display:flex;gap:10rpx;overflow:hidden;margin-top:12rpx;white-space:nowrap}
.job-card__tag{flex-shrink:0;padding:5rpx 14rpx;border-radius:8rpx;color:#5875a5;background:#f1f6fd;font-size:24rpx;line-height:30rpx}
.job-card__tag:nth-child(n+4){display:none}
.job-card__deadline{display:block;margin-top:11rpx;color:#6680b1;font-size:24rpx;line-height:34rpx}
.job-card__deadline--urgent{color:#ff7a30}
.job-card__deadline--closed{color:#8a94a8}
.job-card__bookmark{display:flex;position:absolute;top:20rpx;right:18rpx;align-items:center;justify-content:center;width:56rpx;height:56rpx}
.job-card__bookmark image{display:block;width:38rpx;height:38rpx}
.job-card__evidence-empty{display:none}
.job-card__salary,.job-card__provenance{display:none}
