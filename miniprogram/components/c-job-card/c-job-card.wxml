<view class="job-card {{view.deadlineClosed ? 'job-card--closed' : ''}}" bindtap="openJob" hover-class="job-card--pressed" aria-role="button" aria-label="{{view.accessibilityLabel}}">
  <view class="job-card__logo-wrap">
    <c-company-logo logo="{{view.logo}}" name="{{view.company}}" fallback="{{view.companyInitial}}" size="sm" lazy-load="{{true}}" custom-class="job-card__logo"></c-company-logo>
  </view>
  <view class="job-card__body">
    <view class="job-card__headline">
      <text class="job-card__title">{{view.title}}</text>
      <text class="job-card__salary">{{view.salary}}</text>
      <text wx:if="{{showMatch}}" class="job-card__related">与你相关</text>
    </view>
    <text class="job-card__company">{{view.company}}{{view.location ? ' · ' + view.location : ''}}</text>
    <view class="job-card__tags" wx:if="{{view.attributeTags.length || view.skills.length}}">
      <text class="job-card__tag" wx:for="{{view.attributeTags}}" wx:key="*this">{{item}}</text>
      <text class="job-card__tag" wx:for="{{view.skills}}" wx:for-item="skill" wx:key="*this">{{skill}}</text>
    </view>
    <text wx:if="{{showMatch && !view.matchEvidence.length}}" class="job-card__evidence-empty">暂无可验证匹配依据</text>
    <text class="job-card__deadline job-card__deadline--{{view.deadlineTone}}">{{view.deadlineText || view.postedText}}</text>
    <text class="job-card__provenance">{{view.sourceSummary}}</text>
  </view>
  <view class="job-card__bookmark {{view.isSaved ? 'is-saved' : ''}}" catchtap="toggleFavorite" aria-role="button" aria-label="{{view.isSaved ? '取消收藏岗位' : '收藏岗位'}}" aria-pressed="{{view.isSaved}}"><image src="{{view.isSaved ? '/images/zhiyin-icons/bookmark-active.svg' : '/images/zhiyin-icons/bookmark.svg'}}" mode="aspectFit" aria-hidden="true"/></view>
</view>
