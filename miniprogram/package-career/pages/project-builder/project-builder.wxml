<view class="page">
  <view class="hero"><text class="hero-kicker">EVIDENCE PROJECT</text><text class="hero-title">证据型项目构建器</text><text class="hero-sub">从真实岗位差距出发，逐项完成并留证，再转为简历素材</text></view>
  <view class="notice" wx:if="{{dashboard}}">{{dashboard.safetyNotice}}</view>
  <view class="section-head"><text class="section-title">我的项目</text><view class="small-button" bindtap="openCreate">＋ 新建项目计划</view></view>
  <scroll-view scroll-x class="project-tabs" wx:if="{{projects.length}}"><view class="tab-row"><view wx:for="{{projects}}" wx:key="id" class="project-tab {{selectedProject.id === item.id ? 'active' : ''}}" bindtap="selectProject" data-id="{{item.id}}">{{item.title}}</view></view></scroll-view>
  <view class="empty" wx:if="{{!loading && !projects.length}}">还没有项目计划。计划不会被当作已完成经历。</view>
  <view wx:if="{{selectedProject}}">
    <view class="card project-head"><text class="eyebrow">{{selectedProject.trackLabel}} · {{selectedProject.source === 'rules' ? '规则生成计划' : selectedProject.source}}</text><text class="project-title">{{selectedProject.title}}</text><text class="meta">目标岗位：{{selectedProject.targetRole}}</text><view class="progress"><view class="progress-fill" style="width:{{selectedProject.progress}}%"></view></view><text class="meta">完成进度 {{selectedProject.progress}}% · {{selectedProject.verifiedCompletion ? '已确认真实完成' : '尚未确认完成'}}</text></view>
    <view class="card"><text class="card-title">要补齐的岗位差距</text><text class="list-item" wx:for="{{selectedProject.gaps}}" wx:key="*this">• {{item}}</text></view>
    <view class="card"><text class="card-title">问题与证据边界</text><text class="body">{{selectedProject.problemStatement}}</text><text class="sub-title">建议数据来源</text><text class="list-item" wx:for="{{selectedProject.dataSources}}" wx:key="*this">• {{item}}</text><text class="sub-title">交付物</text><text class="list-item" wx:for="{{selectedProject.deliverables}}" wx:key="*this">• {{item}}</text><text class="sub-title">验收标准</text><text class="list-item" wx:for="{{selectedProject.acceptanceCriteria}}" wx:key="*this">• {{item}}</text></view>
    <view class="card"><text class="card-title">里程碑与完成证据</text><view class="milestone" wx:for="{{selectedProject.milestones}}" wx:key="id"><view class="milestone-main"><text class="milestone-status">{{item.status === 'completed' ? '✓' : index + 1}}</text><view><text class="milestone-title">{{item.title}}</text><text class="meta">{{item.evidenceNote || '待填写可核验的真实证据'}}</text></view></view><view class="small-button" wx:if="{{selectedProject.status !== 'completed'}}" bindtap="openMilestone" data-id="{{item.id}}">{{item.status === 'completed' ? '更新证据' : '完成并留证'}}</view></view></view>
    <view class="card" wx:if="{{selectedProject.status === 'completed'}}"><text class="card-title">本人确认的完成证据</text><text class="sub-title">成果</text><text class="list-item" wx:for="{{selectedProject.completionEvidence.outcomes}}" wx:key="*this">• {{item}}</text><text class="sub-title">交付物</text><text class="list-item" wx:for="{{selectedProject.completionEvidence.artifacts}}" wx:key="*this">• {{item}}</text><text class="sub-title" wx:if="{{selectedProject.completionEvidence.limitations.length}}">限制</text><text class="list-item" wx:for="{{selectedProject.completionEvidence.limitations}}" wx:key="*this">• {{item}}</text></view>
    <view class="actions"><view class="primary" wx:if="{{selectedProject.progress === 100 && selectedProject.status !== 'completed'}}" bindtap="openComplete">确认项目真实完成</view><view class="primary" wx:if="{{selectedProject.verifiedCompletion && !selectedProject.resumeExperienceId}}" bindtap="openExport">写入简历经历库</view><view class="exported" wx:if="{{selectedProject.resumeExperienceId}}">✓ 已写入经历库 #{{selectedProject.resumeExperienceId}}</view></view>
  </view>
  <view class="mask" wx:if="{{showCreate}}" bindtap="closeCreate"></view><view class="sheet" wx:if="{{showCreate}}"><view class="sheet-head"><text class="section-title">新建项目计划</text><text bindtap="closeCreate">✕</text></view><scroll-view scroll-y class="sheet-body"><text class="field-label">项目方向 *</text><view class="chips"><view wx:for="{{tracks}}" wx:key="value" class="chip {{createForm.track === item.value ? 'active' : ''}}" bindtap="selectTrack" data-value="{{item.value}}">{{item.label}}</view></view><input class="input" placeholder="目标岗位 *" value="{{createForm.targetRole}}" bindinput="onCreateInput" data-key="targetRole"/><input class="input" placeholder="项目名称（选填）" value="{{createForm.title}}" bindinput="onCreateInput" data-key="title"/><textarea class="textarea" placeholder="已知差距，每行一项；系统会结合岗位匹配补充" value="{{createForm.gapsText}}" bindinput="onCreateInput" data-key="gapsText"/></scroll-view><view class="primary" bindtap="createProject">{{saving ? '创建中...' : '创建证据型计划'}}</view></view>
  <view class="mask" wx:if="{{showMilestone}}" bindtap="closeMilestone"></view><view class="sheet" wx:if="{{showMilestone}}"><view class="sheet-head"><text class="section-title">里程碑证据</text><text bindtap="closeMilestone">✕</text></view><textarea class="textarea evidence" placeholder="填写链接、截图位置、代码提交、测试结果或复盘记录" value="{{evidenceNote}}" bindinput="onEvidenceInput"/><view class="primary" bindtap="saveMilestone">确认完成并留证</view></view>
  <view class="mask" wx:if="{{showComplete}}" bindtap="closeComplete"></view><view class="sheet" wx:if="{{showComplete}}"><view class="sheet-head"><text class="section-title">确认真实完成</text><text bindtap="closeComplete">✕</text></view><scroll-view scroll-y class="sheet-body"><textarea class="textarea" placeholder="真实成果，每行一项 *" value="{{completeForm.outcomesText}}" bindinput="onCompleteInput" data-key="outcomesText"/><textarea class="textarea" placeholder="可核验交付物或链接，每行一项 *" value="{{completeForm.artifactsText}}" bindinput="onCompleteInput" data-key="artifactsText"/><textarea class="textarea" placeholder="限制、失败项或未完成内容" value="{{completeForm.limitationsText}}" bindinput="onCompleteInput" data-key="limitationsText"/></scroll-view><view class="primary" bindtap="completeProject">本人确认项目真实完成</view></view>
  <view class="mask" wx:if="{{showExport}}" bindtap="closeExport"></view><view class="sheet" wx:if="{{showExport}}"><view class="sheet-head"><text class="section-title">写入简历经历库</text><text bindtap="closeExport">✕</text></view><text class="warning">只写真实成果；描述中的数字必须已出现在完成证据里。</text><textarea class="textarea evidence" placeholder="基于完成证据填写简历描述" value="{{resumeBullet}}" bindinput="onResumeBulletInput"/><view class="primary" bindtap="exportExperience">确认写入真实成果</view></view>
</view>
