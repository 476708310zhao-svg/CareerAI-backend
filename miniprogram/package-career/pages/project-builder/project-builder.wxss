.page{min-height:100vh;padding:22rpx 24rpx 90rpx;background:#f6f8fc;color:#172033}.hero{padding:38rpx 30rpx;border-radius:28rpx;background:linear-gradient(135deg,#26115f,#315ff4);color:#fff}.hero-kicker,.eyebrow{display:block;font-size:21rpx;letter-spacing:2rpx;opacity:.78}.hero-title{display:block;margin-top:10rpx;font-size:38rpx;font-weight:900}.hero-sub{display:block;margin-top:12rpx;font-size:24rpx;line-height:1.55;opacity:.86}.notice,.warning{display:block;margin:20rpx 0;padding:18rpx;border-radius:16rpx;background:#fff7db;color:#73580d;font-size:23rpx;line-height:1.6}.section-head,.sheet-head,.milestone-main{display:flex;align-items:center;justify-content:space-between;gap:14rpx}.section-head{margin:28rpx 0 16rpx}.section-title,.card-title{display:block;font-size:30rpx;font-weight:850}.small-button{display:inline-flex;margin-top:12rpx;padding:12rpx 17rpx;border-radius:14rpx;background:#edf1ff;color:#354fc4;font-size:22rpx}.project-tabs{white-space:nowrap;margin-bottom:18rpx}.tab-row{display:flex;gap:12rpx}.project-tab{display:inline-block;max-width:310rpx;padding:15rpx 20rpx;border-radius:999rpx;background:#fff;color:#697386;font-size:23rpx;overflow:hidden;text-overflow:ellipsis}.project-tab.active{background:#315ff4;color:#fff}.card{margin-bottom:18rpx;padding:25rpx;border-radius:22rpx;background:#fff;box-shadow:0 8rpx 26rpx rgba(35,48,77,.06)}.project-title{display:block;margin:10rpx 0;font-size:33rpx;font-weight:900}.meta,.body,.list-item{display:block;color:#647084;font-size:23rpx;line-height:1.65}.body{margin-top:14rpx;color:#30394a}.sub-title{display:block;margin:20rpx 0 8rpx;font-size:24rpx;font-weight:800}.progress{height:12rpx;margin:20rpx 0 10rpx;border-radius:999rpx;background:#e8ecf3;overflow:hidden}.progress-fill{height:100%;background:linear-gradient(90deg,#315ff4,#7b48df)}.milestone{padding:20rpx 0;border-bottom:1rpx solid #edf0f4}.milestone-main{justify-content:flex-start}.milestone-status{display:flex;align-items:center;justify-content:center;width:46rpx;height:46rpx;border-radius:50%;background:#e9efff;color:#315ff4;font-size:22rpx;font-weight:900;flex-shrink:0}.milestone-title{display:block;font-size:25rpx;font-weight:800}.actions{margin:24rpx 0}.primary{padding:21rpx;border-radius:17rpx;background:#315ff4;color:#fff;text-align:center;font-size:26rpx;font-weight:800}.exported{padding:20rpx;border-radius:16rpx;background:#e9f8ef;color:#187a40;text-align:center;font-size:25rpx}.empty{padding:70rpx 20rpx;text-align:center;color:#8991a2;font-size:24rpx}.mask{position:fixed;inset:0;z-index:20;background:rgba(0,0,0,.45)}.sheet{position:fixed;left:0;right:0;bottom:0;z-index:21;max-height:88vh;padding:28rpx;background:#fff;border-radius:30rpx 30rpx 0 0;box-sizing:border-box}.sheet-body{max-height:58vh;margin:22rpx 0}.chips{display:flex;flex-wrap:wrap;gap:10rpx;margin:12rpx 0 22rpx}.chip{padding:11rpx 18rpx;border-radius:999rpx;background:#f0f2f6;color:#5f6878;font-size:23rpx}.chip.active{background:#e7ebff;color:#354fc4;border:1rpx solid #6578e8}.field-label{font-size:24rpx;font-weight:800}.input,.textarea{width:100%;box-sizing:border-box;margin-bottom:16rpx;padding:20rpx;border:1rpx solid #dfe4ed;border-radius:14rpx;background:#fafbfc;font-size:26rpx}.textarea{min-height:125rpx}.textarea.evidence{min-height:220rpx;margin-top:24rpx}
