<view class="page">
  <view class="oa-header">
    <text class="oa-kicker">笔试准备</text>
    <text class="oa-title">OA 题库</text>
    <text class="oa-subtitle">选一个题型，马上开始练习</text>
  </view>

  <view class="oa-tabs" aria-role="tablist">
    <view class="oa-tab {{activeTab === 'practice' ? 'is-active' : ''}}" bindtap="openPracticeTab" aria-role="tab" aria-selected="{{activeTab === 'practice'}}">刷题练习</view>
    <view class="oa-tab {{activeTab === 'records' ? 'is-active' : ''}}" bindtap="openRecordTab" aria-role="tab" aria-selected="{{activeTab === 'records'}}">训练记录</view>
  </view>

  <block wx:if="{{activeTab === 'practice'}}">
    <view class="practice-intro">
      <view class="practice-intro-top"><text class="practice-intro-title">通用模拟题</text><text class="practice-count">{{practiceQuestions.length}} 题</text></view>
      <text class="practice-intro-copy">包含数理、逻辑、言语、情景等题型；不是企业真题</text>
    </view>
    <scroll-view class="category-scroll" scroll-x enable-flex>
      <view class="category-row">
        <view wx:for="{{practiceCategories}}" wx:key="value" class="category-chip {{selectedType === item.value ? 'is-active' : ''}}" data-type="{{item.value}}" bindtap="selectPracticeType" aria-role="button" aria-pressed="{{selectedType === item.value}}">{{item.label}} <text>{{item.count}}</text></view>
      </view>
    </scroll-view>

    <view class="practice-card" wx:if="{{!practiceFinished && practiceCurrent}}">
      <view class="practice-card-top"><text>第 {{practiceIndex + 1}} / {{practiceQuestions.length}} 题</text><text>{{selectedTypeLabel}}</text></view>
      <view class="practice-track"><view style="width: {{practiceProgress}}%"></view></view>
      <text class="practice-stem">{{practiceCurrent.stem}}</text>
      <view class="practice-choices">
        <view wx:for="{{practiceCurrent.choices}}" wx:key="*this" wx:for-index="optionIndex" class="practice-choice {{practiceSelected === optionIndex ? 'is-selected' : ''}} {{practiceRevealed && practiceCurrent.answerIndex === optionIndex ? 'is-correct' : ''}} {{practiceRevealed && practiceSelected === optionIndex && !practiceResultCorrect ? 'is-wrong' : ''}}" data-index="{{optionIndex}}" bindtap="selectPracticeOption" aria-role="button" aria-pressed="{{practiceSelected === optionIndex}}" aria-label="选择{{optionLetters[optionIndex]}}，{{item}}">
          <text class="choice-letter">{{optionLetters[optionIndex]}}</text><text class="choice-text">{{item}}</text>
        </view>
      </view>
      <view class="practice-feedback {{practiceResultCorrect ? 'is-correct' : 'is-wrong'}}" wx:if="{{practiceRevealed}}">
        <text class="feedback-title">{{practiceResultCorrect ? '回答正确' : '再记住这个知识点'}} · 正确答案 {{optionLetters[practiceCurrent.answerIndex]}}</text>
        <text class="feedback-copy">{{practiceCurrent.explanation}}</text>
      </view>
      <view class="practice-action" wx:if="{{!practiceRevealed}}" bindtap="submitPracticeAnswer" hover-class="press" aria-role="button" aria-label="提交答案">提交答案</view>
      <view class="practice-action" wx:else bindtap="nextPracticeQuestion" hover-class="press" aria-role="button" aria-label="{{practiceIndex + 1 === practiceQuestions.length ? '查看本组结果' : '下一题'}}">{{practiceIndex + 1 === practiceQuestions.length ? '查看本组结果' : '下一题'}}</view>
    </view>

    <view class="practice-finish" wx:if="{{practiceFinished}}">
      <text class="finish-kicker">本组练习完成</text>
      <text class="finish-score">答对 {{practiceCorrect}} / {{practiceQuestions.length}} 题</text>
      <text class="finish-copy">这组通用模拟题的结果仅在本次打开期间显示，不计入个人 OA 成绩。</text>
      <view class="practice-action" bindtap="restartPractice" hover-class="press" aria-role="button" aria-label="重新练习本组题目">再练一遍</view>
    </view>
    <text class="practice-footnote">已作答 {{practiceAnswered}} / {{practiceQuestions.length}} · 答对 {{practiceCorrect}} 题</text>
  </block>

  <block wx:else>
  <view class="record-intro">
    <text class="record-title">我的 OA 训练</text>
    <text class="record-sub">按目标公司建计划，计时后记录真实练习结果</text>
    <view class="summary" wx:if="{{dashboard}}">
      <text>完成 {{dashboard.summary.completedSessions}} 次</text>
      <text>待复习 {{dashboard.summary.learningMistakes}} 题</text>
    </view>
  </view>

  <view class="state-card" wx:if="{{loading && !dashboard}}" aria-role="status">
    <text class="state-title">正在加载 OA 训练数据</text>
    <text class="state-copy">请稍候</text>
  </view>

  <view class="state-card error" wx:elif="{{loadError}}" aria-role="alert">
    <text class="state-title">{{loadError}}</text>
    <text class="state-copy">{{loadErrorAction === 'login' ? '登录后会自动重新加载训练计划。' : '请检查网络后重新加载。'}}</text>
    <view class="state-action" bindtap="retryDashboard" hover-class="press" aria-role="button" aria-label="{{loadErrorAction === 'login' ? '立即登录' : '重新加载'}}">
      {{loadErrorAction === 'login' ? '立即登录' : '重新加载'}}
    </view>
  </view>

  <block wx:if="{{dashboard}}">
    <view class="notice">{{dashboard.notice}}</view>
    <view class="timer-card" wx:if="{{activeSession}}">
      <text class="eyebrow">正在练习 · {{activeSession.questionTypeLabel}}</text>
      <text class="timer">{{elapsedText}}</text>
      <view class="button-row">
        <view class="button secondary" bindtap="abandonPractice">放弃，不计入统计</view>
        <view class="button" bindtap="openResultForm">记录结果</view>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <text class="section-title">训练计划</text>
        <view class="small-button" bindtap="openPlanForm">＋ 新建计划</view>
      </view>
      <view class="empty" wx:if="{{!loading && !plans.length}}">还没有训练计划</view>
      <view class="card" wx:for="{{plans}}" wx:key="id">
        <view class="card-head">
          <view><text class="card-title">{{item.company}}</text><text class="card-sub">{{item.role || '未填写岗位'}}</text></view>
          <text class="status">{{item.status === 'active' ? '进行中' : '已完成'}}</text>
        </view>
        <view class="tags"><text class="tag" wx:for="{{item.focusTypes}}" wx:for-item="type" wx:key="*this">{{type}}</text></view>
        <text class="meta">本周 {{item.weeklyCompletedMinutes}} / {{item.weeklyMinutes}} 分钟{{item.targetDate ? ' · 目标 ' + item.targetDate : ''}}</text>
        <view class="button" wx:if="{{item.status === 'active'}}" bindtap="startPractice" data-id="{{item.id}}">开始 30 分钟计时练习</view>
      </view>
    </view>

    <view class="section">
      <text class="section-title">题型能力统计</text>
      <view class="capability" wx:for="{{capabilities}}" wx:key="type">
        <view><text class="cap-title">{{item.label}}</text><text class="card-sub">{{item.sampleNotice}}</text></view>
        <text class="cap-score">{{item.accuracy === null ? '不评估' : item.accuracy + '%'}}</text>
      </view>
    </view>

    <view class="section">
      <text class="section-title">错题本</text>
      <view class="empty" wx:if="{{!mistakes.length}}">完成练习后可在这里复习错题</view>
      <view class="card" wx:for="{{mistakes}}" wx:key="id">
        <text class="eyebrow">{{item.questionTypeLabel}}</text>
        <text class="mistake-prompt">{{item.prompt}}</text>
        <text class="card-sub" wx:if="{{item.correctAnswer}}">正确答案：{{item.correctAnswer}}</text>
        <view class="small-button" bindtap="markMistake" data-id="{{item.id}}" data-status="{{item.status === 'learning' ? 'mastered' : 'learning'}}">{{item.status === 'learning' ? '已重练，标记掌握' : '重新加入练习'}}</view>
      </view>
    </view>
  </block>
  </block>

  <view class="mask" wx:if="{{showPlanForm}}" bindtap="closePlanForm"></view>
  <view class="sheet" wx:if="{{showPlanForm}}">
    <view class="sheet-head"><text class="section-title">新建 OA 计划</text><text bindtap="closePlanForm">✕</text></view>
    <scroll-view scroll-y class="sheet-body">
      <input class="input" placeholder="公司 *" value="{{planForm.company}}" bindinput="onPlanInput" data-key="company"/>
      <input class="input" placeholder="岗位" value="{{planForm.role}}" bindinput="onPlanInput" data-key="role"/>
      <input class="input" placeholder="目标日期 YYYY-MM-DD" value="{{planForm.targetDate}}" bindinput="onPlanInput" data-key="targetDate"/>
      <input class="input" type="number" placeholder="每周训练分钟" value="{{planForm.weeklyMinutes}}" bindinput="onPlanInput" data-key="weeklyMinutes"/>
      <text class="field-label">训练题型 *</text>
      <view class="tags"><view wx:for="{{questionTypes}}" wx:key="value" class="select-tag {{item.selected ? 'selected' : ''}}" bindtap="toggleFocusType" data-value="{{item.value}}">{{item.label}}</view></view>
    </scroll-view>
    <view class="button" bindtap="savePlan">{{saving ? '保存中...' : '创建计划'}}</view>
  </view>

  <view class="mask" wx:if="{{showResultForm}}" bindtap="closeResultForm"></view>
  <view class="sheet" wx:if="{{showResultForm}}">
    <view class="sheet-head"><text class="section-title">记录本次结果</text><text bindtap="closeResultForm">✕</text></view>
    <scroll-view scroll-y class="sheet-body">
      <input class="input" type="number" placeholder="总题数 *" value="{{resultForm.totalQuestions}}" bindinput="onResultInput" data-key="totalQuestions"/>
      <input class="input" type="number" placeholder="答对题数" value="{{resultForm.correctCount}}" bindinput="onResultInput" data-key="correctCount"/>
      <text class="field-label">可选：记录一道错题</text>
      <textarea class="textarea" placeholder="题目" value="{{resultForm.prompt}}" bindinput="onResultInput" data-key="prompt"/>
      <textarea class="textarea" placeholder="我的答案" value="{{resultForm.userAnswer}}" bindinput="onResultInput" data-key="userAnswer"/>
      <textarea class="textarea" placeholder="正确答案" value="{{resultForm.correctAnswer}}" bindinput="onResultInput" data-key="correctAnswer"/>
      <textarea class="textarea" placeholder="复盘备注" value="{{resultForm.notes}}" bindinput="onResultInput" data-key="notes"/>
    </scroll-view>
    <view class="button" bindtap="completePractice">确认并保存本人记录</view>
  </view>

  <c-login-popup show="{{authPromptVisible}}" subtitle="{{authPromptSubtitle}}" bindclose="closeAuthPrompt" bindsuccess="onAuthPromptSuccess"/>
</view>
