.page{min-height:100vh;background:#f5f7fb;padding-bottom:80rpx;color:#172033}.hero{padding:44rpx 28rpx;background:linear-gradient(135deg,#28145f,#315ff4);color:#fff}.hero-title{display:block;font-size:40rpx;font-weight:800}.hero-sub{display:block;margin-top:10rpx;font-size:24rpx;opacity:.86}.summary{display:flex;gap:28rpx;margin-top:24rpx;font-size:24rpx}.notice{margin:20rpx 24rpx;padding:18rpx;border-radius:16rpx;background:#fff8df;color:#765b10;font-size:23rpx;line-height:1.6}.section{margin:24rpx}.section-head,.card-head,.sheet-head,.button-row,.capability{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.section-title{display:block;font-size:31rpx;font-weight:800;margin-bottom:18rpx}.small-button{display:inline-flex;padding:12rpx 18rpx;border-radius:14rpx;background:#eef2ff;color:#354fc4;font-size:23rpx}.card,.timer-card{margin-bottom:18rpx;padding:24rpx;border-radius:22rpx;background:#fff;box-shadow:0 8rpx 26rpx rgba(33,47,76,.06)}.timer-card{margin:24rpx;text-align:center}.timer{display:block;margin:20rpx;font-size:64rpx;font-weight:900;color:#315ff4}.eyebrow{display:block;color:#6b7280;font-size:22rpx}.card-title{display:block;font-size:29rpx;font-weight:800}.card-sub,.meta{display:block;margin-top:8rpx;color:#6b7280;font-size:23rpx;line-height:1.5}.status{padding:7rpx 14rpx;border-radius:999rpx;background:#eaf1ff;color:#315ff4;font-size:21rpx}.tags{display:flex;flex-wrap:wrap;gap:10rpx;margin:16rpx 0}.tag,.select-tag{padding:8rpx 14rpx;border-radius:999rpx;background:#f0f2f6;color:#566174;font-size:22rpx}.select-tag.selected{background:#e7eaff;color:#354fc4;border:1rpx solid #6578e8}.button{margin-top:18rpx;padding:20rpx 24rpx;border-radius:16rpx;background:#315ff4;color:#fff;text-align:center;font-size:25rpx;font-weight:700}.button.secondary{background:#eef1f6;color:#586174}.button-row .button{flex:1}.capability{padding:18rpx 0;border-bottom:1rpx solid #e9edf3}.cap-title{display:block;font-size:26rpx;font-weight:700}.cap-score{font-size:28rpx;font-weight:800;color:#315ff4}.mistake-prompt{display:block;margin:12rpx 0;font-size:26rpx;line-height:1.55}.empty{padding:40rpx;text-align:center;color:#8991a2;font-size:24rpx}.mask{position:fixed;inset:0;z-index:20;background:rgba(0,0,0,.45)}.sheet{position:fixed;left:0;right:0;bottom:0;z-index:21;max-height:88vh;padding:28rpx;background:#fff;border-radius:30rpx 30rpx 0 0;box-sizing:border-box}.sheet-head .section-title{margin:0}.sheet-body{max-height:58vh;margin:24rpx 0}.input,.textarea{width:100%;box-sizing:border-box;margin-bottom:16rpx;padding:20rpx;border:1rpx solid #dfe4ed;border-radius:14rpx;background:#fafbfc;font-size:26rpx}.textarea{min-height:110rpx}.field-label{display:block;margin:18rpx 0 8rpx;font-size:24rpx;font-weight:700}
