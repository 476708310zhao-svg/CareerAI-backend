page { min-height: 100%; background: #f3f6fb; }
.page { min-height: 100vh; padding: 24rpx 24rpx 60rpx; box-sizing: border-box; }
.state-card,.section-card,.hero-card { margin-bottom: 22rpx; padding: 26rpx; border: 1rpx solid #e5eaf2; border-radius: 26rpx; background: #fff; box-shadow: 0 10rpx 26rpx rgba(30,58,110,.06); }
.state-card { text-align: center; color: #667085; }
.state-title,.state-copy,.eyebrow,.hero-title,.hero-sub,.section-title,.section-sub,.evidence,.gap,.task-title,.task-detail,.bottleneck-label,.bottleneck-title,.bottleneck-copy,.notice,.focus-title,.focus,.basis text,.horizon-title,.horizon-objective,.horizon-action,.metric { display: block; }
.state-title { color: #172b4d; font-size: 30rpx; font-weight: 800; }
.state-copy { margin: 12rpx 0 24rpx; font-size: 24rpx; }
.primary-btn,.secondary-btn { display: inline-block; padding: 16rpx 28rpx; border-radius: 16rpx; font-weight: 750; }
.primary-btn { color: #fff; background: #2b5ce6; }.secondary-btn { color: #2b5ce6; background: #edf3ff; }
.hero-card { display: flex; align-items: center; justify-content: space-between; color: #fff; border: 0; background: linear-gradient(135deg,#183b8e,#2b67e8); }
.hero-copy { width: 70%; }.eyebrow { color: #cddcff; font-size: 18rpx; letter-spacing: 1rpx; }.hero-title { margin-top: 10rpx; font-size: 42rpx; font-weight: 900; }.hero-sub { margin-top: 10rpx; color: #e1eaff; font-size: 22rpx; line-height: 1.55; }
.score-ring { width: 132rpx; height: 132rpx; display: flex; align-items: baseline; justify-content: center; border: 8rpx solid rgba(255,255,255,.28); border-radius: 50%; background: rgba(255,255,255,.1); }.score { font-size: 44rpx; font-weight: 900; }.score-unit { font-size: 18rpx; }
.section-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; margin-bottom: 20rpx; }.section-title { color: #172b4d; font-size: 30rpx; font-weight: 850; }.section-sub { margin-top: 5rpx; color: #7a869a; font-size: 21rpx; }.mini-btn { flex: none; padding: 10rpx 16rpx; border-radius: 999rpx; color: #2459d7; background: #edf3ff; font-size: 20rpx; font-weight: 750; }
.dimension { padding: 21rpx 0; border-top: 1rpx solid #edf0f5; }.dimension:first-of-type { border-top: 0; }.dimension-head { display: flex; justify-content: space-between; align-items: center; }.dimension-title { color: #253858; font-size: 26rpx; font-weight: 800; }.dimension-score { font-size: 21rpx; font-weight: 750; }.status-strong { color: #087443; }.status-building { color: #b54708; }.status-priority { color: #c4320a; }
.progress { height: 10rpx; margin: 13rpx 0; overflow: hidden; border-radius: 999rpx; background: #edf0f5; }.progress-value { height: 100%; border-radius: inherit; }.status-bg-strong { background: #12b76a; }.status-bg-building { background: #f79009; }.status-bg-priority { background: #f04438; }
.evidence,.gap { color: #667085; font-size: 21rpx; line-height: 1.55; }.gap { margin-top: 7rpx; color: #475467; }.dimension-action { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-top: 13rpx; color: #344054; font-size: 22rpx; }.text-btn { flex: none; color: #2459d7; font-weight: 800; }
.task { padding: 18rpx 0; border-top: 1rpx solid #edf0f5; }.task-main { padding-right: 4rpx; }.task-title { color: #253858; font-size: 25rpx; font-weight: 800; }.task-detail { margin-top: 6rpx; color: #667085; font-size: 21rpx; line-height: 1.5; }.task-actions { display: flex; justify-content: flex-end; gap: 12rpx; margin-top: 13rpx; }.task-btn { padding: 9rpx 19rpx; border-radius: 999rpx; color: #475467; background: #f2f4f7; font-size: 20rpx; }.task-btn.done { color: #fff; background: #2b5ce6; }.empty,.scheduled { padding: 20rpx; border-radius: 16rpx; color: #667085; background: #f7f9fc; font-size: 22rpx; text-align: center; }.scheduled { margin-top: 14rpx; color: #2459d7; background: #edf3ff; }
.input-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 10rpx; }.input-item { padding: 14rpx 6rpx; border-radius: 14rpx; background: #f7f9fc; text-align: center; }.input-value,.input-label { display: block; }.input-value { color: #2459d7; font-size: 28rpx; font-weight: 900; }.input-label { margin-top: 4rpx; color: #7a869a; font-size: 18rpx; }
.bottleneck { margin-top: 18rpx; padding: 18rpx; border-radius: 18rpx; background: #fff7ed; }.bottleneck-label { color: #b54708; font-size: 19rpx; font-weight: 800; }.bottleneck-title { margin-top: 6rpx; color: #7a2e0e; font-size: 26rpx; font-weight: 850; }.bottleneck-copy { margin-top: 7rpx; color: #9a4a16; font-size: 21rpx; line-height: 1.5; }.conversion { display: flex; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid #edf0f5; color: #344054; font-size: 22rpx; }.notice { margin-top: 13rpx; color: #98a2b3; font-size: 19rpx; line-height: 1.5; }.focus-title { margin-top: 20rpx; color: #253858; font-size: 23rpx; font-weight: 800; }.focus { margin-top: 8rpx; color: #475467; font-size: 21rpx; }
.basis { padding: 16rpx; border-radius: 16rpx; color: #475467; background: #f7f9fc; font-size: 21rpx; line-height: 1.5; }.horizon { display: flex; gap: 16rpx; padding: 22rpx 0; border-bottom: 1rpx solid #edf0f5; }.horizon:last-child { border-bottom: 0; }.month-badge { flex: none; align-self: flex-start; padding: 8rpx 12rpx; border-radius: 12rpx; color: #2459d7; background: #edf3ff; font-size: 19rpx; font-weight: 800; }.horizon-copy { min-width: 0; }.horizon-title { color: #253858; font-size: 25rpx; font-weight: 850; }.horizon-objective { margin-top: 7rpx; color: #475467; font-size: 21rpx; line-height: 1.5; }.horizon-action { margin-top: 6rpx; color: #667085; font-size: 20rpx; }.metric { margin-top: 10rpx; color: #087443; font-size: 20rpx; line-height: 1.5; }
