<view class="page">
  <view class="upload-card">
    <view class="upload-heading">先上传附件简历</view>
    <view class="upload-description">上传 PDF 后，AI 才能根据真实内容给出优化建议。</view>
    <button class="upload-button" bindtap="chooseResumePdf" disabled="{{attachmentBusy}}">{{attachmentBusy ? '处理中…' : '上传 PDF 简历'}}</button>
    <view class="upload-hint">支持文字版 PDF，最大 10 MB · 原文件会保留</view>
    <view wx:if="{{attachmentStage}}" class="process-state">{{attachmentStage}}</view>
    <view wx:if="{{attachmentError}}" class="error-state">{{attachmentError}}</view>
  </view>

  <view wx:if="{{optimizationContext}}" class="target-context">
    <text class="target-kicker">正在为目标岗位优化</text>
    <text class="card-title">{{optimizationContext.company}} · {{optimizationContext.jobTitle}}</text>
  </view>

  <view class="section-heading"><text>附件简历</text><text class="section-count">{{attachments.length}} 份</text></view>
  <view wx:if="{{!attachments.length && !loading}}" class="empty-attachment">还没有上传附件。上传后即可开始 AI 优化。</view>
  <view wx:for="{{attachments}}" wx:key="id" class="attachment-card">
    <view class="file-icon" aria-hidden="true">PDF</view>
    <view class="attachment-info">
      <text class="attachment-name">{{item.filename}}</text>
      <text class="attachment-meta">{{item.sizeLabel}} · {{item.dateLabel}}</text>
      <text wx:if="{{item.linkedResumeId}}" class="attachment-ready">已生成可优化版本</text>
      <text wx:else class="attachment-waiting">尚未导入，请先建立原始版本</text>
    </view>
    <button class="attachment-action" bindtap="optimizeAttachment" data-id="{{item.id}}" disabled="{{attachmentBusy || loading}}">{{busyAttachmentId === item.id ? '处理中' : (item.linkedResumeId ? 'AI 优化' : '导入简历')}}</button>
  </view>

  <view class="section-heading online-heading"><text>在线简历</text><text class="section-link" bindtap="openCreate">手动新建</text></view>
  <view class="section-subactions"><text bindtap="openExperience">添加真实经历</text><text class="subaction-divider">·</text><text bindtap="switchTab" data-tab="versions">查看历史版本</text></view>

  <view class="tabs">
    <view class="tab {{activeTab === 'resumes' ? 'active' : ''}}" bindtap="switchTab" data-tab="resumes">简历列表</view>
    <view class="tab {{activeTab === 'experiences' ? 'active' : ''}}" bindtap="switchTab" data-tab="experiences">真实经历</view>
    <view class="tab {{activeTab === 'versions' ? 'active' : ''}}" bindtap="switchTab" data-tab="versions">历史记录</view>
  </view>

  <view wx:if="{{activeTab === 'resumes'}}">
    <view wx:for="{{resumes}}" wx:key="id" class="card {{currentResume.id === item.id ? 'selected' : ''}}" bindtap="selectResume" data-id="{{item.id}}">
      <view class="card-main">
        <view><text class="card-title">{{item.name}}</text><text wx:if="{{item.isDefault}}" class="badge">默认</text><text wx:if="{{item.duplicateSource}}" class="badge duplicate-badge">重复导入</text></view>
        <text class="meta">{{item.typeLabel}} · {{item.updatedLabel}}</text>
      </view>
      <view class="more" catchtap="resumeActions" data-id="{{item.id}}">•••</view>
    </view>
    <view class="empty-online" wx:if="{{!resumes.length}}">上传附件后，这里会自动出现可编辑的在线版本。</view>
    <button class="optimize" wx:if="{{currentResume}}" bindtap="optimizeResume" disabled="{{loading}}">{{optimizationContext ? '按目标岗位优化当前简历' : '优化选中的在线简历'}}</button>
    <button class="initialize" wx:if="{{currentResume && !currentResume.currentVersionId}}" bindtap="initializeResumeVersion">创建首个版本</button>
  </view>

  <view wx:if="{{activeTab === 'experiences'}}">
    <view wx:for="{{experiences}}" wx:key="id" class="card">
      <view class="card-main">
        <text class="type">{{item.typeLabel}}</text><text class="card-title">{{item.title}}</text>
        <text class="meta">{{item.organization || '个人经历'}} · 已核验</text>
      </view>
      <view class="archive" bindtap="archiveExperience" data-id="{{item.id}}">归档</view>
    </view>
  </view>

  <view wx:if="{{activeTab === 'versions'}}">
    <view class="empty" wx:if="{{!versions.length}}">从简历菜单选择“查看版本”</view>
    <view wx:for="{{versions}}" wx:key="id" class="version-card">
      <view><text class="card-title">V{{item.versionNo}} · {{item.changeSummary || '简历版本'}}</text><text class="meta">{{item.createdAt}}</text></view>
      <view class="restore {{restoreBusy ? 'disabled' : ''}}" bindtap="restoreVersion" data-id="{{item.id}}">{{restoreBusy ? '恢复中…' : '恢复'}}</view>
    </view>
  </view>

  <view class="privacy-note">AI 建议需逐条确认才会保存为新版本；原简历与附件不会被覆盖。</view>

  <view wx:if="{{proposal}}" class="mask"></view>
  <view wx:if="{{proposal}}" class="sheet">
    <text class="sheet-title">逐条确认{{proposal.suggestionLabel}}</text>
    <text class="sheet-note">模型 {{proposal.modelLabel}} · 提示词 {{proposal.promptVersion}}</text>
    <text class="sheet-note">来源版本 ID {{proposal.sourceVersionId}} · 确认前原版本保持不变</text>
    <text wx:if="{{proposal.generationNotice}}" class="generation-notice">{{proposal.generationNotice}}</text>
    <scroll-view scroll-y class="suggestions">
      <view wx:for="{{proposal.suggestions}}" wx:key="id" class="suggestion">
        <text class="reason">{{item.reason}}</text>
        <text class="before">原内容：{{item.before}}</text>
        <text class="after">{{proposal.suggestionLabel}}：{{item.after}}</text>
        <view class="decision {{decisions[item.id] === 'accept' ? 'accepted' : ''}}" bindtap="toggleSuggestion" data-id="{{item.id}}">{{decisions[item.id] === 'accept' ? '已接受' : '拒绝'}}</view>
      </view>
      <view class="manual-switch" bindtap="toggleManualMode">{{manualMode ? '返回逐条确认' : '手动编辑完整简历'}}</view>
      <textarea wx:if="{{manualMode}}" class="manual-editor" value="{{manualJson}}" bindinput="onManualJsonInput" maxlength="30000" />
    </scroll-view>
    <view class="sheet-actions"><view bindtap="rejectSuggestions">全部放弃</view><view class="primary" bindtap="confirmSuggestions">确认并保存新版本</view></view>
  </view>

  <view wx:if="{{showCreate}}" class="mask" bindtap="closeCreate"></view>
  <view wx:if="{{showCreate}}" class="dialog">
    <text class="sheet-title">新建岗位简历</text>
    <picker range="{{templates}}" range-key="name" value="{{templateIndex}}" bindchange="onTemplateChange"><view class="input">{{templates[templateIndex].name || '通用简历'}}</view></picker>
    <input class="input" placeholder="简历名称" value="{{createName}}" bindinput="onCreateName" />
    <view class="primary wide" bindtap="createResume">创建</view>
  </view>

  <view wx:if="{{showExperience}}" class="mask" bindtap="closeExperience"></view>
  <view wx:if="{{showExperience}}" class="dialog">
    <text class="sheet-title">添加真实经历</text>
    <picker range="{{experienceTypes}}" value="{{experienceTypeIndex}}" bindchange="onExperienceType"><view class="input">{{experienceTypes[experienceTypeIndex]}}</view></picker>
    <input class="input" placeholder="标题" data-field="title" bindinput="onExperienceInput" />
    <input class="input" placeholder="学校 / 公司 / 组织" data-field="organization" bindinput="onExperienceInput" />
    <textarea class="textarea" placeholder="只填写真实、可核验的内容" data-field="description" bindinput="onExperienceInput" />
    <view class="primary wide" bindtap="saveExperience">保存经历</view>
  </view>
</view>
