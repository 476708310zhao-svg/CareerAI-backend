.page{min-height:100vh;box-sizing:border-box;padding:28rpx 28rpx calc(72rpx + env(safe-area-inset-bottom));background:#f5f8ff;color:#111827}
.upload-card,.attachment-card,.card,.version-card{background:#fff;border:1rpx solid #e2e8f3;box-shadow:0 6rpx 24rpx rgba(41,71,130,.04)}
.upload-card{padding:32rpx;border-radius:28rpx}.upload-heading{font-size:36rpx;font-weight:700;line-height:1.35}.upload-description{margin-top:12rpx;color:#475467;font-size:26rpx;line-height:1.55}
.upload-button{display:flex;align-items:center;justify-content:center;height:88rpx;margin:32rpx 0 0;border:0;border-radius:18rpx;background:#315ee8;color:#fff;font-size:29rpx;font-weight:700;line-height:1}.upload-button::after,.attachment-action::after,.optimize::after,.initialize::after{border:0}.upload-button[disabled],.attachment-action[disabled],.optimize[disabled]{opacity:.5}.upload-button:active,.attachment-action:active,.optimize:active{opacity:.82}
.upload-hint{margin-top:16rpx;color:#667085;font-size:22rpx;text-align:center;line-height:1.5}.process-state,.error-state{margin-top:18rpx;padding:16rpx 20rpx;border-radius:12rpx;font-size:24rpx;line-height:1.5}.process-state{background:#edf2ff;color:#254ac0}.error-state{background:#fff1f2;color:#a62032}
.section-heading{display:flex;justify-content:space-between;align-items:center;margin:36rpx 4rpx 18rpx;font-size:31rpx;font-weight:700}.section-count{color:#667085;font-size:23rpx;font-weight:400}.section-link{color:#315ee8;font-size:24rpx;font-weight:600;padding:12rpx 0 12rpx 18rpx}.empty-attachment,.empty-online{padding:32rpx;border:1rpx dashed #ccd8f2;border-radius:20rpx;background:#fff;color:#667085;font-size:25rpx;line-height:1.5}
.attachment-card{display:flex;align-items:center;gap:18rpx;min-height:116rpx;box-sizing:border-box;margin-bottom:14rpx;padding:20rpx;border-radius:22rpx}.file-icon{display:flex;align-items:center;justify-content:center;flex:none;width:64rpx;height:72rpx;border-radius:12rpx;background:#edf2ff;color:#315ee8;font-size:19rpx;font-weight:800}.attachment-info{flex:1;min-width:0}.attachment-name{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:27rpx;font-weight:600}.attachment-meta,.attachment-ready,.attachment-waiting{display:block;margin-top:5rpx;font-size:21rpx;line-height:1.4}.attachment-meta,.attachment-waiting{color:#667085}.attachment-ready{color:#247052}.attachment-action{flex:none;display:flex;align-items:center;justify-content:center;min-width:120rpx;height:88rpx;margin:0;padding:0 14rpx;border:1rpx solid #b8c9fc;border-radius:16rpx;background:#f3f6ff;color:#2853d4;font-size:24rpx;font-weight:700;line-height:1}
.online-heading{margin-top:34rpx;margin-bottom:4rpx}.section-subactions{display:flex;align-items:center;gap:14rpx;margin:0 4rpx 14rpx;color:#667085;font-size:23rpx}.section-subactions text{min-height:56rpx;display:flex;align-items:center}.section-subactions .subaction-divider{min-height:0}.target-context{margin-top:18rpx;padding:22rpx;border:1rpx solid #c6d5ff;border-radius:20rpx;background:#edf2ff}.target-kicker{display:block;margin-bottom:8rpx;color:#2853d4;font-size:22rpx;font-weight:600}
.tabs{display:flex;gap:8rpx;margin:6rpx 0 18rpx;padding:7rpx;border-radius:18rpx;background:#fff;border:1rpx solid #e2e8f3}.tab{flex:1;display:flex;align-items:center;justify-content:center;min-height:72rpx;border-radius:13rpx;color:#667085;font-size:24rpx}.tab.active{background:#edf2ff;color:#2853d4;font-weight:700}.card,.version-card{display:flex;align-items:center;gap:16rpx;margin-bottom:14rpx;padding:22rpx;border-radius:20rpx}.card.selected{border-color:#89a8ff}.card-main{flex:1;min-width:0}.card-title{font-size:27rpx;font-weight:700;line-height:1.4}.meta{display:block;margin-top:8rpx;color:#667085;font-size:22rpx;line-height:1.45}.badge,.type{display:inline-block;margin-left:10rpx;padding:5rpx 12rpx;border-radius:999rpx;background:#edf2ff;color:#2853d4;font-size:20rpx}.type{margin:0 12rpx 8rpx 0}.more{display:flex;align-items:center;justify-content:center;flex:none;min-width:88rpx;min-height:88rpx;color:#667085;font-size:28rpx}.archive,.restore{display:flex;align-items:center;min-height:88rpx;color:#2853d4;font-size:24rpx}.restore.disabled{opacity:.45}
.optimize,.initialize{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:100%;min-height:88rpx;margin:20rpx 0 0;border-radius:17rpx;font-size:27rpx;font-weight:700;line-height:1.3}.optimize{background:#315ee8;color:#fff}.initialize{border:1rpx solid #b8c9fc;background:#fff;color:#2853d4}.empty{padding:64rpx 20rpx;text-align:center;color:#667085;font-size:24rpx}.privacy-note{margin:30rpx 6rpx;color:#667085;font-size:22rpx;line-height:1.6}
.mask{position:fixed;inset:0;z-index:20;background:rgba(16,24,40,.48)}.sheet{position:fixed;z-index:21;left:0;right:0;bottom:0;box-sizing:border-box;max-height:86vh;padding:32rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));border-radius:28rpx 28rpx 0 0;background:#fff}.sheet-title{display:block;font-size:32rpx;font-weight:700}.sheet-note{display:block;margin-top:8rpx;color:#667085;font-size:21rpx}.generation-notice{display:block;margin-top:14rpx;padding:14rpx 18rpx;border-radius:12rpx;background:#fffaeb;color:#9a4906;font-size:22rpx;line-height:1.5}.suggestions{height:48vh;margin-top:20rpx}.suggestion{margin-bottom:14rpx;padding:20rpx;border-radius:17rpx;background:#f5f8ff}.reason,.before,.after{display:block;font-size:24rpx;line-height:1.6}.reason{font-weight:700}.before{margin-top:10rpx;color:#475467}.after{margin-top:8rpx;color:#2853d4}.decision{display:flex;align-items:center;justify-content:center;min-height:88rpx;margin-top:14rpx;border-radius:12rpx;background:#fff1f2;color:#a62032;font-size:24rpx}.decision.accepted{background:#e5f7ee;color:#176a49}.sheet-actions{display:flex;align-items:center;gap:14rpx;margin-top:18rpx}.sheet-actions view{flex:1;display:flex;align-items:center;justify-content:center;min-height:88rpx;border-radius:14rpx;background:#f5f8ff;color:#475467;font-size:24rpx}.sheet-actions .primary{flex:2;background:#315ee8;color:#fff;font-weight:700}.manual-switch{display:flex;align-items:center;justify-content:center;min-height:88rpx;margin:16rpx 0;border-radius:12rpx;background:#edf2ff;color:#2853d4;font-size:24rpx}.manual-editor{box-sizing:border-box;width:100%;height:380rpx;padding:18rpx;border:1rpx solid #ccd8f2;border-radius:12rpx;background:#fff;color:#111827;font-family:monospace;font-size:22rpx}
.dialog{position:fixed;z-index:21;left:32rpx;right:32rpx;top:50%;box-sizing:border-box;transform:translateY(-50%);padding:30rpx;border-radius:24rpx;background:#fff}.input,.textarea{box-sizing:border-box;width:100%;min-height:88rpx;margin-top:18rpx;padding:22rpx;border:1rpx solid #e2e8f3;border-radius:14rpx;background:#f8faff;font-size:25rpx}.textarea{height:180rpx}.dialog .primary{display:flex;align-items:center;justify-content:center;min-height:88rpx;margin-top:24rpx;border-radius:14rpx;background:#315ee8;color:#fff;font-size:26rpx;font-weight:700}
