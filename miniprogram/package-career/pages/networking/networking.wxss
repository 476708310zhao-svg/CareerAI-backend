page { min-height: 100%; background: #f3f6fb; }
.page { min-height: 100vh; padding: 24rpx 24rpx 70rpx; box-sizing: border-box; }
.state-card,.section-card,.hero-card { margin-bottom: 22rpx; padding: 26rpx; border: 1rpx solid #e5eaf2; border-radius: 26rpx; background: #fff; box-shadow: 0 10rpx 26rpx rgba(30,58,110,.06); }
.state-card { text-align: center; color: #667085; }.state-title,.state-copy,.eyebrow,.hero-title,.hero-sub,.section-title,.section-sub,.field-label,.contact-name,.contact-meta,.contact-line,.draft-notice,.draft-title,.draft-preview { display: block; }
.state-title { color: #172b4d; font-size: 30rpx; font-weight: 800; }.state-copy { margin: 12rpx 0 24rpx; font-size: 24rpx; }
.hero-card { color: #fff; border: 0; background: linear-gradient(135deg,#174c87,#16859b); }.eyebrow { color: #c9f2f5; font-size: 18rpx; letter-spacing: 1rpx; }.hero-title { margin-top: 9rpx; font-size: 38rpx; font-weight: 900; }.hero-sub { margin-top: 10rpx; color: #e0f5f7; font-size: 22rpx; line-height: 1.55; }
.section-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; margin-bottom: 20rpx; }.section-title { color: #172b4d; font-size: 30rpx; font-weight: 850; }.section-sub { margin-top: 5rpx; color: #7a869a; font-size: 21rpx; }.mini-btn { flex: none; padding: 10rpx 16rpx; border-radius: 999rpx; color: #176b78; background: #e8f7f7; font-size: 20rpx; font-weight: 750; }
.funnel-row { display: grid; grid-template-columns: repeat(4,1fr); gap: 10rpx; }.funnel-item { padding: 15rpx 5rpx; border-radius: 15rpx; background: #f7f9fc; text-align: center; }.funnel-value,.funnel-label,.funnel-rate { display: block; }.funnel-value { color: #176b78; font-size: 29rpx; font-weight: 900; }.funnel-label { margin-top: 4rpx; color: #344054; font-size: 18rpx; }.funnel-rate { margin-top: 3rpx; color: #98a2b3; font-size: 16rpx; }.due-banner { margin-top: 16rpx; padding: 15rpx; border-radius: 15rpx; color: #b54708; background: #fff7ed; font-size: 21rpx; text-align: center; }
.empty { padding: 22rpx; border-radius: 16rpx; color: #667085; background: #f7f9fc; font-size: 22rpx; text-align: center; }.contact { padding: 20rpx 0; border-top: 1rpx solid #edf0f5; }.contact:first-of-type { border-top: 0; }.contact-main { display: flex; align-items: flex-start; justify-content: space-between; gap: 14rpx; }.contact-name { color: #253858; font-size: 27rpx; font-weight: 850; }.contact-meta { margin-top: 5rpx; color: #667085; font-size: 21rpx; }.stage-tag { flex: none; padding: 7rpx 12rpx; border-radius: 999rpx; color: #176b78; background: #e8f7f7; font-size: 18rpx; font-weight: 750; }.contact-line { margin-top: 9rpx; color: #7a869a; font-size: 20rpx; line-height: 1.5; }.contact-actions { display: flex; justify-content: flex-end; gap: 18rpx; margin-top: 13rpx; }.text-btn,.clear-link { color: #2459d7; font-size: 21rpx; font-weight: 750; }.clear-link { margin-top: 8rpx; text-align: right; }
.field-label { margin: 18rpx 0 9rpx; color: #344054; font-size: 22rpx; font-weight: 750; }.field-label.required::before { content: '* '; color: #d92d20; }.input,.picker,.textarea { width: 100%; box-sizing: border-box; border: 1rpx solid #dfe5ee; border-radius: 15rpx; background: #fbfcfe; color: #182230; font-size: 24rpx; }.input,.picker { min-height: 76rpx; padding: 18rpx; }.textarea { min-height: 130rpx; padding: 17rpx; line-height: 1.55; }.textarea.small { min-height: 100rpx; }.textarea.draft { min-height: 300rpx; }.two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }.switch-row { display: flex; align-items: center; justify-content: space-between; gap: 15rpx; margin-top: 13rpx; color: #475467; font-size: 21rpx; }
.primary-btn,.secondary-btn { display: inline-block; padding: 15rpx 24rpx; border-radius: 15rpx; font-size: 22rpx; font-weight: 800; text-align: center; }.primary-btn { color: #fff; background: #2459d7; }.secondary-btn { color: #2459d7; background: #edf3ff; }.form-actions,.draft-actions { display: flex; justify-content: flex-end; gap: 12rpx; margin-top: 22rpx; }
.toggle-row { display: grid; grid-template-columns: repeat(4,1fr); gap: 8rpx; margin-top: 17rpx; }.toggle { padding: 13rpx 4rpx; border-radius: 12rpx; color: #667085; background: #f2f4f7; font-size: 20rpx; text-align: center; }.toggle.active { color: #fff; background: #176b78; }.generate-btn { margin-top: 22rpx; padding: 21rpx; border-radius: 16rpx; color: #fff; background: linear-gradient(135deg,#176b78,#2459d7); font-size: 26rpx; font-weight: 850; text-align: center; }
.draft-editor { margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid #edf0f5; }.draft-notice { padding: 13rpx; border-radius: 13rpx; color: #087443; background: #ecfdf3; font-size: 19rpx; line-height: 1.5; }.draft-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 14rpx; padding: 17rpx 0; border-top: 1rpx solid #edf0f5; }.draft-title { color: #253858; font-size: 23rpx; font-weight: 800; }.draft-preview { max-width: 510rpx; margin-top: 5rpx; overflow: hidden; color: #667085; font-size: 19rpx; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }.draft-status { flex: none; color: #98a2b3; font-size: 18rpx; }
