<view class="page">
  <c-ai-disclosure text="系统只生成、保存和复制可编辑草稿，不会代替你发送消息；发送前请核对所有关系与经历均真实。" />

  <view wx:if="{{loading}}" class="state-card">正在同步联系人和跟进计划…</view>
  <view wx:elif="{{loginRequired}}" class="state-card">
    <text class="state-title">登录后开启 Networking Copilot</text>
    <text class="state-copy">联系人、草稿、跟进和 Referral 记录会通过账号同步。</text>
    <view class="primary-btn" bindtap="promptLogin">登录并开始</view>
  </view>
  <view wx:elif="{{error}}" class="state-card">
    <text class="state-title">暂时无法加载</text><text class="state-copy">{{error}}</text>
    <view class="secondary-btn" bindtap="retry">重新加载</view>
  </view>

  <block wx:else>
    <view class="hero-card">
      <text class="eyebrow">NETWORKING COPILOT</text>
      <text class="hero-title">把联系人经营成真实进展</text>
      <text class="hero-sub">从建立联系、回复、Coffee Chat 到 Referral，每一步由你确认。</text>
    </view>

    <view class="section-card">
      <view class="section-head"><view><text class="section-title">真实漏斗</text><text class="section-sub">不是回复率或成功率预测</text></view></view>
      <view class="funnel-row">
        <view class="funnel-item" wx:for="{{funnelStages}}" wx:key="stage"><text class="funnel-value">{{item.count}}</text><text class="funnel-label">{{item.label}}</text><text class="funnel-rate">{{item.display}}</text></view>
      </view>
      <view wx:if="{{dueFollowUps.length}}" class="due-banner">今天及逾期需跟进 {{dueFollowUps.length}} 人，已同步到 Today</view>
    </view>

    <view class="section-card">
      <view class="section-head"><view><text class="section-title">联系人 CRM</text><text class="section-sub">{{contacts.length}} 位联系人</text></view><view class="mini-btn" bindtap="showNewContact">新增联系人</view></view>
      <view wx:if="{{!contacts.length}}" class="empty">先添加一位真实联系人，再生成针对性草稿。</view>
      <view class="contact" wx:for="{{contacts}}" wx:key="id">
        <view class="contact-main"><view><text class="contact-name">{{item.name}}</text><text class="contact-meta">{{item.meta}}</text></view><text class="stage-tag">{{item.statusLabel}}</text></view>
        <text class="contact-line">{{item.followUpText}} · {{item.linkText}}</text>
        <text wx:if="{{item.contextText}}" class="contact-line">{{item.contextText}}</text>
        <view class="contact-actions">
          <view class="text-btn" data-id="{{item.id}}" bindtap="editContact">编辑</view>
          <picker mode="selector" range="{{stages}}" range-key="label" data-id="{{item.id}}" bindchange="onStageChange"><view class="text-btn">更新阶段</view></picker>
          <picker mode="selector" range="{{referralOptions}}" range-key="label" data-id="{{item.id}}" bindchange="onReferralChange"><view class="text-btn">Referral 结果</view></picker>
        </view>
      </view>
    </view>

    <view class="section-card form-card" wx:if="{{showContactForm}}">
      <view class="section-head"><view><text class="section-title">{{editingContactId ? '编辑联系人' : '新增联系人'}}</text><text class="section-sub">共同背景只有确认真实后才会用于草稿</text></view></view>
      <text class="field-label required">姓名</text><input class="input" data-key="name" value="{{contactForm.name}}" bindinput="onContactInput" maxlength="120" placeholder="联系人姓名" />
      <text class="field-label">关联正式申请</text><picker mode="selector" range="{{applications}}" range-key="label" value="{{applicationIndex}}" bindchange="onApplicationChange"><view class="picker">{{applicationIndex >= 0 ? applications[applicationIndex].label : '选择申请（选填）'}}</view></picker><view wx:if="{{applicationIndex >= 0}}" class="clear-link" bindtap="clearApplication">清除申请关联</view>
      <text class="field-label">关联简历</text><picker mode="selector" range="{{resumes}}" range-key="label" value="{{resumeIndex}}" bindchange="onResumeChange"><view class="picker">{{resumeIndex >= 0 ? resumes[resumeIndex].label : '选择简历（选填）'}}</view></picker>
      <view class="two-col"><view><text class="field-label">公司</text><input class="input" data-key="company" value="{{contactForm.company}}" bindinput="onContactInput" maxlength="160" placeholder="公司" /></view><view><text class="field-label">职位</text><input class="input" data-key="role" value="{{contactForm.role}}" bindinput="onContactInput" maxlength="160" placeholder="职位" /></view></view>
      <text class="field-label">渠道</text><picker mode="selector" range="{{channelLabels}}" bindchange="onChannelChange"><view class="picker">{{contactForm.channel}}</view></picker>
      <text class="field-label">联系方式或主页</text><input class="input" data-key="contactValue" value="{{contactForm.contactValue}}" bindinput="onContactInput" maxlength="500" placeholder="LinkedIn 主页、邮箱或活动来源（选填）" />
      <text class="field-label">真实联系背景</text><textarea class="textarea" data-key="relationshipContext" value="{{contactForm.relationshipContext}}" bindinput="onContactInput" maxlength="500" placeholder="例如：确实参加过同一场公开活动。不要填写未经核实的校友或共同经历。" />
      <view class="switch-row"><text>我已确认上述联系背景真实</text><switch checked="{{contactForm.contextVerified}}" bindchange="onContextVerified" color="#2b5ce6" /></view>
      <text class="field-label">下次跟进</text><picker mode="date" value="{{contactForm.nextFollowUpAt}}" bindchange="onFollowUpChange"><view class="picker">{{contactForm.nextFollowUpAt || '选择日期（选填）'}}</view></picker><view wx:if="{{contactForm.nextFollowUpAt}}" class="clear-link" bindtap="clearFollowUp">清除跟进日期</view>
      <text class="field-label">备注</text><textarea class="textarea small" data-key="notes" value="{{contactForm.notes}}" bindinput="onContactInput" maxlength="1500" placeholder="只记录真实沟通信息" />
      <view class="form-actions"><view class="secondary-btn" bindtap="cancelContactForm">取消</view><view class="primary-btn" bindtap="saveContact">保存联系人</view></view>
    </view>

    <view class="section-card">
      <view class="section-head"><view><text class="section-title">可编辑话术草稿</text><text class="section-sub">五类话术，仅保存与复制</text></view></view>
      <text class="field-label">联系人</text><picker mode="selector" range="{{contacts}}" range-key="name" value="{{selectedContactIndex}}" bindchange="onContactPicker"><view class="picker">{{selectedContactIndex >= 0 ? contacts[selectedContactIndex].name : '选择联系人'}}</view></picker>
      <text class="field-label">话术类型</text><picker mode="selector" range="{{draftTypes}}" range-key="label" value="{{selectedDraftTypeIndex}}" bindchange="onDraftTypePicker"><view class="picker">{{draftTypes.length ? draftTypes[selectedDraftTypeIndex].label : '选择类型'}}</view></picker>
      <view class="toggle-row"><view class="toggle {{draftLanguage === 'zh' ? 'active' : ''}}" data-value="zh" bindtap="setDraftLanguage">中文</view><view class="toggle {{draftLanguage === 'en' ? 'active' : ''}}" data-value="en" bindtap="setDraftLanguage">English</view><view class="toggle {{draftTone === 'formal' ? 'active' : ''}}" data-value="formal" bindtap="setDraftTone">正式</view><view class="toggle {{draftTone === 'casual' ? 'active' : ''}}" data-value="casual" bindtap="setDraftTone">友好</view></view>
      <text class="field-label">具体请求（选填）</text><textarea class="textarea small" value="{{requestDetail}}" bindinput="onRequestInput" maxlength="240" placeholder="例如：想了解团队对 New Grad 的项目经验要求" />
      <view class="generate-btn" bindtap="generateDraft">{{operating ? '处理中…' : '生成可编辑草稿'}}</view>

      <view wx:if="{{activeDraft}}" class="draft-editor">
        <text class="draft-notice">来源：规则草稿 · 未调用外部 AI · 尚未发送</text>
        <text class="field-label">主题</text><input class="input" value="{{draftSubject}}" bindinput="onDraftSubjectInput" maxlength="240" />
        <text class="field-label">正文</text><textarea class="textarea draft" value="{{draftContent}}" bindinput="onDraftContentInput" maxlength="5000" />
        <text class="field-label">发送后的下次跟进</text><picker mode="date" value="{{followUpDate}}" bindchange="onDraftFollowUpChange"><view class="picker">{{followUpDate || '选择日期（选填）'}}</view></picker>
        <view class="draft-actions"><view class="secondary-btn" bindtap="saveDraft">保存</view><view class="secondary-btn" bindtap="copyDraft">复制</view><view class="primary-btn" bindtap="markSent">我已外部发送</view></view>
      </view>
    </view>

    <view class="section-card" wx:if="{{drafts.length}}">
      <view class="section-head"><view><text class="section-title">最近草稿</text><text class="section-sub">已发送版本不可覆盖</text></view></view>
      <view class="draft-row" wx:for="{{drafts}}" wx:key="id" data-id="{{item.id}}" bindtap="openDraft"><view><text class="draft-title">{{item.typeLabel}} · {{item.contactName}}</text><text class="draft-preview">{{item.content}}</text></view><text class="draft-status">{{item.status}}</text></view>
    </view>
  </block>

  <c-login-popup show="{{authPromptVisible}}" subtitle="{{authPromptSubtitle}}" bind:close="closeAuthPrompt" bind:success="onAuthPromptSuccess" />
</view>
