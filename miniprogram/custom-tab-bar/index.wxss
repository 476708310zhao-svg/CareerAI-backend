.custom-tabbar { position:fixed; left:0; right:0; bottom:0; z-index:9999; padding-bottom:env(safe-area-inset-bottom); border-top:1rpx solid #e4e9f1; background:rgba(255,255,255,.97); }
.tabbar-panel { display:flex; align-items:center; width:100%; min-height:108rpx; padding:6rpx 12rpx; }
.tabbar-item { position:relative; display:flex; flex:1; min-width:0; min-height:96rpx; flex-direction:column; align-items:center; justify-content:center; gap:4rpx; border-radius:20rpx; }
.tabbar-item-hover { background:#f3f6fb; }.tabbar-item.is-active { background:#f5f8ff; }
.tabbar-icon-wrap { position:relative; display:flex; align-items:center; justify-content:center; width:54rpx; height:54rpx; }.tabbar-icon { display:block; width:38rpx; height:38rpx; }.tabbar-text { max-width:100%; overflow:hidden; color:#667085; font-size:24rpx; font-weight:550; line-height:30rpx; text-overflow:ellipsis; white-space:nowrap; }.tabbar-item.is-active .tabbar-text { color:#2556c7; font-weight:720; }
.tabbar-badge { position:absolute; top:-9rpx; right:-18rpx; min-width:36rpx; height:36rpx; padding:0 8rpx; border:3rpx solid #fff; border-radius:999rpx; color:#fff; background:#d83b3b; font-size:24rpx; line-height:36rpx; text-align:center; }
