.custom-tabbar {
  position: fixed;
  right: 0;
  bottom: 18rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  left: 0;
  z-index: 9999;
  display: flex;
  justify-content: center;
  pointer-events: none;
}

.tabbar-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: calc(100vw - 48rpx);
  max-width: 702rpx;
  min-height: 112rpx;
  padding: 8rpx 10rpx;
  border: 1rpx solid rgba(218, 227, 242, 0.94);
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 22rpx 54rpx rgba(49, 94, 232, 0.12), inset 0 1rpx 0 rgba(255, 255, 255, 0.98);
  pointer-events: auto;
}

.tabbar-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-width: 0;
  min-height: 94rpx;
  flex-direction: column;
  border-radius: 26rpx;
  transition: background-color 180ms ease, opacity 180ms ease;
}

.tabbar-item-hover { background: #f4f7ff; opacity: .78; }
.tabbar-item.is-active { background: #edf2ff; }
.tabbar-icon-wrap { position: relative; display: flex; align-items: center; justify-content: center; width: 50rpx; height: 48rpx; margin-bottom: 4rpx; }
.tabbar-icon { display: block; width: 40rpx; height: 40rpx; }
.tabbar-text { max-width: 100%; color: #7c879a; font-size: 24rpx; font-weight: 650; line-height: 28rpx; text-align: center; white-space: nowrap; }
.tabbar-item.is-active .tabbar-text { color: #315ee8; font-weight: 780; }
.tabbar-badge { position: absolute; top: -12rpx; right: -18rpx; min-width: 36rpx; height: 36rpx; padding: 0 8rpx; border: 3rpx solid #fff; border-radius: 999rpx; color: #fff; background: #c83b42; font-size: 24rpx; font-weight: 800; line-height: 36rpx; text-align: center; }

.ai-float {
  position: fixed;
  right: 26rpx;
  bottom: 150rpx;
  bottom: calc(150rpx + env(safe-area-inset-bottom));
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  min-height: 100rpx;
  pointer-events: auto;
}

.ai-float-core {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  flex-direction: column;
  border: 3rpx solid rgba(255, 255, 255, .88);
  border-radius: 50%;
  background: linear-gradient(145deg, #67c8ff 0%, #315ee8 68%, #2448bd 100%);
  box-shadow: 0 18rpx 42rpx rgba(49, 94, 232, .25);
  animation: ai-float-drift 4.6s ease-in-out infinite;
  transition: opacity 160ms ease;
}

.ai-float-hover .ai-float-core { opacity: .78; }
.ai-spark { position: relative; width: 20rpx; height: 20rpx; margin-bottom: 2rpx; transform: rotate(45deg); border-radius: 4rpx; background: #fff; }
.ai-spark::after { position: absolute; inset: 6rpx -6rpx; border-radius: 999rpx; background: #fff; content: ''; }
.ai-float-text { position: relative; color: #fff; font-size: 24rpx; font-weight: 850; line-height: 28rpx; }

@keyframes ai-float-drift { 0%,100% { transform: translate3d(0,0,0); } 50% { transform: translate3d(0,-5rpx,0); } }

@media (prefers-reduced-motion: reduce) {
  .ai-float-core { animation: none; }
}
