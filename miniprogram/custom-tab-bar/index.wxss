.custom-tabbar {
  position: fixed;
  right: 0;
  bottom: 18rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  left: 0;
  z-index: 9999;
  display: flex;
  justify-content: center;
  pointer-events: none;
}

.tabbar-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: calc(100vw - 48rpx);
  max-width: 702rpx;
  min-height: 112rpx;
  padding: 8rpx 10rpx;
  border: 1rpx solid rgba(216, 221, 231, 0.9);
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 24rpx 64rpx rgba(20, 31, 55, 0.16), inset 0 1rpx 0 rgba(255, 255, 255, 0.98);
  pointer-events: auto;
}

.tabbar-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  min-height: 94rpx;
  border-radius: 26rpx;
  transition: background-color 180ms ease, opacity 180ms ease;
}

.tabbar-item-hover { background: #f2f4f8; opacity: .82; }
.tabbar-item.is-active { background: #111827; }
.tabbar-icon-wrap { position: relative; display: flex; align-items: center; justify-content: center; width: 50rpx; height: 48rpx; margin-bottom: 4rpx; }
.tabbar-icon { display: block; width: 40rpx; height: 40rpx; }
.tabbar-text { max-width: 100%; color: #687386; font-size: 24rpx; font-weight: 650; line-height: 28rpx; text-align: center; white-space: nowrap; }
.tabbar-item.is-active .tabbar-text { color: #ffffff; font-weight: 780; }
.tabbar-item.is-active .tabbar-icon { filter: brightness(0) invert(1); }
.tabbar-badge { position: absolute; top: -12rpx; right: -18rpx; min-width: 36rpx; height: 36rpx; padding: 0 8rpx; border: 3rpx solid #fff; border-radius: 999rpx; color: #fff; background: #c83b42; font-size: 24rpx; font-weight: 800; line-height: 36rpx; text-align: center; }

.ai-float {
  position: fixed;
  right: 24rpx;
  bottom: 150rpx;
  bottom: calc(150rpx + env(safe-area-inset-bottom));
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 152rpx;
  min-height: 88rpx;
  pointer-events: auto;
}

.ai-float-core {
  display: flex;
  align-items: center;
  min-width: 132rpx;
  min-height: 72rpx;
  padding: 8rpx 14rpx 8rpx 8rpx;
  border: 1rpx solid rgba(255, 255, 255, .8);
  border-radius: 999rpx;
  background: #315ee8;
  box-shadow: 0 18rpx 42rpx rgba(49, 94, 232, .28);
  animation: ai-float-drift 4.6s ease-in-out infinite;
  transition: opacity 160ms ease;
}

.ai-float-hover .ai-float-core { opacity: .8; }
.ai-float-mark { display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; margin-right: 10rpx; border-radius: 50%; background: rgba(255,255,255,.16); }
.ai-float-text { color: #fff; font-size: 26rpx; font-weight: 850; line-height: 30rpx; }
.ai-float-label { color: #fff; font-size: 24rpx; font-weight: 760; line-height: 30rpx; }

@keyframes ai-float-drift { 0%,100% { transform: translate3d(0,0,0); } 50% { transform: translate3d(0,-6rpx,0); } }

@media (prefers-reduced-motion: reduce) {
  .ai-float-core { animation: none; }
}
